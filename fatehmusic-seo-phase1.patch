@@ -0,0 +1,177 @@
+/**
+ * ============================================================
+ * Fateh Music Academy
+ * course-content.js
+ * Long-form SEO / GEO content, keyed by course slug.
+ *
+ * Why this file exists (and why it's separate from courses.js):
+ * courses.js is marked "Architecture: FROZEN v1.0" — its shape
+ * (id/slug/media/content.excerpt/seo) is not to be changed.
+ * This file is purely additive: src/seo/resolvers/course.js looks
+ * up an entry here by `course.slug` and merges it in as an
+ * optional `seoContent` field. Every course NOT listed here simply
+ * resolves `seoContent: null`, and the page/components render
+ * without that section — so filling this in one course at a time
+ * is always safe and never breaks the other course pages.
+ *
+ * Content rules (see doc/CONTENT_ENGINE_SPECIFICATION.md and
+ * AGENTS.md "TRUST" section):
+ * - Never invent instructor/academy achievements, awards, student
+ *   counts, or statistics. Only use facts already present in
+ *   courses.js / instructors.js, or generic, well-established
+ *   music-pedagogy knowledge that isn't specific to this school.
+ * - Paragraph fields are arrays of paragraphs (not \n-joined
+ *   strings) so components can render each one independently —
+ *   this also keeps individual passages short and self-contained,
+ *   which is what actually makes a page easy for AI answer engines
+ *   to extract and quote (the doc's "GEO" goal), not any special
+ *   markup trick.
+ *
+ * Shape per entry:
+ * {
+ *   quickSummary: string,
+ *   overview: string[],
+ *   whoIsItFor: string[],
+ *   whoIsItNotFor: string[],
+ *   prerequisites: string,
+ *   learningPath: { stage, description }[],
+ *   curriculum: { title, description }[],
+ *   teachingMethod: string[],
+ *   practicePlan: string[],
+ *   commonMistakes: { mistake, fix }[],
+ *   skillsGained: string[],
+ *   benefits: string[],
+ *   localContext: string[],
+ *   faqAdditions: { question, answer }[],
+ *   summary: string[]
+ * }
+ * ============================================================
+ */
+
+export const courseContent = {
+
+  /* ======================================================================
+     guitar-course — fully worked template.
+     Remaining 22 courses intentionally left unset for now; see the
+     chat response for the phased plan to fill these in.
+  ====================================================================== */
+  "guitar-course": {
+
+    quickSummary:
+      "دوره آموزش گیتار در آموزشگاه موسیقی فاتح برای سه گروه سنی طراحی شده: کودکانی که برای نخستین‌بار با یک ساز آشنا می‌شوند، نوجوانانی که می‌خواهند نواختن را جدی دنبال کنند، و بزرگسالانی که چه برای اولین‌بار و چه پس از سال‌ها وقفه دوباره سراغ گیتار می‌آیند. کلاس‌ها خصوصی و یک‌نفره برگزار می‌شود و مدرس آن، خلیل دلاوران، علاوه بر گیتار، سلفژ، تئوری موسیقی، ریتم و وزن‌خوانی و صداسازی را هم تدریس می‌کند؛ به همین دلیل این مهارت‌ها از همان جلسات نخست در دل تمرین گیتار جای می‌گیرند، نه به‌صورت درس‌های جدا. مسیر آموزشی از کوک، وضعیت نشستن و اولین آکوردها آغاز می‌شود، به استرام و ریتم می‌رسد، سپس باره و فینگراستایل را می‌پوشاند و در نهایت هنرجو را به سمت یکی از سه شاخه گیتار کلاسیک، پاپ یا فلامنکو هدایت می‌کند. در ادامه همین صفحه، سن مناسب شروع، تفاوت گیتار کلاسیک و آکوستیک، اشتباهات رایج مبتدیان و یک برنامه تمرین پیشنهادی نیز آمده است.",
