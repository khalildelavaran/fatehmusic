{
  "name": "fatehmusic",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply fatehmusic-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fatehmusic-db --remote"
  },
  "dependencies": {
    "astro": "^7.0.6",
    "@astrojs/cloudflare": "^14.1.1",
    "lucide-astro": "^0.556.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
