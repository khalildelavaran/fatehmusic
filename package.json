{
  "name": "fatehmusic",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "npm run db:migrate:remote && astro build && wrangler deploy",
    "types": "wrangler types",
    "check": "astro check",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply fatehmusic-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fatehmusic-db --remote",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:live-audit": "node scripts/seo-http-audit.mjs",
    "seo:score": "node scripts/seo-score.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.3",
    "@google/genai": "^2.28.0",
    "@lucide/astro": "^1.37.0",
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.0.0",
    "miniflare": "^5.20261006.1-alpha",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true
  }
}
