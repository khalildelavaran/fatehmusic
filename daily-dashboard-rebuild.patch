+++ b/src/styles/admin/daily-dashboard.css
@@ -0,0 +1,232 @@
+/* ==========================================
+   DAILY DASHBOARD — Command Center
+   Single stylesheet for the daily dashboard timeline, session/student
+   cards, quick-payment modal and the room settings page. Dark theme,
+   gold accent — matches src/styles/variables.css.
+========================================== */
+
+/* ---------- Shell / header ---------- */
+.daily-shell{max-width:none;margin:0;padding:32px clamp(18px,3vw,36px) 64px}
+.daily-topbar{margin-bottom:18px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px}
+.daily-topbar-title{justify-self:start;display:flex;align-items:center;gap:14px;min-width:0}
+.daily-topbar-title h1{margin:0;color:var(--text);font-size:18px;white-space:nowrap}
+.daily-clock{justify-self:center;text-align:center;line-height:1.2}
+.daily-date{display:flex;align-items:center;justify-content:center;gap:8px;font-size:20px;font-weight:800;color:var(--text);white-space:nowrap;direction:rtl;unicode-bidi:isolate}
+.daily-date-part{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;direction:rtl;unicode-bidi:isolate}
+.daily-date-day{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:2px solid var(--gold-light);border-radius:50%;color:var(--gold-light);font-size:22px;font-weight:900;line-height:1;font-variant-numeric:tabular-nums;box-sizing:border-box;flex:0 0 44px;direction:ltr;unicode-bidi:isolate}
+.daily-time{margin-top:4px;font-size:27px;font-weight:800;letter-spacing:.04em;color:var(--gold-light);white-space:nowrap;font-variant-numeric:tabular-nums}
+.date-nav{justify-self:end;display:flex;gap:8px;flex-wrap:wrap}
+.date-nav button{padding:9px 14px;border-radius:10px;background:var(--surface);border:1px solid var(--border);color:var(--text);font:inherit;font-size:13px;cursor:pointer;white-space:nowrap}
+.date-nav button:hover{border-color:var(--primary);color:var(--primary)}
+.date-nav button#today{border-color:var(--gold);color:var(--gold-light)}
+
+.daily-sync{font-size:11px;opacity:.6;margin:0 0 12px;min-height:14px}
+.daily-sync.is-loading{color:var(--gold-light);opacity:1}
+.daily-error{padding:12px 14px;border:1px solid #a33;border-radius:10px;margin-bottom:15px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:rgba(163,51,51,.08)}
+.daily-error button{padding:7px 14px;font-size:12px}
+
+/* ---------- Summary cards ---------- */
+.daily-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
+.daily-summary .stat{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:14px 16px;display:flex;flex-direction:column;gap:6px}
+.daily-summary .stat strong{font-size:26px;color:var(--gold-light);font-variant-numeric:tabular-nums}
+.daily-summary .stat span{font-size:12px;color:var(--text-secondary)}
+.daily-summary .stat.warning{border-color:rgba(230,161,60,.4)}
+.daily-summary .stat.warning strong{color:#e6a13c}
+.daily-summary .stat.attention-list{grid-column:span 1}
+.daily-summary .stat .attention-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:2px}
+.daily-summary .stat .attention-chips span{font-size:10.5px;padding:2px 7px;border-radius:999px;background:rgba(230,161,60,.14);border:1px solid rgba(230,161,60,.3);color:#e6a13c}
+
+@media(max-width:900px){.daily-topbar{grid-template-columns:1fr}.daily-topbar-title,.daily-clock,.date-nav{justify-self:stretch}.daily-clock{text-align:center}.daily-topbar-title{justify-content:center}.date-nav{justify-content:center}.daily-date{font-size:19px}.daily-time{font-size:25px}}
+@media(max-width:800px){.daily-shell{padding:16px}.daily-summary{grid-template-columns:repeat(2,1fr)}}
+
+/* ---------- Timeline ---------- */
+.dd-timeline{margin-bottom:22px;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:16px;overflow-x:auto}
+.dd-timeline-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
+.dd-timeline-head h2{font-size:15px;margin:0;color:var(--text)}
+.dd-timeline-head small{font-size:11px;opacity:.6}
+.dd-timeline-legend{display:flex;gap:12px;font-size:11px;opacity:.7;flex-wrap:wrap}
+.dd-timeline-legend span{display:inline-flex;align-items:center;gap:5px}
+.dd-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
+.dd-dot.gold{background:var(--gold)}.dd-dot.red{background:#d66}.dd-dot.gray{background:rgba(255,255,255,.35)}
+
+.dd-grid{position:relative;min-width:820px}
+.dd-hours{position:relative;height:22px;margin-inline-start:112px;margin-bottom:4px}
+.dd-hour{position:absolute;transform:translateX(50%);font-size:11px;color:var(--text-secondary);white-space:nowrap;direction:ltr}
+.dd-hour.dd-hour-major{opacity:.9;font-weight:800}
+.dd-hour.dd-hour-minor{opacity:.35;font-size:9px}
+
+.dd-body{display:flex;flex-direction:column;gap:8px}
+.dd-row{position:relative;display:flex;min-height:94px}
+.dd-row-label{flex:0 0 112px;display:flex;flex-direction:column;justify-content:center;gap:2px;padding-inline-end:10px}
+.dd-row-label strong{font-size:12px;color:var(--text)}
+.dd-row-label small{font-size:10px;opacity:.55}
+.dd-track{position:relative;flex:1 1 auto;direction:ltr;border-radius:10px;background:rgba(255,255,255,.02)}
+.dd-track.dd-drop-target{outline:1px dashed rgba(212,175,55,.6);outline-offset:-2px}
+
+.dd-card{position:absolute;top:10px;min-height:72px;box-sizing:border-box;border-radius:12px;border:1px solid rgba(212,175,55,.35);background:linear-gradient(135deg,rgba(212,175,55,.14),rgba(212,175,55,.045));padding:8px 10px;direction:rtl;cursor:grab;touch-action:none;user-select:none;display:flex;flex-direction:column;gap:3px;overflow:hidden;transition:box-shadow .15s}
+.dd-card:hover{box-shadow:0 8px 22px rgba(0,0,0,.22)}
+.dd-card[data-dragging="1"]{cursor:grabbing;z-index:60;box-shadow:0 16px 34px rgba(0,0,0,.32);transition:none}
+.dd-card strong{font-size:12.5px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
+.dd-card .dd-card-meta{font-size:10.5px;opacity:.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.dd-card .dd-card-time{font-size:11px;font-weight:700;direction:ltr;color:var(--gold-light);align-self:flex-start}
+.dd-card.is-cancelled{opacity:.55;border-color:rgba(255,255,255,.15);background:rgba(255,255,255,.03)}
+.dd-card.is-cancelled .dd-card-time{text-decoration:line-through}
+.dd-card.is-conflict{border-color:#d66;box-shadow:0 0 0 1px rgba(214,102,102,.5)}
+.dd-card.is-ongoing{border-color:#5fbf72}
+.dd-card.is-ongoing::before{content:"";position:absolute;inset-inline-start:0;top:0;bottom:0;width:3px;background:#5fbf72}
+.dd-resize{position:absolute;top:0;bottom:0;width:12px;cursor:ew-resize;z-index:3}
+.dd-resize.start{left:-1px}
+.dd-resize.end{right:-1px}
+
+.dd-empty{opacity:.65;padding:30px;text-align:center}
+.dd-empty-title{font-size:15px;font-weight:700;opacity:.9;margin-bottom:6px}
+.dd-empty-note{font-size:12.5px;opacity:.7}
+
+/* Inline time editor (shared shape used in both the timeline card and the student card) */
+.dd-time-value{display:inline-flex;align-items:center;border:1px solid rgba(212,175,55,.3);background:rgba(212,175,55,.07);color:inherit;font:inherit;font-size:11px;font-weight:800;padding:3px 7px;border-radius:6px;cursor:pointer;direction:ltr;white-space:nowrap}
+.dd-time-value:hover{background:rgba(212,175,55,.16);border-color:rgba(212,175,55,.65)}
+.dd-time-form{display:inline-flex;align-items:center;gap:4px;direction:ltr;flex-wrap:wrap}
+.dd-time-form input{width:74px;height:28px;box-sizing:border-box;border:1px solid rgba(255,255,255,.18);border-radius:6px;background:#111;color:var(--text);padding:2px 6px;font:600 12px Vazirmatn,sans-serif;direction:ltr}
+.dd-time-form button{height:28px;border:1px solid rgba(255,255,255,.16);border-radius:6px;background:var(--surface);color:var(--text);padding:2px 9px;cursor:pointer;font:600 11px Vazirmatn,sans-serif}
+.dd-time-form button.save{background:var(--gold);border-color:var(--gold-dark);color:#111}
+.dd-time-form button:disabled{opacity:.55;cursor:wait}
+.dd-time-error{font-size:10px;color:#e58;margin-inline-start:4px;flex-basis:100%}
+
+@media(max-width:700px){.dd-timeline{padding:10px}}
+
+/* ---------- Sessions / student panel ---------- */
+.dd-sessions{display:flex;flex-direction:column;gap:14px}
+.dd-session{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:16px}
+.dd-session.is-cancelled{opacity:.7}
+.dd-session-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
+.dd-session-head-main{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0}
+.dd-session-head strong{font-size:14px}
+.dd-session-tag{font-size:11px;padding:3px 9px;border-radius:999px;border:1px solid var(--border);color:var(--text-secondary);white-space:nowrap}
+.dd-session-tag.gold{border-color:rgba(212,175,55,.4);color:var(--gold-light)}
+.dd-session-tag.conflict{border-color:#d66;color:#e58}
+.dd-session-tag.cancelled{border-color:#a33;color:#e58}
+.dd-session-meta{display:flex;flex-wrap:wrap;gap:10px;font-size:12px;opacity:.75}
+.dd-teacher-attendance{display:inline-flex;align-items:center;gap:6px;font-size:12px}
+.dd-teacher-status{padding:3px 9px;border-radius:999px;font-size:11px;border:1px solid var(--border)}
+.dd-teacher-status.present{border-color:#2f8f46;color:#7acb8c}
+.dd-teacher-status.absent{border-color:#a33;color:#e58}
+.dd-teacher-status.pending{border-color:#b89500;color:#e6c34a}
+.dd-exception-banner{margin:8px 0;padding:8px 12px;border-radius:10px;border:1px solid rgba(230,161,60,.4);background:rgba(230,161,60,.08);font-size:12px;color:#e6c34a}
+
+.students{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px}
+.student-card{border:1px solid var(--border);border-radius:14px;padding:12px 14px;background:rgba(255,255,255,.03);display:flex;flex-direction:column;gap:8px}
+.student-card.is-present{border-color:rgba(47,143,70,.5)}
+.student-card.is-absent{border-color:rgba(214,102,102,.5)}
+.student-card.is-excused{border-color:rgba(59,130,246,.5)}
+.student-card.is-withdrawn{opacity:.55}
+.student-card-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
+.student-name-row{display:flex;align-items:center;gap:8px;min-width:0}
+.student-name{font-weight:800;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.student-meta-row{display:flex;justify-content:space-between;gap:8px;font-size:11px;opacity:.7}
+
+/* ---------- Remaining-sessions round badge + quick payment (spec 45) ---------- */
+.session-badge{flex:0 0 auto;width:26px;height:26px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;border:2px solid transparent;cursor:pointer;font-variant-numeric:tabular-nums;color:#111}
+.session-badge.badge-green{background:#5fbf72;border-color:#3d8a4c}
+.session-badge.badge-orange{background:#e6a13c;border-color:#b6791f}
+.session-badge.badge-red{background:#d66;border-color:#a33;color:#fff}
+.session-badge.badge-red.badge-alarm{animation:dd-badge-pulse 1.6s ease-in-out infinite}
+.session-badge.badge-neutral{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.2);color:var(--text)}
+@keyframes dd-badge-pulse{0%,100%{box-shadow:0 0 0 0 rgba(214,102,102,.55)}50%{box-shadow:0 0 0 6px rgba(214,102,102,0)}}
+@media(prefers-reduced-motion:reduce){
+  .session-badge.badge-red.badge-alarm{animation:none;box-shadow:0 0 0 2px rgba(214,102,102,.85)}
+}
+
+.attendance-buttons{display:flex;gap:5px}
+.attendance-button{width:26px;height:26px;min-width:26px;border-radius:50%;border:1px solid var(--border);background:var(--surface);color:var(--text-secondary);font:700 10px inherit;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:0}
+.attendance-button:hover:not(:disabled){transform:scale(1.06)}
+.attendance-button:disabled{opacity:.4;cursor:not-allowed}
+.attendance-button.present.active{background:#2f8f46;border-color:#2f8f46;color:#fff}
+.attendance-button.absent.active{background:#a33;border-color:#a33;color:#fff}
+.attendance-button.excused.active{background:#3b82f6;border-color:#3b82f6;color:#fff}
+.attendance-button.withdrawn.active{background:#666;border-color:#666;color:#fff}
+
+/* ---------- Finance box ---------- */
+.finance-box{margin-top:10px;padding-top:10px;border-top:1px dashed var(--border)}
+.finance-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
+.finance-title strong{font-size:13px}
+.finance-status{font-size:12px;padding:4px 8px;border-radius:999px;border:1px solid var(--border)}
+.finance-status.paid{border-color:#2f8f46}.finance-status.partial{border-color:#b89500}.finance-status.overdue{border-color:#a33;color:#d77}.finance-status.pending{border-color:#b89500}.finance-status.none{opacity:.65}
+.finance-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
+.finance-item{padding:8px 9px;border-radius:9px;background:rgba(255,255,255,.03)}
+.finance-item span{display:block;font-size:11px;opacity:.65;margin-bottom:3px}
+.finance-item b{font-size:13px}
+.finance-balance b{color:var(--gold-light)}
+.finance-due{font-size:11px;opacity:.75;display:flex;justify-content:space-between;margin-bottom:8px}
+.payment-toggle,.renewal-button{border:1px solid var(--gold-dark);background:transparent;color:var(--gold-light);border-radius:9px;padding:7px 12px;font:inherit;font-size:12px;cursor:pointer}
+.payment-toggle:hover,.renewal-button:hover{background:rgba(212,175,55,.1)}
+.payment-form{display:grid;grid-template-columns:1fr 130px 1fr auto;gap:7px;align-items:center;margin-top:8px}
+.payment-form input,.payment-form select,.renewal-form input{width:100%;box-sizing:border-box;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:9px;padding:9px;font-family:inherit}
+.payment-form button{white-space:nowrap}
+.payment-message{font-size:12px;margin-top:6px}
+.payment-message.error{color:#e58}
+.payment-message.success{color:#7acb8c}
+
+.renewal-box{margin-top:10px;padding-top:10px;border-top:1px dashed var(--border)}
+.renewal-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
+.renewal-head strong{font-size:13px}
+.renewal-form{display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center;margin-top:8px}
+.renewal-form label{font-size:11px;opacity:.7;grid-column:1/-1}
+.renewal-form button{white-space:nowrap}
+.renewal-note{font-size:11px;opacity:.65;margin-top:6px}
+.renewal-result{padding:12px 14px;border:1px solid #2f8f46;border-radius:12px;margin-bottom:15px;background:rgba(47,143,70,.08)}
+.renewal-result.error{border-color:#a33;background:rgba(163,51,51,.08)}
+
+@media(max-width:900px){.payment-form{grid-template-columns:1fr 1fr}.payment-form button{grid-column:1/-1}}
+@media(max-width:800px){.dd-session-head{flex-direction:column;align-items:stretch}.students{grid-template-columns:1fr}.finance-grid{grid-template-columns:1fr 1fr}}
+@media(max-width:480px){.finance-grid{grid-template-columns:1fr}.renewal-form{grid-template-columns:1fr}.renewal-form button{width:100%}}
+
+/* ---------- Quick payment modal (spec 45.4) ---------- */
+.dd-modal{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center}
+.dd-modal[hidden]{display:none}
+.dd-modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.6)}
+.dd-modal-box{position:relative;z-index:1;width:min(92vw,420px);background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px;box-shadow:var(--shadow)}
+.dd-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
+.dd-modal-head strong{font-size:14px}
+.dd-modal-close{background:transparent;border:0;color:var(--text-secondary);font-size:20px;line-height:1;cursor:pointer;padding:2px 6px}
+.dd-modal-close:hover{color:var(--text)}
+.dd-modal-body .finance-grid{margin-bottom:12px}
+.dd-modal-body .payment-form{grid-template-columns:1fr;gap:9px}
+
+/* ---------- Empty state / errors shared ---------- */
+.empty{opacity:.65;padding:30px;text-align:center}
+.empty-title{font-size:16px;font-weight:700;opacity:.9;margin-bottom:8px}
+.empty-note{font-size:13px;opacity:.7}
+
+/* ==========================================
+   SETTINGS PAGE (/admin/settings)
+========================================== */
+.settings-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;border-bottom:1px solid var(--border);padding-bottom:2px}
+.settings-tab{padding:10px 16px;border-radius:10px 10px 0 0;border:1px solid transparent;background:transparent;color:var(--text-secondary);font:inherit;font-size:13px;cursor:pointer}
+.settings-tab.is-active{color:var(--gold-light);border-color:var(--border);border-bottom-color:var(--surface);background:var(--surface)}
+.settings-panel{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px}
+.settings-panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap}
+.settings-panel-head h2{margin:0;font-size:16px}
+.settings-panel-head p{margin:4px 0 0;font-size:12.5px;opacity:.65}
+
+.room-list{display:flex;flex-direction:column;gap:8px;margin-bottom:18px}
+.room-row{display:flex;align-items:center;gap:12px;padding:11px 14px;border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.02);flex-wrap:wrap}
+.room-row.is-inactive{opacity:.55}
+.room-row-name{font-weight:700;font-size:13.5px;min-width:120px}
+.room-row-meta{font-size:11.5px;opacity:.65;flex:1 1 auto}
+.room-row-actions{display:flex;gap:6px;flex-wrap:wrap}
+.room-row-actions button{padding:6px 11px;font-size:12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer}
+.room-row-actions button:hover{border-color:var(--primary);color:var(--primary)}
+.room-row-actions button.danger:hover{border-color:#a33;color:#e58}
+.room-status-pill{font-size:10.5px;padding:2px 8px;border-radius:999px;border:1px solid var(--border)}
+.room-status-pill.active{border-color:#2f8f46;color:#7acb8c}
+.room-status-pill.inactive{border-color:rgba(255,255,255,.2);color:var(--text-secondary)}
+
+.room-form{display:grid;grid-template-columns:2fr 1fr auto;gap:10px;align-items:end;padding-top:14px;border-top:1px dashed var(--border)}
+.room-form label{display:grid;gap:6px;font-size:12px;color:var(--text-secondary)}
+.room-form input{box-sizing:border-box;min-height:42px;padding:9px 12px;border:1px solid var(--border);border-radius:10px;background:rgba(255,255,255,.03);color:var(--text);font:inherit}
+.room-form button{min-height:42px;padding:0 18px;border-radius:10px;background:var(--primary);color:#111;font-weight:700;border:0;cursor:pointer}
+.settings-message{font-size:12.5px;margin-top:10px}
+.settings-message.error{color:#e58}
+.settings-message.success{color:#7acb8c}
+
+@media(max-width:700px){.room-form{grid-template-columns:1fr}.room-row{flex-direction:column;align-items:stretch}.room-row-actions{justify-content:flex-end}}
