+              <p>فهرست مدرسان آموزشگاه، تخصص و هنرجویان هر مدرس.</p>
+            </section>
+
+            <section class="admin-students-filters no-print">
+              <input type="search" id="instructorSearch" placeholder="جست‌وجو بر اساس نام، تخصص یا موبایل..." />
+              <select id="instructorStatusFilter">
+                <option value="">همه وضعیت‌ها</option>
+                <option value="active">فعال</option>
