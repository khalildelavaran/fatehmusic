From ef148160868ec3abeac586b0f6b8a1466bf6ed83 Mon Sep 17 00:00:00 2001
From: AI Developer <ai-dev@fatehmusic.local>
Date: Sun, 30 Aug 2026 09:04:55 +0000
Subject: [PATCH] fix(student): show Jalali dates on the student profile page

students.astro rendered registrations[].createdAt and
certificates[].issuedAt as raw SQLite datetime('now') values (Gregorian,
e.g. "2026-08-30 04:11:52") instead of running them through the
project's existing formatJalaliDate() -- the same helper every other
page (blog, registrations, posts) already uses for this. Missed in
Phase 1; nothing else in the project had this gap (audited every
created_at/issued_at/updated_at render site before this fix).

Two lines changed, both display-only -- no data, API shape, or DB
schema touched.

Validated: npx vitest run (85/85) . npx astro check (61/3, unchanged
from the pre-fix baseline on current main) . npx astro build (clean).
---
 src/pages/admin/students.astro | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/pages/admin/students.astro b/src/pages/admin/students.astro
index 4e69e04..5e6f823 100644
--- a/src/pages/admin/students.astro
+++ b/src/pages/admin/students.astro
@@ -9,6 +9,7 @@ import "../../styles/admin/registrations.css";
 import "../../styles/admin/students.css";
 import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
 import { getStudentProfile, STUDENT_STATUSES } from "../../server/students";
+import { formatJalaliDate } from "../../utils/format-date";
 
 const session = await getAdminSession(Astro.request, env as AdminEnv);
 if (!session) return Astro.redirect("/admin/login");
@@ -103,7 +104,7 @@ const pageTitle = profile ? `پرونده ${profile.student.firstName} ${profile
                         <td>{r.instructorName}</td>
                         <td>{r.scheduleWeekday}</td>
                         <td><span class="admin-status-pill" data-status={r.status}>{REGISTRATION_STATUS_LABELS_FA[r.status] ?? r.status}</span></td>
-                        <td>{r.createdAt}</td>
+                        <td>{formatJalaliDate(r.createdAt)}</td>
                       </tr>
                     ))
                   )}
@@ -120,7 +121,7 @@ const pageTitle = profile ? `پرونده ${profile.student.firstName} ${profile
                     <tr><td colspan="4" class="admin-table-empty">گواهینامه‌ای صادر نشده است.</td></tr>
                   ) : (
                     profile.certificates.map((c) => (
-                      <tr><td dir="ltr">{c.certNumber}</td><td>{c.level ?? "-"}</td><td>{c.completionDateJalali}</td><td>{c.issuedAt}</td></tr>
+                      <tr><td dir="ltr">{c.certNumber}</td><td>{c.level ?? "-"}</td><td>{c.completionDateJalali}</td><td>{formatJalaliDate(c.issuedAt)}</td></tr>
                     ))
                   )}
                 </tbody>
