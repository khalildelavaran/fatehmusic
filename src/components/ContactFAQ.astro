---
import "../styles/ContactFAQ.css";
import { contactFaqs as faqs } from "../data/contact-faq.js";

---

<section class="contact-faq section">

    <div class="container">

        <div class="section-header">

            <span class="badge">
                سوالات متداول
            </span>

            <h2>
                پرسش‌های پرتکرار
            </h2>

            <p>
                پاسخ برخی از سوالاتی که هنرجویان پیش از ثبت‌نام بیشتر مطرح می‌کنند.
            </p>

        </div>

        <div class="faq-list">
            {
                faqs.map((faq) => (
                    <details class="card faq-item">
                        <summary>{faq.question}</summary>
                        <p>{faq.answer}</p>
                    </details>
                ))
            }
        </div>

    </div>

</section>