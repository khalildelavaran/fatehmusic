---
import "../styles/AboutFAQ.css";

export const faqs = [

    {
        question: "آیا برای شروع آموزش موسیقی در آموزشگاه فاتح نیاز به پیش‌زمینه دارم؟",
        answer:
            "خیر. دوره‌های آموزشگاه موسیقی فاتح از سطح کاملاً مبتدی تا پیشرفته تعریف شده‌اند و هیچ پیش‌نیازی برای شروع آموزش لازم نیست."
    },

    {
        question: "از چه سنی می‌توان در آموزشگاه فاتح موسیقی را شروع کرد؟",
        answer:
            "آموزشگاه فاتح دوره اختصاصی آموزش موسیقی کودک دارد و در کنار آن، نوجوانان و بزرگسالان نیز می‌توانند در بیشتر دوره‌ها ثبت‌نام کنند. سن مناسب شروع به ساز انتخابی و شرایط هر هنرجو بستگی دارد؛ بهتر است پیش از ثبت‌نام با آموزشگاه مشورت کنید."
    },

    {
        question: "آیا کلاس‌های آموزشگاه فاتح خصوصی برگزار می‌شوند؟",
        answer:
            "بله. تمام کلاس‌های آموزشگاه موسیقی فاتح به‌صورت خصوصی و یک‌نفره برگزار می‌شوند."
    },

    {
        question: "کلاس‌ها به چه صورت و در چند جلسه برگزار می‌شوند؟",
        answer:
            "کلاس‌ها به‌صورت حضوری و در قالب ترم‌های آموزشی با تعداد جلسات مشخص برگزار می‌شوند. جزئیات دقیق جلسات هر دوره در صفحه اختصاصی همان دوره آمده است."
    },

    {
        question: "چه سازها و رشته‌هایی در آموزشگاه فاتح تدریس می‌شود؟",
        answer:
            "گیتار، پیانو، ویولن، کمانچه، تار، سه‌تار، سنتور، دف، تنبک، ضرب‌تمپو، نی، نی‌انبان، هنگ‌درام، انواع آواز و دروس پایه موسیقی مانند سلفژ و تئوری موسیقی از جمله دوره‌های این آموزشگاه هستند."
    },

    {
        question: "آیا پیش از ثبت‌نام امکان مشاوره وجود دارد؟",
        answer:
            "بله. می‌توانید پیش از ثبت‌نام با آموزشگاه تماس بگیرید تا درباره انتخاب ساز، سطح آموزشی و دوره مناسب مشاوره رایگان دریافت کنید."
    },

    {
        question: "چطور می‌توانم در آموزشگاه موسیقی فاتح ثبت‌نام کنم؟",
        answer:
            "برای ثبت‌نام کافی است فرم ثبت‌نام را در صفحه ثبت‌نام تکمیل کنید یا مستقیماً با شماره‌های آموزشگاه تماس بگیرید."
    }

];
---

<section class="about-faq">

    <div class="container">

        <div class="section-header">

            <span class="section-badge">
                سوالات متداول
            </span>

            <h2>
                پرسش‌های متداول درباره آموزشگاه موسیقی فاتح
            </h2>

            <p>
                پاسخ برخی از پرسش‌هایی که پیش از آشنایی با آموزشگاه یا
                ثبت‌نام بیشتر مطرح می‌شوند.
            </p>

        </div>

        <div class="faq-list">

            {faqs.map((faq) => (

                <details class="card faq-item">

                    <summary>
                        {faq.question}
                    </summary>

                    <p>
                        {faq.answer}
                    </p>

                </details>

            ))}

        </div>

    </div>

</section>
