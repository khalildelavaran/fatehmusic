---
const gallery = [
  {
    title: "کلاس گیتار",
    subtitle: "آموزش گیتار کلاسیک، پاپ و فلامنکو",
    image: "/images/gallery/guitar.webp",
  },
  {
    title: "کلاس پیانو",
    subtitle: "آموزش پیانو کلاسیک و پاپ",
    image: "/images/gallery/piano.webp",
  },
  {
    title: "کلاس ویولون",
    subtitle: "آموزش ویولون ایرانی و کلاسیک",
    image: "/images/gallery/violin.webp",
  },
  {
    title: "اجرای هنرجویان",
    subtitle: "کنسرت‌ها و اجراهای پایان دوره",
    image: "/images/gallery/concert.webp",
  },
  {
    title: "موسیقی کودک",
    subtitle: "آموزش ویژه کودکان",
    image: "/images/gallery/kids.webp",
  },
  {
    title: "فضای آموزشگاه",
    subtitle: "محیط آموزشی مدرن",
    image: "/images/gallery/academy.webp",
  },
];
---

<section id="gallery" class="gallery">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">گالری آموزشگاه</span>

      <h2>لحظاتی از آموزش، تمرین و اجرا</h2>

      <p>
        تصاویری از کلاس‌ها، هنرجویان و فضای آموزشگاه موسیقی فاتح
      </p>
    </div>

    <div class="gallery-grid">
      {
        gallery.map((item, index) => (
          <article
            class="gallery-item"
            tabindex="0"
            role="button"
            aria-label={`مشاهده تصویر ${item.title}`}
            data-index={index}
            data-image={item.image}
          >
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              decoding="async"
              width="800"
              height="450"
            />

            <div class="gallery-overlay">
              <h3>{item.title}</h3>
              <p>{item.subtitle}</p>
              <span class="gallery-link">
                مشاهده تصویر
                <span aria-hidden="true">←</span>
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<div
  id="lightbox"
  class="lightbox"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <button class="lightbox-close" type="button" aria-label="بستن">✕</button>

  <button class="lightbox-prev" type="button" aria-label="تصویر قبلی">❮</button>

  <div class="lightbox-content">
    <img id="lightbox-image" src="" alt="" width="800" height="450" />

    <div class="lightbox-caption">
      <h3 id="lightbox-title"></h3>
      <p id="lightbox-subtitle"></p>
    </div>
  </div>

  <button class="lightbox-next" type="button" aria-label="تصویر بعدی">❯</button>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const galleryItems = Array.from(document.querySelectorAll(".gallery-item"));
  const lightbox = document.getElementById("lightbox");
  const img = document.getElementById("lightbox-image");
  const title = document.getElementById("lightbox-title");
  const subtitle = document.getElementById("lightbox-subtitle");
  const btnClose = document.querySelector(".lightbox-close");
  const btnPrev = document.querySelector(".lightbox-prev");
  const btnNext = document.querySelector(".lightbox-next");

  if (!lightbox || !img || !title || !subtitle || !btnClose || !btnPrev || !btnNext) return;

  let current = 0;

  function show(index) {
    current = index;
    const item = galleryItems[index];
    if (!item) return;

    img.src = item.dataset.image || "";
    img.alt = item.querySelector("img")?.alt || "";
    title.textContent = item.querySelector("h3")?.textContent || "";
    subtitle.textContent = item.querySelector("p")?.textContent || "";
  }

  function open(index) {
    show(index);
    lightbox.classList.add("active");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.classList.add("lightbox-open");
  }

  function close() {
    lightbox.classList.remove("active");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.classList.remove("lightbox-open");
  }

  function next() {
    show((current + 1) % galleryItems.length);
  }

  function prev() {
    show((current - 1 + galleryItems.length) % galleryItems.length);
  }

  galleryItems.forEach((item, index) => {
    item.addEventListener("click", () => open(index));
    item.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        open(index);
      }
    });
  });

  btnClose.addEventListener("click", close);
  btnNext.addEventListener("click", next);
  btnPrev.addEventListener("click", prev);

  lightbox.addEventListener("click", (event) => {
    if (event.target === lightbox) close();
  });

  document.addEventListener("keydown", (event) => {
    if (!lightbox.classList.contains("active")) return;

    switch (event.key) {
      case "Escape": close(); break;
      case "ArrowLeft": next(); break;
      case "ArrowRight": prev(); break;
      case "Home": show(0); break;
      case "End": show(galleryItems.length - 1); break;
    }
  });

  let touchStart = 0;

  lightbox.addEventListener("touchstart", (event) => {
    touchStart = event.changedTouches[0].clientX;
  }, { passive: true });

  lightbox.addEventListener("touchend", (event) => {
    const distance = event.changedTouches[0].clientX - touchStart;
    if (Math.abs(distance) < 60) return;
    distance > 0 ? prev() : next();
  }, { passive: true });

  img.addEventListener("dragstart", (event) => event.preventDefault());

  lightbox.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;

    const focusable = [btnClose, btnPrev, btnNext];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
});
</script>
