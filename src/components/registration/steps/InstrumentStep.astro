---
import { courses } from "../../../data/courses";
import InstrumentCard from "../cards/InstrumentCard.astro";

const orderedCourses = courses
  .filter((course) => course.active)
  .sort((a, b) => a.priority - b.priority);
---

<section class="registration-step" data-step="instrument">
  <header class="step-header">
    <span class="section-badge">مرحله ۱ از ۵</span>
    <h2>دوره مورد نظر خود را انتخاب کنید</h2>
    <p data-step-subtitle>دوره مورد نظر خود را انتخاب کنید.</p>
  </header>

  <div class="registration-categories">
    {orderedCourses.map((course, index) => {
      const previous = orderedCourses[index - 1];
      const isFirstInCategory = !previous || previous.category !== course.category;
      return (
        <div class="category-group" data-category={course.category} data-category-start={isFirstInCategory ? "true" : "false"}>
          {isFirstInCategory && (
            <div class="category-header" aria-label={`دسته‌بندی ${course.category}`}>
              <span>{course.category}</span>
            </div>
          )}
          <div class="category-card">
            <InstrumentCard
              id={course.id}
              slug={course.slug}
              title={course.title}
              excerpt={course.content?.excerpt}
              image={course.media?.image}
              level={course.level}
              instructorIds={course.instructors ?? []}
            />
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .registration-categories {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: thin;
  }

  .category-group {
    flex: 0 0 220px;
    width: 220px;
  }

  .category-header {
    height: 28px;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-gold, #d4af37);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .category-header::before,
  .category-header::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-gold, #d4af37);
    opacity: 0.85;
  }

  .category-card {
    width: 100%;
  }

  @media (max-width: 760px) {
    .category-group {
      flex-basis: 200px;
      width: 200px;
    }
  }
</style>
