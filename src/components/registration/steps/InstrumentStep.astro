---
import { courses } from "../../../data/courses";
import InstrumentCard from "../cards/InstrumentCard.astro";

const activeCourses = courses.filter((course) => course.active).sort((a, b) => a.priority - b.priority);

const categories: { name: string; items: typeof activeCourses }[] = [];
for (const course of activeCourses) {
  let group = categories.find((entry) => entry.name === course.category);
  if (!group) {
    group = { name: course.category, items: [] };
    categories.push(group);
  }
  group.items.push(course);
}

categories.sort((a, b) => b.items.length - a.items.length);

// Flatten all courses into one continuous card stream. Category headings are
// rendered as labels in the same stream; cards never have a nested grid.
const orderedCourses = categories.flatMap((group) =>
  group.items.map((course, index) => ({ course, category: group.name, isFirst: index === 0 }))
);
---

<section class="registration-step" data-step="instrument">
  <header class="step-header">
    <span class="section-badge">مرحله ۱ از ۵</span>
    <h2>ساز مورد نظر خود را انتخاب کنید</h2>
    <p data-step-subtitle>با انتخاب هر ساز، استادهای مرتبط با همان ساز به شما نمایش داده می‌شود.</p>
  </header>

  <div class="registration-cards-row">
    {orderedCourses.map(({ course, category, isFirst }) => (
      <div class="registration-card-item">
        {isFirst && <h3 class="category-title">{category}</h3>}
        <InstrumentCard
          id={course.id}
          slug={course.slug}
          title={course.title}
          excerpt={course.content?.excerpt}
          image={course.media?.image}
          level={course.level}
          instructorIds={course.instructors ?? []}
        />
      </div>
    ))}
  </div>
</section>

<style>
  /* Every course is one independent item in one shared horizontal stream. */
  .registration-cards-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: thin;
  }

  .registration-card-item {
    flex: 0 0 220px;
    width: 220px;
  }

  .category-title {
    min-height: 24px;
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
  }

  .registration-card-item:not(:has(.category-title)) {
    padding-top: 32px;
  }

  @media (max-width: 760px) {
    .registration-card-item {
      flex-basis: 200px;
      width: 200px;
    }
  }
</style>
