---
/*
====================================================
File: src/components/registration/steps/InstrumentStep.astro

Purpose: Step 1 - instrument/course selection, grouped by category.
====================================================
*/

import { courses } from "../../../data/courses";
import InstrumentCard from "../cards/InstrumentCard.astro";

const activeCourses = courses.filter((course) => course.active).sort((a, b) => a.priority - b.priority);

const categories: { name: string; items: typeof activeCourses }[] = [];
for (const course of activeCourses) {
  let group = categories.find((entry) => entry.name === course.category);
  if (!group) {
    group = { name: course.category, items: [] };
    categories.push(group);
  }
  group.items.push(course);
}

// Categories with more available courses get visual priority and appear first.
categories.sort((a, b) => b.items.length - a.items.length);
---

<section class="registration-step" data-step="instrument">
  <header class="step-header">
    <span class="section-badge">مرحله ۱ از ۵</span>
    <h2>ساز مورد نظر خود را انتخاب کنید</h2>
    <p data-step-subtitle>با انتخاب هر ساز، استادهای مرتبط با همان ساز به شما نمایش داده می‌شود.</p>
  </header>

  <div class="registration-courses-flow">
    {
      categories.map((group) => (
        <section class="instrument-category" data-category-name={group.name}>
          <h3 class="category-title">{group.name}</h3>
          <div class="category-cards">
            {group.items.map((course) => (
              <InstrumentCard
                id={course.id}
                slug={course.slug}
                title={course.title}
                excerpt={course.content?.excerpt}
                image={course.media?.image}
                level={course.level}
                instructorIds={course.instructors ?? []}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<style>
  /*
   * One shared masonry-like flow for all category cards.
   * Categories themselves are not separate vertical columns, so a category
   * with one course cannot leave an artificial empty area beside a category
   * with three courses.
   */
  .registration-courses-flow {
    column-count: 3;
    column-gap: 20px;
    align-items: start;
  }

  .instrument-category {
    display: inline-block;
    width: 100%;
    margin: 0 0 22px;
    vertical-align: top;
    break-inside: avoid;
  }

  .instrument-category[data-empty="true"] {
    display: none;
  }

  .category-title {
    margin: 0 0 10px;
  }

  .category-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .category-cards .registration-card {
    padding: 14px;
  }

  .category-cards .instrument-media {
    margin-bottom: 10px;
  }

  .category-cards .instrument-content h3 {
    font-size: 16px;
  }

  .category-cards .instrument-excerpt {
    font-size: 12.5px;
    line-height: 1.7;
  }

  @media (max-width: 1100px) {
    .registration-courses-flow {
      column-count: 2;
    }
  }

  @media (max-width: 760px) {
    .registration-courses-flow {
      column-count: 1;
    }

    .category-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .category-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
