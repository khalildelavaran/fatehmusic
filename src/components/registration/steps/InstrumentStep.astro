---
import { courses } from "../../../data/courses";
import InstrumentCard from "../cards/InstrumentCard.astro";

// Keep the canonical course priority as the only ordering rule.
// Instructor filtering happens at runtime for /register?instructor=...,
// so a teacher's primary course (for example guitar) keeps its own priority.
const orderedCourses = courses
  .filter((course) => course.active)
  .sort((a, b) => a.priority - b.priority);
---

<section class="registration-step" data-step="instrument">
  <header class="step-header">
    <span class="section-badge">مرحله ۱ از ۵</span>
    <h2>دوره مورد نظر خود را انتخاب کنید</h2>
    <p data-step-subtitle>دوره مورد نظر خود را انتخاب کنید.</p>
  </header>

  <div class="registration-cards-row">
    {orderedCourses.map((course, index) => {
      const previous = orderedCourses[index - 1];
      const isFirstInCategory = !previous || previous.category !== course.category;
      return (
        <div class="registration-card-item" data-category={course.category}>
          {isFirstInCategory && <h3 class="category-title" data-category-title>{course.category}</h3>}
          <InstrumentCard
            id={course.id}
            slug={course.slug}
            title={course.title}
            excerpt={course.content?.excerpt}
            image={course.media?.image}
            level={course.level}
            instructorIds={course.instructors ?? []}
          />
        </div>
      );
    })}
  </div>
</section>

<style>
  .registration-cards-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: thin;
  }

  .registration-card-item {
    flex: 0 0 220px;
    width: 220px;
  }

  .category-title {
    min-height: 24px;
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .registration-card-item {
      flex-basis: 200px;
      width: 200px;
    }
  }
</style>
