---
import { courses } from "../../../data/courses";
import InstrumentCard from "../cards/InstrumentCard.astro";

// Course priority is the canonical ordering rule.
const orderedCourses = courses
  .filter((course) => course.active)
  .sort((a, b) => a.priority - b.priority);
---

<section class="registration-step" data-step="instrument">
  <header class="step-header">
    <span class="section-badge">مرحله ۱ از ۵</span>
    <h2>دوره مورد نظر خود را انتخاب کنید</h2>
    <p data-step-subtitle>دوره مورد نظر خود را انتخاب کنید.</p>
  </header>

  <div class="registration-cards-row">
    {orderedCourses.map((course, index) => {
      const previous = orderedCourses[index - 1];
      const isFirstInCategory = !previous || previous.category !== course.category;
      return (
        <div
          class="registration-card-item"
          data-category={course.category}
          data-category-start={isFirstInCategory ? "true" : "false"}
        >
          <div class:list={["category-divider", { "category-divider--labeled": isFirstInCategory }]} aria-label={isFirstInCategory ? `دسته‌بندی ${course.category}` : undefined}>
            {isFirstInCategory && <span>{course.category}</span>}
          </div>
          <InstrumentCard
            id={course.id}
            slug={course.slug}
            title={course.title}
            excerpt={course.content?.excerpt}
            image={course.media?.image}
            level={course.level}
            instructorIds={course.instructors ?? []}
          />
        </div>
      );
    })}
  </div>
</section>

<style>
  .registration-cards-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: thin;
  }

  .registration-card-item {
    position: relative;
    flex: 0 0 220px;
    width: 220px;
    padding-top: 34px;
  }

  /* Every card gets a gold line. The first card additionally carries the
     category label, so the line visually continues across all cards in the
     same category instead of appearing only above the first card. */
  .category-divider {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .category-divider::before,
  .category-divider::after {
    content: "";
    height: 1px;
    background: var(--color-gold, #d4af37);
    opacity: 0.8;
    flex: 1;
  }

  .category-divider:not(.category-divider--labeled)::before,
  .category-divider:not(.category-divider--labeled)::after {
    display: none;
  }

  .category-divider:not(.category-divider--labeled) {
    border-top: 1px solid var(--color-gold, #d4af37);
    opacity: 0.8;
  }

  .category-divider--labeled span {
    flex: 0 0 auto;
    color: var(--color-gold, #d4af37);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .registration-card-item {
      flex-basis: 200px;
      width: 200px;
    }
  }
</style>
