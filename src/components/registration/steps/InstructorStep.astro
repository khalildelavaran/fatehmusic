---
/*
====================================================
File: src/components/registration/steps/InstructorStep.astro

Purpose: Step 2 - instructor selection.
Populated client-side by RegistrationRenderer once an instrument
is chosen, since the list depends entirely on that choice.
====================================================
*/
---

<section class="registration-step" data-step="instructor" hidden>
  <header class="step-header">
    <button type="button" class="step-back" data-action="back-to-instrument">
      &rarr; بازگشت به انتخاب ساز
    </button>
    <span class="section-badge">مرحله ۲ از ۵</span>
    <h2>استاد مورد نظر خود را انتخاب کنید</h2>
    <p>استادهای زیر بر اساس ساز انتخابی شما نمایش داده شده‌اند.</p>
  </header>

  <div class="registration-grid instructor-grid" data-instructors-container>
    <div class="registration-card empty-state">
      <p>ابتدا ساز مورد نظر خود را انتخاب کنید.</p>
    </div>
  </div>
</section>
