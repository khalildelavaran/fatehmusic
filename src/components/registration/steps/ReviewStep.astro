---
/*
====================================================
File: src/components/registration/steps/ReviewStep.astro

Purpose: Step 5 - final review before submission.
Values are filled in by RegistrationRenderer.updateReview().
====================================================
*/

const summaryRows = [
  { field: "review-instrument", label: "ساز", action: "edit-instrument" },
  { field: "review-instructor", label: "استاد", action: "edit-instructor" },
  { field: "review-schedule", label: "روز و زمان کلاس", action: "edit-schedule" }
];

const studentRows = [
  { field: "review-student", label: "نام و نام خانوادگی" },
  { field: "review-mobile", label: "شماره موبایل" },
  { field: "review-age", label: "سن" },
  { field: "review-gender", label: "جنسیت" },
  { field: "review-hasInstrument", label: "وضعیت ساز" }
];
---

<section class="registration-step" data-step="review" hidden>
  <header class="step-header">
    <span class="section-badge">مرحله ۵ از ۵</span>
    <h2>بررسی نهایی اطلاعات</h2>
    <p>پیش از تأیید، اطلاعات زیر را بررسی کنید.</p>
  </header>

  <ul class="form-errors" data-form-errors hidden></ul>

  <div class="review-card">
    <h3>دوره انتخابی</h3>
    {
      summaryRows.map((row) => (
        <div class="review-row">
          <span class="review-label">{row.label}</span>
          <span class="review-value" data-field-out={row.field} />
          <button type="button" class="review-edit" data-action={row.action}>
            ویرایش
          </button>
        </div>
      ))
    }
    <div data-review-pricing />
  </div>

  <div class="review-card">
    <h3>مشخصات هنرجو</h3>
    {
      studentRows.map((row) => (
        <div class="review-row">
          <span class="review-label">{row.label}</span>
          <span class="review-value" data-field-out={row.field} />
        </div>
      ))
    }
    <button type="button" class="review-edit" data-action="edit-student">
      ویرایش مشخصات
    </button>
  </div>

  <div class="review-actions">
    <button type="button" class="secondary-btn" data-action="back-to-student">
      بازگشت
    </button>
    <button type="button" class="btn" data-action="submit-registration">
      تأیید نهایی و ثبت نام
    </button>
  </div>
</section>
