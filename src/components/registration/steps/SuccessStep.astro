---
/*
====================================================
File: src/components/registration/steps/SuccessStep.astro

Purpose: Final step - confirmation, tracking code, and next steps.
Values are filled in by RegistrationRenderer.updateSuccess().
====================================================
*/
---

<section class="registration-step success-step" data-step="success" hidden>
  <div class="success-mark">&#10003;</div>
  <h2>ثبت نام شما با موفقیت انجام شد</h2>
  <p>کارشناسان آموزشگاه برای هماهنگی نهایی با شما تماس خواهند گرفت.</p>

  <div class="tracking-card">
    <span>کد پیگیری</span>
    <strong data-field-out="success-tracking-code">-</strong>
  </div>

  <div class="review-card">
    <h3>خلاصه ثبت نام</h3>
    <div class="review-row">
      <span class="review-label">ساز</span>
      <span class="review-value" data-field-out="success-instrument">-</span>
    </div>
    <div class="review-row">
      <span class="review-label">استاد</span>
      <span class="review-value" data-field-out="success-instructor">-</span>
    </div>
    <div class="review-row">
      <span class="review-label">روز و زمان کلاس</span>
      <span class="review-value" data-field-out="success-schedule">-</span>
    </div>
  </div>

  <div class="materials-card" data-materials-container></div>

  <div class="contact-card">
    <h3>نیاز به مشاوره خرید ساز دارید؟</h3>
    <p>کارشناسان آموزشگاه فاتح شما را در انتخاب ساز مناسب راهنمایی می‌کنند.</p>
    <div class="contact-links" data-contact-links></div>
  </div>

  <div class="success-actions">
    <button type="button" class="secondary-btn" data-action="print-receipt">
      چاپ رسید ثبت نام
    </button>
    <button type="button" class="btn" data-action="back-home">
      بازگشت به صفحه اصلی
    </button>
  </div>
</section>
