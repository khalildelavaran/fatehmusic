---
/*
====================================================
File: src/components/registration/steps/WelcomeStep.astro

Purpose: Wizard intro / entry point (Step 0)
====================================================
*/

const journey = [
  { label: "ساز", detail: "ساز مورد علاقه‌تان را انتخاب کنید" },
  { label: "استاد", detail: "استاد متناسب با ساز شما معرفی می‌شود" },
  { label: "زمان", detail: "روز و ساعت کلاس را مشخص کنید" }
];
---

<section class="registration-step welcome-step" data-step="welcome">
  <div class="welcome-content">
    <span class="section-badge">مرحله اول</span>
    <h2>ثبت نام در آموزشگاه موسیقی فاتح</h2>
    <p>
      تکمیل این فرم حدود دو دقیقه زمان می‌برد. در پایان یک کد پیگیری
      دریافت می‌کنید و کارشناسان آموزشگاه برای هماهنگی نهایی با شما تماس
      خواهند گرفت.
    </p>

    <ul class="welcome-journey">
      {
        journey.map((item, index) => (
          <li>
            <span class="welcome-journey-index">{index + 1}</span>
            <div>
              <strong>{item.label}</strong>
              <span>{item.detail}</span>
            </div>
          </li>
        ))
      }
    </ul>

    <button type="button" class="btn" data-action="start-registration">
      شروع ثبت نام
    </button>
  </div>
</section>
