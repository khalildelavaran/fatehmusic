/*
====================================================
File:
src/components/registration/cards/InstrumentCard.astro

Purpose:
Reusable instrument selection card

Architecture:
- UI only
- No business logic
- Selection handled by RegistrationController
- Provides instrument metadata through data attributes

Controller compatibility:
- data-instrument-id
- data-instrument-title
- data-action="select-instrument"

====================================================
*/

---

interface Props {


    id: string | number;


    title: string;


    image?: string;


    description?: string;


    level?: string;


}



const {

    id,

    title,

    image,

    description,

    level

} = Astro.props;


---



<article


    class="registration-card instrument-card"


    data-instrument-id={id}


    data-instrument-title={title}


    data-action="select-instrument"


    tabindex="0"


    role="button"


>






    {

        image && (


            <div class="instrument-image">


                <img

                    src={image}

                    alt={title}

                    loading="lazy"

                />


            </div>


        )

    }








    <div class="instrument-content">





        <h3>


            {title}


        </h3>







        {

            description && (


                <p class="instrument-description">


                    {description}


                </p>


            )

        }







        {

            level && (


                <span class="instrument-level">


                    {level}


                </span>


            )

        }





    </div>









    <div class="select-indicator">


        انتخاب این ساز


    </div>







</article>