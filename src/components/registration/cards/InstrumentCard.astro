---
/*
====================================================
File: src/components/registration/cards/InstrumentCard.astro

Purpose: A single selectable instrument/course card for Step 1.
====================================================
*/

import { formatToman, getPricingPlan } from "../../../scripts/registration/RegistrationUtils";

interface Props {
  id: number;
  slug: string;
  title: string;
  excerpt?: string;
  image?: string;
  level?: string[];
}

const { id, slug, title, excerpt, image, level = [] } = Astro.props;

const plan = getPricingPlan(slug);
const monthlyPrice = plan?.paymentOptions?.halfTerm?.amount;
---

<article
  class="registration-card instrument-card"
  data-action="select-instrument"
  data-instrument-id={id}
  data-instrument-title={title}
  tabindex="0"
  role="button"
>
  <div class="instrument-media">
    {
      image && (
        <img
          src={image}
          alt={title}
          loading="lazy"
          onerror="this.remove()"
        />
      )
    }
  </div>
  <div class="instrument-content">
    <h3>{title}</h3>
    {excerpt && <p class="instrument-excerpt">{excerpt}</p>}
    {
      level.length > 0 && (
        <div class="tag-row">
          {level.map((item) => <span class="mini-tag">{item}</span>)}
        </div>
      )
    }
  </div>
  {
    monthlyPrice && (
      <div class="instrument-price">
        <span>شروع از</span>
        <strong>{formatToman(monthlyPrice)}</strong>
        <span>در ماه</span>
      </div>
    )
  }
  <div class="select-indicator">انتخاب این ساز</div>
</article>
