---
import "../styles/ContactOverview.css";

import { contact } from "../data/contact";

import {
    Smartphone,
    MapPinned,
    Clock3,
    Phone,
    Navigation,
    Instagram,
    MessageCircle,
    Send
} from "@lucide/astro";
---
<section class="contact-overview section">

    <div class="container">

        <div class="section-header">

            <span class="badge">

                اطلاعات تماس

            </span>

            <h2>

                ارتباط با آموزشگاه موسیقی فاتح

            </h2>

            <p>

                برای دریافت مشاوره، ثبت‌نام در دوره‌های آموزشی و پاسخ به پرسش‌های
                خود از راه‌های زیر با ما در ارتباط باشید.

            </p>

        </div>

        <div class="contact-layout">

            <!-- ستون اطلاعات -->

            <article class="card contact-card">

                <div class="contact-body">

                    <!-- موبایل -->

                    <div class="contact-item">

                        <div class="contact-icon">

                            <Smartphone />

                        </div>

                        <div class="contact-content">

                            <span class="title">

                                موبایل

                            </span>

                            <a
                                href={"tel:+" + contact.phones.mobile.raw}
                                class="value">

                                {contact.phones.mobile.display}

                            </a>

                        </div>

                    </div>

                    <!-- آدرس -->

                    <div class="contact-item">

                        <div class="contact-icon">

                            <MapPinned />

                        </div>

                        <div class="contact-content">

                            <span class="title">

                                آدرس آموزشگاه

                            </span>

                            <p class="value">

                                {contact.address.full}

                            </p>

                        </div>

                    </div>

                    <!-- ساعات کاری -->

                    <div class="contact-item">

                        <div class="contact-icon">

                            <Clock3 />

                        </div>

                        <div class="contact-content">

                            <span class="title">

                                ساعات کاری

                            </span>

\t\t\t\t\t\t\t<div class="working-hours">

\t\t\t\t\t\t\t\t{
\t\t\t\t\t\t\t\t\tcontact.workingHours.map((item) => (
\t\t\t\t\t\t\t\t\t\t<div class="working-row">

\t\t\t\t\t\t\t\t\t\t\t<strong>

\t\t\t\t\t\t\t\t\t\t\t\t{item.title}

\t\t\t\t\t\t\t\t\t\t\t</strong>

\t\t\t\t\t\t\t\t\t\t\t<span>

\t\t\t\t\t\t\t\t\t\t\t\t{item.value}

\t\t\t\t\t\t\t\t\t\t\t</span>

\t\t\t\t\t\t\t\t\t\t</div>
\t\t\t\t\t\t\t\t\t))
\t\t\t\t\t\t\t\t}

\t\t\t\t\t\t\t</div>
                        </div>

                    </div>

                    <!-- شبکه های اجتماعی -->

                    <div class="social-section">

                        <h3>

                            شبکه‌های اجتماعی

                        </h3>

                        <div class="social-grid">

                            <!-- Instagram -->

                            <a
                                href={contact.social.instagram}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-card">

                                <div class="social-icon">

                                    <Instagram />

                                </div>

                                <div>

                                    <strong>

                                        اینستاگرام

                                    </strong>

                                </div>

                            </a>

                            <!-- WhatsApp -->

                            <a
                                href={contact.social.whatsapp}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-card">

                                <div class="social-icon">

                                    <MessageCircle />

                                </div>

                                <div>

                                    <strong>

                                        واتس‌آپ

                                    </strong>

                                </div>

                            </a>

                            <!-- Telegram -->

                            <a
                                href={contact.social.telegram}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-card">

                                <div class="social-icon">

                                    <Send />

                                </div>

                                <div>

                                    <strong>

                                        تلگرام

                                    </strong>

                                </div>

                            </a>

                        </div>

                    </div>

                    <!-- عملیات -->

                    <div class="action-grid">

                        <!-- تماس -->

                        <a
                            href={"tel:+" + contact.phones.mobile.raw}
                            class="action-card primary">

                            <Phone />

                            <span>

                                تماس مستقیم

                            </span>

                        </a>

                        <!-- پیامک -->

\t\t\t\t\t\t<a
\t\t\t\t\t\t\thref={contact.contact.sms}
\t\t\t\t\t\t\tclass="action-card">

\t\t\t\t\t\t\t<Send />

\t\t\t\t\t\t\t<span>
\t\t\t\t\t\t\t\tپیامک
\t\t\t\t\t\t\t</span>

\t\t\t\t\t\t</a>

                        <!-- مسیریابی -->

                        <a
                            href={contact.map.navigation}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-card">

                            <Navigation />

                            <span>

                                مسیریابی

                            </span>

                        </a>

                    </div>

                </div>

            </article>
            <!-- ستون نقشه -->

            <aside class="card contact-map">

                <iframe
                    src={contact.map.iframe}
                    title="نقشه آموزشگاه موسیقی فاتح"
                    loading="lazy"
                    allowfullscreen
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>

                <div class="map-overlay">

                    <span class="badge">

                        آموزشگاه موسیقی فاتح

                    </span>

                    <h3>

                        موقعیت آموزشگاه

                    </h3>

                    <p>

                        {contact.address.full}

                    </p>

                    <div class="map-actions">
\t\t\t\t\t<a
\t\t\t\t\t\thref={contact.map.google}
\t\t\t\t\t\ttarget="_blank"
\t\t\t\t\t\trel="noopener noreferrer"
\t\t\t\t\t\tclass="btn btn-primary">

\t\t\t\t\t\t<img src="/icons/google-maps.svg" alt="Google Maps" />

\t\t\t\t\t\t<span>Google Maps</span>

\t\t\t\t\t</a>

\t\t\t\t\t<a
\t\t\t\t\t\thref={contact.map.balad}
\t\t\t\t\t\ttarget="_blank"
\t\t\t\t\t\trel="noopener noreferrer"
\t\t\t\t\t\tclass="btn btn-outline">

\t\t\t\t\t\t<img src="/icons/balad.svg" alt="بلد" />

\t\t\t\t\t\t<span>بلد</span>

\t\t\t\t\t</a>

\t\t\t\t\t<a
\t\t\t\t\t\thref={contact.map.neshan}
\t\t\t\t\t\ttarget="_blank"
\t\t\t\t\t\trel="noopener noreferrer"
\t\t\t\t\t\tclass="btn btn-outline">

\t\t\t\t\t\t<img src="/icons/neshan.svg" alt="نشان" />

\t\t\t\t\t\t<span>نشان</span>

\t\t\t\t\t</a>

                    </div>

                </div>

            </aside>

        </div>

    </div>

</section>