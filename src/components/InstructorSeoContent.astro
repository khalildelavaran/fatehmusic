---
/**
 * --------------------------------------------------------
 * Fateh Music Academy
 * Component: InstructorSeoContent
 * Description: Renders the long-form seoContent block that
 * src/seo/resolvers/instructor.js merges in from
 * src/data/instructor-content.js. Renders nothing when an
 * instructor has no entry yet (`seoContent === null`), so this
 * rolls out one instructor at a time without breaking the rest.
 * Class names use the existing "teacher-" prefix already
 * established (and styled) in src/pages/instructors/[slug].astro,
 * for visual consistency with the hero/courses/about sections.
 * --------------------------------------------------------
 */

export interface Props {
  instructorName: string;
  seoContent: {
    quickSummary: string;
    teachingPhilosophy: string[];
    methodBySubject: { subject: string; description: string }[];
    whoShouldStudyWithThem: string[];
    typicalProgression: string[];
    commonStudentMistakes: { mistake: string; fix: string }[];
    whyStudentsChooseThem: string[];
  } | null;
}

const { instructorName, seoContent } = Astro.props;
---

{seoContent && (

  <Fragment>

    <section class="teacher-quick-summary">
      <div class="container">
        <span class="section-badge">خلاصه این صفحه</span>
        <p>{seoContent.quickSummary}</p>
      </div>
    </section>

    <section class="teacher-philosophy">
      <div class="container">
        <div class="section-header">
          <span class="section-badge">روش تدریس</span>
          <h2>فلسفه آموزشی {instructorName}</h2>
        </div>
        {seoContent.teachingPhilosophy.map((paragraph) => <p class="teacher-prose">{paragraph}</p>)}
      </div>
    </section>

    {seoContent.methodBySubject.length > 0 && (
      <section class="teacher-subjects">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">حوزه‌های تدریس</span>
            <h2>روش تدریس {instructorName} در هر حوزه</h2>
          </div>

          <div class="teacher-subjects-grid">
            {seoContent.methodBySubject.map((item) => (
              <div class="card teacher-subject-card">
                <h3>{item.subject}</h3>
                <p>{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="teacher-fit">
      <div class="container">
        <div class="teacher-two-col">

          <div>
            <h3>چه هنرجویانی مناسب این مدرس هستند؟</h3>
            <ul class="teacher-list">
              {seoContent.whoShouldStudyWithThem.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div>
            <h3>مسیر معمول پیشرفت هنرجویان</h3>
            {seoContent.typicalProgression.map((paragraph) => <p>{paragraph}</p>)}
          </div>

        </div>
      </div>
    </section>

    {seoContent.commonStudentMistakes.length > 0 && (
      <section class="teacher-mistakes">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">نکات مهم</span>
            <h2>اشتباهات رایج هنرجویان</h2>
          </div>

          <div class="teacher-mistakes-grid">
            {seoContent.commonStudentMistakes.map((item) => (
              <div class="card teacher-mistake-card">
                <p><strong>اشتباه رایج:</strong> {item.mistake}</p>
                <p><strong>راهکار:</strong> {item.fix}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="teacher-why">
      <div class="container">
        <div class="section-header">
          <span class="section-badge">چرا این مدرس؟</span>
          <h2>چرا هنرجویان {instructorName} را انتخاب می‌کنند؟</h2>
        </div>
        {seoContent.whyStudentsChooseThem.map((paragraph) => <p class="teacher-prose">{paragraph}</p>)}
      </div>
    </section>

  </Fragment>

)}

<style>
.teacher-quick-summary,
.teacher-philosophy,
.teacher-subjects,
.teacher-fit,
.teacher-mistakes,
.teacher-why{
    padding:60px 0;
}

.teacher-quick-summary p{
    max-width:900px;
    line-height:2;
    color:var(--text-secondary);
    margin-top:1rem;
}

.teacher-prose{
    max-width:900px;
    line-height:2;
    color:var(--text-secondary);
    margin-bottom:1.25rem;
}

.teacher-subjects-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:1.5rem;
    margin-top:2rem;
}

.teacher-subject-card{
    padding:1.5rem;
}

.teacher-subject-card h3{
    color:var(--primary);
    margin-bottom:.75rem;
    font-size:1.05rem;
}

.teacher-subject-card p{
    color:var(--text-secondary);
    line-height:1.8;
    font-size:.95rem;
}

.teacher-two-col{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:2.5rem;
}

.teacher-two-col h3{
    margin-bottom:1rem;
}

.teacher-two-col p{
    line-height:2;
    color:var(--text-secondary);
    margin-bottom:1rem;
}

.teacher-list{
    list-style:none;
    display:flex;
    flex-direction:column;
    gap:.85rem;
}

.teacher-list li{
    position:relative;
    padding-inline-start:1.6rem;
    line-height:1.9;
    color:var(--text-secondary);
}

.teacher-list li::before{
    content:"";
    position:absolute;
    inset-inline-start:0;
    top:.6em;
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--gold);
}

.teacher-mistakes-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:1.5rem;
    margin-top:2rem;
}

.teacher-mistake-card{
    padding:1.5rem;
}

.teacher-mistake-card p{
    color:var(--text-secondary);
    line-height:1.8;
    margin-bottom:.75rem;
}

.teacher-mistake-card p:last-child{
    margin-bottom:0;
}

.teacher-mistake-card strong{
    color:var(--text);
}

@media (max-width:900px){

    .teacher-two-col{
        grid-template-columns:1fr;
        gap:1.5rem;
    }

}
</style>
