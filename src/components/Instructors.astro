---
import { instructors } from "../data/instructors";
import { schedules } from "../data/schedule";

// -------------------------------------------------
//    Instructor Cards
// --------------------------------------------------

const instructorCards = instructors.map((ins) => {

  const instructorSchedules = schedules.filter(
    (s) =>
      s.active &&
      s.instructorId === ins.id
  );

  const days = [
    ...new Set(
      instructorSchedules.map((s) => s.weekday)
    )
  ];

  return {
    ...ins,
    schedules: instructorSchedules,
    days
  };

});
---

<section
  class="instructors"
  data-reveal="fade-up"
>

  <div class="container">


    <!-- ===========================
         Section Header
    ============================ -->

    <div
      class="section-header"
      data-reveal-group
    >

      <span
        class="section-badge"
        data-reveal
        data-reveal-delay="1"
      >
        اساتید آموزشگاه
      </span>


		<h2
		  class="section-title"
		  data-reveal
		  data-reveal-delay="2"
		>
		  تیم حرفه‌ای مدرسین موسیقی
		</h2>

      <p
        data-reveal
        data-reveal-delay="3"
      >
        آموزش توسط اساتید با تجربه در حوزه موسیقی کلاسیک و مدرن
      </p>


    </div>




    <!-- ===========================
         Instructor Cards
    ============================ -->


    <div
      class="instructors-grid"
      data-reveal-group
    >


      {instructorCards.map((ins) => (


        <div class="instructor-card">


          <div class="instructor-image">


            <a
              href={`/instructors/${ins.slug}`}
              class="instructor-image-link"
            >

              <img
                src={ins.media.images.profile}
                alt={ins.name}
                loading="lazy"
                decoding="async"
              />

            </a>



            {ins.id === 1 && (


              <span class="badge">

                مدیر آموزشگاه

              </span>


            )}


            <a
              href={`/register?instructor=${ins.slug}`}
              class="card-register-badge"
              aria-label={`ثبت‌نام با ${ins.name}`}
            >
              ثبت‌نام
            </a>


          </div>



          <div class="instructor-content">


            <a
              href={`/instructors/${ins.slug}`}
              class="instructor-title-link"
            >
              <h3>

                {ins.name}

              </h3>
            </a>



            <p>

              {ins.position}

            </p>




            {ins.days.length > 0 && (


              <div class="days-tags">


                {ins.days.map((day) => (


                  <span
                    class="day-tag"
                    aria-label={`روز حضور ${day}`}
                  >

                    {day}

                  </span>


                ))}


              </div>


            )}



          </div>



        </div>


      ))}


    </div>


  </div>


</section>