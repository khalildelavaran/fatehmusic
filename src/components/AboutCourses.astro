---
import type { Course } from "../types/courses";
import "../styles/AboutCourses.css";
import { courses } from "../data/courses.js";

interface CategoryGroup {
    category: string;
    courses: Course[];
}

const activeCourses = (courses as Course[]).filter(
    (course: Course) => course.active
);

const categoryGroups = activeCourses.reduce<CategoryGroup[]>(
    (groups, course: Course) => {
        let group = groups.find(
            (g: CategoryGroup) => g.category === course.category
        );

        if (!group) {
            group = {
                category: course.category,
                courses: []
            };

            groups.push(group);
        }

        group.courses.push(course);

        return groups;
    },
    []
);

const totalCourses = activeCourses.length;

function categoryHeading(category: string): string {
    if (
        category.startsWith("آموزش") ||
        category.startsWith("دروس")
    ) {
        return category;
    }

    return `دوره‌های ${category}`;
}
---

<section
    class="about-courses"
    data-reveal="fade-up"
>

    <div class="container">

        <div
            class="section-header"
            data-reveal-group
        >

            <span
                class="section-badge"
                data-reveal
                data-reveal-delay="1"
            >
                دوره‌های آموزشی
            </span>

            <h2
                data-reveal
                data-reveal-delay="2"
            >
                دوره‌های آموزشی آموزشگاه موسیقی فاتح
            </h2>

            <p
                data-reveal
                data-reveal-delay="3"
            >
                در آموزشگاه موسیقی فاتح {totalCourses} دوره آموزشی، از
                سازهای زهی و آرشه‌ای گرفته تا سازهای کلاویه‌ای، کوبه‌ای و
                بادی، آواز و دروس پایه موسیقی، به‌صورت جداگانه تدریس
                می‌شوند. هر دوره صفحه اختصاصی خودش را دارد که در آن جزئیات
                ساز، سطح آموزشی، استاد یا اساتید مربوطه و نحوه ثبت‌نام
                آورده شده است. برای انتخاب آگاهانه‌تر،
                <a href="/blog/how-to-choose-music-course-in-shushtar">
                    راهنمای انتخاب دوره مناسب آموزش موسیقی در شوشتر
                </a>
                را نیز مطالعه کنید.
            </p>

        </div>

        {categoryGroups.map((group: CategoryGroup) => (

            <div class="course-category">

                <h3
                    class="category-heading"
                    data-reveal="fade-up"
                >
                    {categoryHeading(group.category)}
                </h3>

                <div
                    class="courses-grid about-courses-grid"
                    data-reveal-group
                >

                    {group.courses.map((course: Course) => (

                        <a
                            href={`/courses/${course.slug}`}
                            class="course-card"
                            data-reveal="fade-up"
                        >

                            <div class="course-image">
                                <img
                                    src={course.media.image}
                                    alt={course.title}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>

                            <div class="course-content">

                                <h4 class="course-title">
                                    {course.title}
                                </h4>

                                <span class="course-subtitle">
                                    {course.content.excerpt}
                                </span>

                            </div>

                        </a>

                    ))}

                </div>

            </div>

        ))}

        <div
            class="about-section-cta"
            data-reveal
            data-reveal-delay="4"
        >
            <a
                href="/courses"
                class="secondary-btn"
            >
                مشاهده همه دوره‌ها
            </a>
        </div>

    </div>

</section>