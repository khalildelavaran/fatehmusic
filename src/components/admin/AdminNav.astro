---
import { ROLES, ROLE_LABELS_FA } from "../../server/admin-auth";

export interface Props {
  session: { username: string; role: string };
  active: "dashboard" | "daily" | "reports" | "posts" | "topics" | "books" | "certificates" | "courses" | "registration" | "students" | "instructors" | "classes" | "content-strategy";
}

const { session, active } = Astro.props;
const isAdmin = session.role === ROLES.ADMIN;
const roleLabel = ROLE_LABELS_FA[session.role] ?? session.role;
---
<aside class="admin-nav">
  <div class="admin-nav-brand"><span class="admin-nav-mark">ف</span><div class="admin-nav-brand-text"><strong>آموزشگاه فاتح</strong><span>پنل مدیریت</span></div></div>
  <nav class="admin-nav-links" aria-label="ناوبری مدیریت">
    <a href="/admin" class:list={["admin-nav-link", active === "dashboard" && "is-active"]}>داشبورد</a>
    <a href="/admin/daily" class:list={["admin-nav-link", active === "daily" && "is-active"]}>داشبورد روزانه</a>
    <a href="/admin/reports" class:list={["admin-nav-link", active === "reports" && "is-active"]}>گزارش‌ها</a>
    {isAdmin && <a href="/admin/posts" class:list={["admin-nav-link", active === "posts" && "is-active"]}>نوشته‌ها</a>}
    {isAdmin && <a href="/admin/content-strategy" class:list={["admin-nav-link", active === "content-strategy" && "is-active"]}>استراتژی محتوا</a>}
    {isAdmin && <a href="/admin/topics" class:list={["admin-nav-link", active === "topics" && "is-active"]}>موضوعات</a>}
    {isAdmin && <a href="/admin/books" class:list={["admin-nav-link", active === "books" && "is-active"]}>کتاب‌ها</a>}
    {isAdmin && <a href="/admin/certificates" class:list={["admin-nav-link", active === "certificates" && "is-active"]}>گواهینامه‌ها</a>}
    <a href="/admin/courses" class:list={["admin-nav-link", active === "courses" && "is-active"]}>دوره‌ها</a>
    <a href="/admin/students" class:list={["admin-nav-link", active === "students" && "is-active"]}>هنرجویان</a>
    <a href="/admin/instructors" class:list={["admin-nav-link", active === "instructors" && "is-active"]}>مدرسان</a>
    <a href="/admin/classes" class:list={["admin-nav-link", active === "classes" && "is-active"]}>کلاس‌ها</a>
    <a href="/admin/registration" class:list={["admin-nav-link", active === "registration" && "is-active"]}>ثبت‌نام‌ها</a>
  </nav>
  <div class="admin-nav-user"><div class="admin-nav-user-info"><strong>{session.username}</strong><span class="admin-role-badge" data-role={session.role}>{roleLabel}</span></div><form id="navLogoutForm" method="post" action="/api/admin/logout"><button type="submit" class="admin-nav-logout">خروج</button></form></div>
</aside>
