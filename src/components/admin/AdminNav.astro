---
import { ROLES, ROLE_LABELS_FA } from "../../server/admin-auth";

export interface Props {
  session: { username: string; role: string };
  active: "dashboard" | "posts" | "topics" | "books" | "certificates" | "courses" | "registration" | "students" | "instructors";
}

const { session, active } = Astro.props;
const isAdmin = session.role === ROLES.ADMIN;
const roleLabel = ROLE_LABELS_FA[session.role] ?? session.role;
---
<aside class="admin-nav">
  <div class="admin-nav-brand">
    <span class="admin-nav-mark">ف</span>
    <div class="admin-nav-brand-text">
      <strong>آموزشگاه فاتح</strong>
      <span>پنل مدیریت</span>
    </div>
  </div>

  <nav class="admin-nav-links" aria-label="ناوبری مدیریت">
    <a href="/admin" class:list={["admin-nav-link", active === "dashboard" && "is-active"]} aria-current={active === "dashboard" ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>
      داشبورد
    </a>

    {isAdmin && (
      <a href="/admin/posts" class:list={["admin-nav-link", active === "posts" && "is-active"]} aria-current={active === "posts" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5a1 1 0 0 0 1 1h5"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
        نوشته‌ها
a
      </a>
    )}

    {isAdmin && (
      <a href="/admin/topics" class:list={["admin-nav-link", active === "topics" && "is-active"]} aria-current={active === "topics" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><path d="M11 8v3l2 2"/></svg>
        موضوعات
      </a>
    )}

    {isAdmin && (
      <a href="/admin/books" class:list={["admin-nav-link", active === "books" && "is-active"]} aria-current={active === "books" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
        کتاب‌ها
      </a>
    )}

    {isAdmin && (
      <a href="/admin/certificates" class:list={["admin-nav-link", active === "certificates" && "is-active"]} aria-current={active === "certificates" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="m9 13.5-1.5 7L12 18l4.5 2.5-1.5-7"/></svg>
        گواهینامه‌ها
      </a>
    )}

    <a href="/admin/courses" class:list={["admin-nav-link", active === "courses" && "is-active"]} aria-current={active === "courses" ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5v-12Z"/><path d="M4 17.5A2.5 2.5 0 0 0 6.5 20H20"/><path d="M8 7h8M8 11h6"/></svg>
      دوره‌ها
    </a>

    <a href="/admin/students" class:list={["admin-nav-link", active === "students" && "is-active"]} aria-current={active === "students" ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/><circle cx="11" cy="9" r="2"/><path d="M8 15c.5-1.5 1.7-2 3-2s2.5.5 3 2"/></svg>
      هنرجویان
    </a>

    <a href="/admin/instructors" class:list={["admin-nav-link", active === "instructors" && "is-active"]} aria-current={active === "instructors" ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/><path d="M19 8c0-2-1-3.5-3-4"/></svg>
      مدرسان
    </a>

    <a href="/admin/registration" class:list={["admin-nav-link", active === "registration" && "is-active"]} aria-current={active === "registration" ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      ثبت‌نام‌ها
    </a>
  </nav>

  <div class="admin-nav-user">
    <div class="admin-nav-user-info">
      <strong>{session.username}</strong>
      <span class="admin-role-badge" data-role={session.role}>{roleLabel}</span>
    </div>
    <form id="navLogoutForm" method="post" action="/api/admin/logout">
      <button type="submit" class="admin-nav-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        خروج
      </button>
    </form>
  </div>
</aside>

<style is:global>
  .admin-shell input,
  .admin-shell textarea,
  .admin-shell select {
    color-scheme: dark;
    color: var(--text);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-family: inherit;
  }

  .admin-shell select {
    appearance: auto;
    min-height: 42px;
    padding: 9px 12px;
  }

  .admin-shell select option,
  .admin-shell select optgroup {
    color: var(--text);
    background: var(--surface);
  }

  .admin-shell input:focus,
  .admin-shell textarea:focus,
  .admin-shell select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.14);
  }

  .admin-shell .admin-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .admin-shell .admin-form > label,
  .admin-shell .admin-form > textarea,
  .admin-shell .admin-form > .admin-form-actions,
  .admin-shell .admin-form > fieldset,
  .admin-shell .admin-form > .full-width {
    grid-column: 1 / -1;
  }

  .admin-shell .admin-form > label:has(textarea),
  .admin-shell .admin-form > label:has(select[multiple]) {
    grid-column: 1 / -1;
  }

  @media (max-width: 760px) {
    .admin-shell .admin-form {
      grid-template-columns: 1fr;
    }

    .admin-shell .admin-form > label,
    .admin-shell .admin-form > textarea,
    .admin-shell .admin-form > .admin-form-actions,
    .admin-shell .admin-form > fieldset,
    .admin-shell .admin-form > .full-width {
      grid-column: 1;
    }
  }
</style>

<script>
  document.querySelector("#navLogoutForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
    window.location.assign("/admin/login");
  });
</script>
