---
import { Picture } from "astro:assets";
import heroPhoto from "../assets/images/hero/academy.webp";
---

<section class="hero">

  <div class="container hero-container">

    <div class="hero-content">

      <div class="hero-badge">
        آموزشگاه موسیقی فاتح
      </div>

      <h1>
        آموزشگاه موسیقی فاتح شوشتر
      </h1>

      <p class="hero-subtitle">
        با مجوز رسمی وزارت فرهنگ و ارشاد
      </p>

      <p>
        آموزش تخصصی گیتار، پیانو، ویولن، آواز و سازهای ایرانی
        با اساتید مجرب در محیطی مدرن و الهام‌بخش. در آموزشگاه موسیقی فاتح،
        دوره‌های آموزش موسیقی برای کودکان، نوجوانان و بزرگسالان و برای
        سطوح مختلف از مبتدی تا پیشرفته برگزار می‌شود.
      </p>

      <div class="hero-actions">
        <a href="/register" class="btn">ثبت‌نام در دوره‌ها</a>
        <a href="/courses" class="secondary-btn">مشاهده دوره‌ها</a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <strong class="hero-stat-number">بیش از ۲۵ </strong>
          <span class="hero-stat-label">سال تجربه</span>
        </div>
        <div class="hero-stat">
          <strong class="hero-stat-number">بیش از ۵۰۰۰</strong>
          <span class="hero-stat-label">هنرجو</span>
        </div>
        <div class="hero-stat">
          <strong class="hero-stat-number">و ۲۳ </strong>
          <span class="hero-stat-label">دوره آموزشی</span>
        </div>
      </div>

    </div>

    <div class="hero-image">
      <div class="hero-image-wrapper">
        <Picture
          src={heroPhoto}
          alt="آموزشگاه موسیقی فاتح شوشتر"
          class="hero-photo"
          widths={[320, 480, 640, 768]}
          sizes="(max-width: 768px) 100vw, 50vw"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

  </div>

</section>
