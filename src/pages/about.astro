---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

import AboutOverview from "../components/AboutOverview.astro";
import AboutMission from "../components/AboutMission.astro";
import AboutTeachers from "../components/AboutTeachers.astro";
import AboutCourses from "../components/AboutCourses.astro";
import AboutFacilities from "../components/AboutFacilities.astro";
import AboutFAQ from "../components/AboutFAQ.astro";

import {
    resolveSite,
    resolveInstructor,
    buildPersonSchema,
    buildBreadcrumbSchema,
    buildAboutPageSchema,
    buildFaqSchema
} from "../seo/index.js";
import { instructors } from "../data/instructors.js";

const title = "درباره آموزشگاه موسیقی فاتح در شوشتر | اساتید و روش آموزش";
const description =
    "درباره آموزشگاه موسیقی فاتح در شوشتر؛ معرفی اساتید، دوره‌ها، روش آموزش و رشته‌های موسیقی برای کودکان، نوجوانان و بزرگسالان.";

const site = resolveSite();

const instructorSchemas = instructors
    .filter((instructor) => instructor.active)
    .map((instructor) => {
        const resolved = resolveInstructor(instructor, site);
        return resolved ? buildPersonSchema(resolved, { site }) : null;
    })
    .filter((item): item is object => item !== null);

const faqSchema = buildFaqSchema(AboutFAQ.faqs, {
    site,
    url: `${site.url}/about`,
    name: "سوالات متداول درباره آموزشگاه موسیقی فاتح"
});
const schema = [
    buildAboutPageSchema({ title, description, image: site.image, site }),
    buildBreadcrumbSchema(
        [
            { name: "خانه", path: "/" },
            { name: "درباره ما", path: "/about" }
        ],
        site
    ),
    ...instructorSchemas,
    faqSchema
].filter((item): item is object => item !== null);
---

<MainLayout
    title={title}
    description={description}
    canonical={`${site.url}/about`}
    keywords={["درباره آموزشگاه موسیقی فاتح", "آموزشگاه موسیقی شوشتر", "اساتید موسیقی شوشتر", "روش آموزش موسیقی"]}
    topics={["shushtar", "music-education", "instructors"]}
    entityType="AboutPage"
    auditContext={{ h1Count: 1, missingImageAlt: 0, internalLinkCount: 6 }}
    schema={schema}
>
    <Header />
    <PageHero
        badge="درباره ما"
        title="درباره آموزشگاه موسیقی فاتح"
        description="آشنایی با آموزشگاه موسیقی فاتح؛ فلسفه آموزشی، اساتید و دوره‌های این مجموعه در شوشتر."
    />
    <main>
        <AboutOverview />
        <AboutMission />
        <AboutTeachers />
        <AboutCourses />
        <AboutFacilities />
        <AboutFAQ />
        <section class="container" style="padding: 20px 0 70px;">
            <h2>دوره‌ها، اساتید و اطلاعات آموزش موسیقی در شوشتر</h2>
            <p>برای بررسی دوره‌های آموزشی، انتخاب مدرس و دریافت اطلاعات محلی، از صفحات اختصاصی آموزشگاه استفاده کنید.</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                <a href="/courses" class="btn btn-primary">مشاهده دوره‌های موسیقی</a>
                <a href="/instructors" class="btn btn-outline">مشاهده اساتید</a>
                <a href="/locations/shushtar" class="btn btn-outline">آموزش موسیقی در شوشتر</a>
                <a href="/contact" class="btn btn-outline">تماس با آموزشگاه</a>
            </div>
        </section>
    </main>
    <CTA />
    <Footer />
</MainLayout>
