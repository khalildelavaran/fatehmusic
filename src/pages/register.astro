---
/*
====================================================
File: src/pages/register.astro

Purpose:
Registration Wizard entry page.

Flow:
register.astro -> RegistrationFlow.astro -> Steps -> RegistrationController
(the controller is instantiated once, inside RegistrationFlow.astro)
====================================================
*/

import MainLayout from "../layouts/MainLayout.astro";
import RegistrationFlow from "../components/registration/RegistrationFlow.astro";
import "../components/registration/styles/registration.css";
---

<MainLayout
  title="ثبت نام دوره های موسیقی"
  description="ثبت نام آنلاین آموزشگاه موسیقی فاتح"
>
  <main class="registration-page">
    <section class="registration-container">
      <div class="registration-hero">
        <span class="badge">ثبت نام آنلاین</span>
        <h1>شروع مسیر یادگیری موسیقی</h1>
        <p>
          ساز مورد علاقه خود را انتخاب کنید، استاد مناسب را ببینید، زمان کلاس
          را مشخص کنید و ثبت نام خود را کامل نمایید.
        </p>
      </div>

      <RegistrationFlow />
    </section>
  </main>
</MainLayout>
