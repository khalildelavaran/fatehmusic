---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Courses from "../components/Courses.astro";
import Instructors from "../components/Instructors.astro";
import WhyUs from "../components/WhyUs.astro";
import Gallery from "../components/Gallery.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout
  title="آموزشگاه موسیقی فاتح شوشتر | آموزش ساز و آواز"
  description="آموزشگاه موسیقی فاتح در شوشتر؛ آموزش گیتار، پیانو، ویولن، سازهای ایرانی، آواز و دروس پایه موسیقی برای کودکان، نوجوانان و بزرگسالان."
  keywords={[
    "آموزشگاه موسیقی فاتح",
    "آموزش موسیقی شوشتر",
    "کلاس موسیقی شوشتر",
    "آموزش گیتار شوشتر",
    "آموزش پیانو شوشتر",
    "کلاس خوانندگی شوشتر",
    "آموزش آواز شوشتر",
    "خلیل دلاوران"
  ]}
>
  <Header />
  <Hero />
  <Courses />
  <Instructors />
  <WhyUs />
  <Gallery />
  <Testimonials />
  <CTA />
  <Footer />
</MainLayout>