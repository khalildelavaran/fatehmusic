---
export const prerender = true;

import type { ResolvedCourse } from "../../types/courses";
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import InstructorSeoContent from "../../components/InstructorSeoContent.astro";
import FAQSection from "../../components/FAQSection.astro";
import { instructors } from "../../data/instructors";
import { instructorCourseDisplay } from "../../data/instructor-course-display";
import { resolveSite, resolveInstructor, buildPersonSchema, buildProfilePageSchema, buildBreadcrumbSchema, buildFaqSchema, answersFromFaq } from "../../seo/index.js";

export async function getStaticPaths() {
  return instructors.map((teacher) => ({ params: { slug: teacher.slug }, props: { teacher } }));
}

const { teacher } = Astro.props;
const site = resolveSite();
const resolvedInstructor = resolveInstructor(teacher, site);
if (!resolvedInstructor) throw new Error(`Instructor not found: ${teacher.slug}`);

type InstructorSeoContent = {
  quickSummary: string;
  teachingPhilosophy: string[];
  methodBySubject: { subject: string; description: string }[];
  whoShouldStudyWithThem: string[];
  typicalProgression: string[];
  commonStudentMistakes: { mistake: string; fix: string }[];
  whyStudentsChooseThem: string[];
};

const seoContent = resolvedInstructor.seoContent as InstructorSeoContent | null;
const personSchema = buildPersonSchema(resolvedInstructor, { site });
const profilePageSchema = buildProfilePageSchema(resolvedInstructor, { site });
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "خانه", path: "/" },
  { name: "اساتید", path: "/instructors" },
  { name: teacher.name, path: `/instructors/${teacher.slug}` }
], site);
const faqSchema = buildFaqSchema(resolvedInstructor.faqs, {
  site,
  url: `${site.url}/instructors/${teacher.slug}`,
  name: `سوالات متداول درباره ${teacher.name}`
});
const schema: object[] = [profilePageSchema, personSchema, breadcrumbSchema, faqSchema].filter((item): item is object => item !== null);

const teacherCourses: ResolvedCourse[] = resolvedInstructor.courses as ResolvedCourse[];
const linkCandidates = teacherCourses.map((course) => ({
  url: `${site.url}/courses/${course.slug}`,
  title: course.title,
  type: "Course",
  topics: [course.instrument, course.category],
  priority: 30,
  local: true
}));

const answerBlocks = answersFromFaq(
  resolvedInstructor.faqs,
  `${site.url}/instructors/${teacher.slug}`,
  `${site.url}/instructors/${teacher.slug}#person`
);

const auditText = [
  teacher.content.biography,
  ...teacherCourses.map((course) => course.content.description),
  seoContent?.quickSummary || "",
  ...(seoContent?.teachingPhilosophy || []),
  ...(seoContent?.methodBySubject?.map((item) => `${item.subject} ${item.description}`) || []),
  ...(seoContent?.whoShouldStudyWithThem || []),
  ...(seoContent?.typicalProgression || []),
  ...(seoContent?.commonStudentMistakes?.map((item) => `${item.mistake} ${item.fix}`) || []),
  ...(seoContent?.whyStudentsChooseThem || []),
  ...(resolvedInstructor.faqs?.map((item) => `${item.question} ${item.answer}`) || [])
].filter(Boolean).join(" ");
const wordCount = auditText.trim() ? auditText.trim().split(/\s+/).length : 0;
const internalLinkCount = teacherCourses.length + 1;
const courseDisplayMap = instructorCourseDisplay as Record<string, Record<string, string>>;
const courseDisplay = courseDisplayMap[teacher.slug] || {};
const specialty = teacher.position.trim();
const instructorTitle = `${teacher.name} | ${specialty} در شوشتر`;
const instructorDescription = `${teacher.name}، ${specialty} در آموزشگاه موسیقی فاتح شوشتر. آشنایی با تخصص، دوره‌های آموزشی، روش تدریس و مسیر ثبت‌نام.`;
const experience = teacher.professional.experienceYears;
const instagram = String(teacher.social?.instagram || "").replace(/^@/, "").trim();
---

<MainLayout
  title={instructorTitle}
  description={instructorDescription}
  image={teacher.media.images.profile}
  imageWidth={1200}
  imageHeight={1500}
  keywords={teacher.seo.keywords}
  topics={[...teacher.professional.roles, "شوشتر", "آموزش موسیقی"]}
  entityType="Person"
  answerBlocks={answerBlocks}
  linkCandidates={linkCandidates}
  auditContext={{ h1Count: 1, missingImageAlt: 0, wordCount, internalLinkCount }}
  schema={schema}
>
  <Header />

  <main class="instructor-profile">
    <div class="instructor-profile__topline">
      <div class="container">
        <nav class="instructor-profile__breadcrumbs" aria-label="مسیر صفحه">
          <a href="/">خانه</a><span aria-hidden="true">/</span><a href="/instructors">اساتید</a><span aria-hidden="true">/</span><span aria-current="page">{teacher.name}</span>
        </nav>
      </div>
    </div>

    <section class="instructor-profile__hero" aria-labelledby="instructor-name">
      <div class="container">
        <div class="instructor-profile__hero-grid">
          <div class="instructor-profile__portrait-wrap">
            <div class="instructor-profile__portrait-glow" aria-hidden="true"></div>
            <figure class="instructor-profile__portrait">
              <img src={teacher.media.images.profile} alt={`تصویر ${teacher.name}، ${teacher.position} در آموزشگاه موسیقی فاتح شوشتر`} width="1200" height="1500" loading="eager" fetchpriority="high" decoding="async" />
              <figcaption><span class="instructor-profile__portrait-dot"></span> مدرس آموزشگاه موسیقی فاتح</figcaption>
            </figure>
            <div class="instructor-profile__portrait-note"><span aria-hidden="true">♫</span><span>یادگیری موسیقی، قدم‌به‌قدم</span></div>
          </div>

          <div class="instructor-profile__intro">
            <p class="instructor-profile__eyebrow"><span></span> آشنایی با مدرس</p>
            <h1 id="instructor-name">{teacher.name}</h1>
            <p class="instructor-profile__position">{teacher.position}</p>
            <p class="instructor-profile__bio">{teacher.content.biography}</p>

            <div class="instructor-profile__specialties" aria-label="حوزه‌های تدریس">
              {teacher.professional.roles.map((role) => <span>{role}</span>)}
            </div>

            <div class="instructor-profile__stats">
              <div class="instructor-profile__stat">
                <span class="instructor-profile__stat-icon" aria-hidden="true">✦</span>
                <div><strong>{experience ?? "—"}{experience !== null && experience !== undefined ? " سال" : ""}</strong><span>سابقه تدریس</span></div>
              </div>
              <div class="instructor-profile__stat">
                <span class="instructor-profile__stat-icon" aria-hidden="true">♫</span>
                <div><strong>{teacherCourses.length}</strong><span>دوره آموزشی</span></div>
              </div>
              <div class="instructor-profile__stat">
                <span class="instructor-profile__stat-icon" aria-hidden="true">⌖</span>
                <div><strong>شوشتر</strong><span>محل آموزش</span></div>
              </div>
            </div>

            <div class="instructor-profile__actions">
              <a href={`/register?instructor=${teacher.slug}`} class="instructor-profile__button instructor-profile__button--primary">درخواست ثبت‌نام <span aria-hidden="true">←</span></a>
              <a href="#instructor-courses" class="instructor-profile__button instructor-profile__button--secondary">مشاهده کلاس‌ها</a>
              {instagram && <a href={`https://www.instagram.com/${instagram}/`} target="_blank" rel="noopener noreferrer" class="instructor-profile__social" aria-label={`صفحه اینستاگرام ${teacher.name}`}>اینستاگرام ↗</a>}
            </div>
          </div>
        </div>
      </div>
      <div class="instructor-profile__hero-orb instructor-profile__hero-orb--one" aria-hidden="true"></div>
      <div class="instructor-profile__hero-orb instructor-profile__hero-orb--two" aria-hidden="true"></div>
    </section>

    <section class="instructor-profile__courses" id="instructor-courses">
      <div class="container">
        <div class="instructor-profile__section-heading">
          <div><p class="instructor-profile__eyebrow"><span></span> مسیر یادگیری شما</p><h2>کلاس‌های {teacher.name}</h2></div>
          <p>برای آشنایی با محتوای هر کلاس و انتخاب مسیر مناسب، دوره‌ها را بررسی کنید.</p>
        </div>

        {teacherCourses.length > 0 ? (
          <div class="instructor-profile__course-grid">
            {teacherCourses.map((course: ResolvedCourse) => (
              <a href={`/courses/${course.slug}`} class="instructor-profile__course-card">
                <div class="instructor-profile__course-image">
                  <img src={course.media.image} alt={course.title} width="800" height="450" loading="lazy" decoding="async" />
                  <span aria-hidden="true">↗</span>
                </div>
                <div class="instructor-profile__course-content">
                  <span class="instructor-profile__course-label">دوره آموزشی</span>
                  <h3>{course.title}</h3>
                  <p>{courseDisplay[course.slug] || course.content.excerpt}</p>
                  <span class="instructor-profile__course-link">جزئیات کلاس <span aria-hidden="true">←</span></span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="instructor-profile__empty"><span aria-hidden="true">♫</span><p>در حال حاضر دوره‌ای برای این مدرس ثبت نشده است.</p></div>
        )}
      </div>
    </section>

    <section class="instructor-profile__about" id="about-instructor">
      <div class="container">
        <div class="instructor-profile__about-card">
          <div class="instructor-profile__about-mark" aria-hidden="true">“</div>
          <div class="instructor-profile__about-copy">
            <p class="instructor-profile__eyebrow"><span></span> درباره مدرس</p>
            <h2>آشنایی بیشتر با {teacher.name}</h2>
            <p>{teacher.content.biography}</p>
          </div>
          <div class="instructor-profile__credentials">
            <div><span>حوزه تخصص</span><strong>{teacher.position}</strong></div>
            <div><span>تحصیلات</span><strong>{teacher.professional.education || "اطلاعات ثبت نشده"}</strong></div>
            <div><span>سابقه تدریس</span><strong>{experience !== null && experience !== undefined ? `${experience} سال` : "اطلاعات ثبت نشده"}</strong></div>
          </div>
        </div>
      </div>
    </section>

    <InstructorSeoContent instructorName={teacher.name} seoContent={seoContent} />
    <FAQSection title={`سوالات متداول درباره ${teacher.name}`} subtitle="پاسخ پرسش‌هایی که هنرجویان معمولاً پیش از ثبت‌نام می‌پرسند." items={resolvedInstructor.faqs} />
  </main>

  <CTA />
  <Footer />
</MainLayout>

<style>
  .instructor-profile{--ip-gold:#d8b66a;--ip-gold-light:#f4df9f;--ip-ink:#11110f;--ip-muted:#a8a7a1;overflow:hidden;background:#10100f;color:#f7f4ed}
  .instructor-profile .container{width:min(1160px,92%)}
  .instructor-profile__topline{position:relative;z-index:2;padding-top:92px;border-bottom:1px solid rgba(255,255,255,.07);background:#10100f}
  .instructor-profile__breadcrumbs{display:flex;align-items:center;gap:12px;min-height:40px;color:#92918b;font-size:.83rem}
  .instructor-profile__breadcrumbs a{transition:color .2s}
  .instructor-profile__breadcrumbs a:hover{color:var(--ip-gold-light)}
  .instructor-profile__breadcrumbs span[aria-current]{color:#e7dfcb}
  .instructor-profile__hero{position:relative;isolation:isolate;padding:clamp(18px,2.5vw,32px) 0 clamp(22px,3vw,38px);background:radial-gradient(ellipse at 78% 42%,rgba(173,132,49,.12),transparent 43%),linear-gradient(135deg,#171713 0%,#10100f 58%,#17150f 100%)}
  .instructor-profile__hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.18fr);align-items:center;gap:clamp(18px,2.5vw,32px)}
  .instructor-profile__portrait-wrap{position:relative;width:min(100%,340px);justify-self:center}
  .instructor-profile__portrait-glow{position:absolute;inset:10% -7% -5% 7%;border:1px solid rgba(216,182,106,.42);border-radius:48% 48% 24px 24px;transform:rotate(-5deg)}
  .instructor-profile__portrait{position:relative;margin:0;overflow:hidden;aspect-ratio:4/5;border:1px solid rgba(244,223,159,.42);border-radius:48% 48% 18px 18px;background:#25231c;box-shadow:0 28px 80px rgba(0,0,0,.38)}
  .instructor-profile__portrait::after{position:absolute;inset:35% 0 0;content:"";background:linear-gradient(180deg,transparent 0%,rgba(8,8,7,.78) 100%);pointer-events:none}
  .instructor-profile__portrait img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}
  .instructor-profile__portrait figcaption{position:absolute;z-index:1;right:20px;bottom:20px;left:20px;display:flex;align-items:center;gap:9px;color:#fff;font-size:.88rem}
  .instructor-profile__portrait-dot{width:8px;height:8px;border-radius:50%;background:var(--ip-gold-light);box-shadow:0 0 12px rgba(244,223,159,.8)}
  .instructor-profile__portrait-note{position:absolute;z-index:2;left:-22px;bottom:12%;display:flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid rgba(244,223,159,.24);border-radius:12px;background:rgba(25,24,20,.92);box-shadow:0 14px 35px rgba(0,0,0,.28);color:#e8dfc9;font-size:.78rem;backdrop-filter:blur(12px)}
  .instructor-profile__portrait-note span:first-child{color:var(--ip-gold-light);font-size:1.4rem}
  .instructor-profile__intro{max-width:660px}
  .instructor-profile__eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 6px;color:var(--ip-gold-light);font-size:.82rem;font-weight:700;letter-spacing:.02em}
  .instructor-profile__eyebrow span{display:inline-block;width:28px;height:1px;background:var(--ip-gold)}
  .instructor-profile__intro h1{margin:0;color:#fff;font-size:clamp(2.3rem,5vw,4.5rem);font-weight:850;line-height:1.25;letter-spacing:-.04em}
  .instructor-profile__position{margin:7px 0 0;color:var(--ip-gold-light);font-size:clamp(1rem,1.7vw,1.28rem);font-weight:600}
  .instructor-profile__bio{max-width:600px;margin:9px 0 0;color:#c1bfb6;font-size:.94rem;line-height:1.9}
  .instructor-profile__specialties{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
  .instructor-profile__specialties span{padding:5px 10px;border:1px solid rgba(216,182,106,.25);border-radius:999px;background:rgba(216,182,106,.07);color:#e8dfc9;font-size:.8rem}
  .instructor-profile__stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.1)}
  .instructor-profile__stat{display:flex;align-items:center;gap:11px;min-width:0}
  .instructor-profile__stat-icon{display:grid;flex:0 0 38px;width:38px;height:38px;place-items:center;border:1px solid rgba(216,182,106,.28);border-radius:12px;color:var(--ip-gold-light);font-size:1.1rem}
  .instructor-profile__stat div{display:flex;flex-direction:column;min-width:0}
  .instructor-profile__stat strong{color:#fff;font-size:1.05rem;line-height:1.5}
  .instructor-profile__stat div span{color:#99978e;font-size:.72rem}
  .instructor-profile__actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:13px}
  .instructor-profile__button{display:inline-flex;min-height:44px;align-items:center;justify-content:center;gap:15px;padding:0 16px;border:1px solid transparent;border-radius:10px;font-size:.88rem;font-weight:750;transition:transform .2s,background .2s,border-color .2s}
  .instructor-profile__button:hover{transform:translateY(-2px)}
  .instructor-profile__button--primary{background:linear-gradient(135deg,#f0d993,#c6a04a);color:#17140c;box-shadow:0 8px 24px rgba(216,182,106,.13)}
  .instructor-profile__button--primary:hover{background:#f8e8b6}
  .instructor-profile__button--secondary{border-color:rgba(255,255,255,.2);color:#f3efe5;background:rgba(255,255,255,.025)}
  .instructor-profile__button--secondary:hover{border-color:var(--ip-gold);background:rgba(216,182,106,.08)}
  .instructor-profile__social{padding:10px 3px;color:#c9c5b9;font-size:.83rem}
  .instructor-profile__social:hover{color:var(--ip-gold-light)}
  .instructor-profile__hero-orb{position:absolute;z-index:-1;border:1px solid rgba(216,182,106,.1);border-radius:50%;pointer-events:none}
  .instructor-profile__hero-orb--one{top:8%;right:-170px;width:390px;height:390px}
  .instructor-profile__hero-orb--two{right:-120px;top:14%;width:290px;height:290px}
  .instructor-profile__courses{padding:10px 0;background:#f6f4ef;color:#191914}
  .instructor-profile__section-heading{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:14px}
  .instructor-profile__section-heading .instructor-profile__eyebrow{margin-bottom:9px;color:#92712f}
  .instructor-profile__section-heading h2,.instructor-profile__about-copy h2{margin:0;font-size:clamp(1.7rem,3.2vw,2.65rem);font-weight:850;line-height:1.5}
  .instructor-profile__section-heading>p{max-width:400px;margin:0;color:#747168;font-size:.92rem;line-height:2}
  .instructor-profile__course-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
  .instructor-profile__course-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid #e7e2d6;border-radius:13px;background:#fff;color:#191914;box-shadow:0 6px 22px rgba(32,27,17,.035);transition:transform .25s,box-shadow .25s,border-color .25s}
  .instructor-profile__course-card:hover{transform:translateY(-5px);border-color:#d8bd7c;box-shadow:0 18px 38px rgba(32,27,17,.1)}
  .instructor-profile__course-image{position:relative;overflow:hidden;aspect-ratio:16/9;background:#e7e1d4}
  .instructor-profile__course-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s}
  .instructor-profile__course-card:hover .instructor-profile__course-image img{transform:scale(1.045)}
  .instructor-profile__course-image>span{position:absolute;top:12px;left:12px;display:grid;width:34px;height:34px;place-items:center;border:1px solid rgba(255,255,255,.5);border-radius:50%;background:rgba(20,19,15,.72);color:#fff;font-size:1rem}
  .instructor-profile__course-content{display:flex;flex:1;flex-direction:column;align-items:flex-start;padding:12px}
  .instructor-profile__course-label{color:#98772f;font-size:.74rem;font-weight:750}
  .instructor-profile__course-content h3{margin:4px 0 5px;font-size:1.02rem;line-height:1.5}
  .instructor-profile__course-content p{margin:0;color:#77746b;font-size:.8rem;line-height:1.75}
  .instructor-profile__course-link{display:flex;align-items:center;gap:9px;margin-top:auto;padding-top:13px;color:#8b6928;font-size:.84rem;font-weight:800}
  .instructor-profile__empty{padding:32px;border:1px dashed #d6cebd;border-radius:14px;text-align:center;color:#77746b}
  .instructor-profile__empty>span{color:#b28c3e;font-size:1.8rem}
  .instructor-profile__about{padding:10px 0;background:#eae6dc;color:#191914}
  .instructor-profile__about-card{position:relative;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:clamp(14px,2vw,24px);padding:clamp(15px,2vw,24px);overflow:hidden;border:1px solid #ddd5c4;border-radius:22px;background:rgba(255,255,255,.58)}
  .instructor-profile__about-mark{position:absolute;top:-48px;right:18px;color:rgba(176,139,59,.12);font-family:Georgia,serif;font-size:15rem;line-height:1;pointer-events:none}
  .instructor-profile__about-copy{position:relative;z-index:1}
  .instructor-profile__about-copy .instructor-profile__eyebrow{color:#92712f}
  .instructor-profile__about-copy>p:last-child{max-width:660px;margin:12px 0 0;color:#625f56;line-height:1.95}
  .instructor-profile__credentials{display:flex;flex-direction:column;justify-content:center;gap:0;border-right:1px solid #ded6c5;padding-right:clamp(20px,3vw,42px)}
  .instructor-profile__credentials div{display:flex;flex-direction:column;gap:4px;padding:6px 0;border-bottom:1px solid #e4ddcf}
  .instructor-profile__credentials div:last-child{border-bottom:0}
  .instructor-profile__credentials span{color:#898478;font-size:.78rem}
