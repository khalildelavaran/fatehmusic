---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Gallery from "../components/Gallery.astro";
import CTA from "../components/CTA.astro";
---

<MainLayout
    title="گالری آموزشگاه موسیقی فاتح | تصاویر کلاس‌ها و هنرجویان"
    description="گالری تصاویر آموزشگاه موسیقی فاتح شوشتر؛ تصاویر کلاس‌های گیتار، پیانو، ویولون، موسیقی کودک، اجراهای هنرجویان و فضای آموزشگاه."
>

    <Header />
	
    <PageHero
        badge="گالری"
        title="گالری آموزشگاه موسیقی فاتح شوشتر"
        description="تصاویری از فضای آموزشگاه، کلاس‌های موسیقی، تمرین هنرجویان و فعالیت‌های آموزشی آموزشگاه موسیقی فاتح در شوشتر."
    />

    <Gallery />

    <CTA />

    <Footer />

</MainLayout>
