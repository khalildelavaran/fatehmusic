---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Gallery from "../components/Gallery.astro";
import CTA from "../components/CTA.astro";
import { resolveSite } from "../seo/index.js";
import { galleryItems } from "../data/gallery.js";
import { buildImageGallerySchema } from "../seo/schema/image-gallery.js";

const site = resolveSite();
const galleryUrl = `${site.url}/gallery`;
const imageGallerySchema = buildImageGallerySchema({
    site,
    url: galleryUrl,
    name: "گالری عکس آموزشگاه موسیقی فاتح شوشتر",
    description: "گالری عکس کلاس موسیقی و فضای آموزشگاه موسیقی فاتح شوشتر؛ تصاویر کلاس‌های گیتار، پیانو، ویولون، موسیقی کودک، اجراهای هنرجویان و فعالیت‌های آموزشی.",
    items: galleryItems
}) ?? [];
---

<MainLayout
    title="عکس کلاس موسیقی شوشتر | گالری آموزشگاه موسیقی فاتح"
    description="عکس کلاس موسیقی و فضای آموزشگاه موسیقی فاتح شوشتر؛ تصاویر کلاس‌های گیتار، پیانو، ویولن، موسیقی کودک، اجراهای هنرجویان و فعالیت‌های آموزشی."
    image={galleryItems[0]?.image}
    imageWidth={800}
    imageHeight={450}
    imageType="image/webp"
    keywords={["عکس کلاس موسیقی", "عکس آموزشگاه موسیقی شوشتر", "گالری آموزشگاه موسیقی فاتح", "کلاس موسیقی شوشتر"]}
    topics={["shushtar", "music-education", "gallery"]}
    entityType="ImageGallery"
    auditContext={{ h1Count: 1, missingImageAlt: 0, internalLinkCount: 4 }}
    schema={imageGallerySchema}
>
    <Header />

    <PageHero
        badge="گالری"
        title="عکس کلاس موسیقی و آموزشگاه موسیقی فاتح شوشتر"
        description="تصاویری از فضای آموزشگاه، کلاس‌های موسیقی، تمرین هنرجویان و فعالیت‌های آموزشی آموزشگاه موسیقی فاتح در شوشتر."
    />

    <main>
        <section class="container" style="padding: 24px 0 10px;">
            <h2>عکس کلاس‌های موسیقی در آموزشگاه فاتح</h2>
            <p>در این گالری می‌توانید نمونه‌هایی از فضای آموزشگاه، کلاس‌ها، تمرین هنرجویان و فعالیت‌های موسیقی را ببینید. برای آشنایی با دوره‌ها و اساتید نیز از صفحات اختصاصی سایت استفاده کنید.</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                <a href="/courses" class="btn btn-primary">مشاهده دوره‌های موسیقی</a>
                <a href="/instructors" class="btn btn-outline">مشاهده اساتید</a>
                <a href="/locations/shushtar" class="btn btn-outline">آموزش موسیقی در شوشتر</a>
                <a href="/register" class="btn btn-outline">ثبت‌نام</a>
            </div>
        </section>

        <Gallery />
    </main>

    <CTA />
    <Footer />
</MainLayout>
