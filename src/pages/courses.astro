---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Courses from "../components/Courses.astro";
import CTA from "../components/CTA.astro";
import PageHero from "../components/PageHero.astro";
import { courses } from "../data/courses";
import { resolveSite, buildItemListSchema } from "../seo/index.js";
import { courseEntityId } from "../seo/geo/entity.js";

const site = resolveSite();
const canonical = `${site.url}/courses`;
const activeCourses = courses.filter((course) => course.active !== false);

const courseListSchema = buildItemListSchema({
    name: "دوره‌های آموزش موسیقی آموزشگاه موسیقی فاتح",
    url: canonical,
    itemType: "Course",
    items: activeCourses.map((course) => ({
        name: course.title,
        url: `${site.url}/courses/${course.slug}`,
        id: courseEntityId(`${site.url}/courses/${course.slug}`),
        description: course.content?.description || course.content?.excerpt || undefined,
        provider: { "@id": `${site.url}/#organization` }
    }))
});
---

<MainLayout
    title="دوره‌های آموزش موسیقی در شوشتر | آموزشگاه موسیقی فاتح"
    description="فهرست دوره‌های آموزش موسیقی در شوشتر؛ گیتار، پیانو، ویولن، سازهای ایرانی، آواز، موسیقی کودک، سلفژ، تئوری موسیقی و ریتم."
    canonical={canonical}
    keywords={["دوره‌های آموزش موسیقی شوشتر", "کلاس موسیقی شوشتر", "آموزش ساز در شوشتر", "کلاس آواز شوشتر"]}
    topics={["shushtar", "music-education", "courses"]}
    entityType="ItemList"
    auditContext={{ h1Count: 1, missingImageAlt: 0, internalLinkCount: activeCourses.length }}
    schema={courseListSchema ? [courseListSchema] : []}
>
    <Header />
    <PageHero
        badge="دوره‌های موسیقی"
        title="دوره‌های آموزش موسیقی در شوشتر"
        description="معرفی دوره‌های تخصصی ساز، آواز، موسیقی کودک و دروس پایه موسیقی در آموزشگاه موسیقی فاتح شوشتر."
    />
    <main>
        <section class="container" style="padding: 36px 0 10px;">
            <p>برای انتخاب مسیر آموزشی، دوره موردنظر را بر اساس ساز، سبک یا هدف خود بررسی کنید. هر دوره صفحه اختصاصی شامل سطح، مدرس، محتوای آموزشی و اطلاعات ثبت‌نام دارد. برای آشنایی با محل آموزش نیز می‌توانید صفحه <a href="/locations/shushtar">آموزش موسیقی در شوشتر</a> را ببینید.</p>
        </section>
        <Courses />
    </main>
    <CTA />
    <Footer />
</MainLayout>
