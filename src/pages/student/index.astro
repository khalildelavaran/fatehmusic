---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import { getStudentSession, type StudentEnv } from "../../server/student-auth";
import "../../styles/student.css";
const session=await getStudentSession(Astro.request,env as StudentEnv);
if(!session)return Astro.redirect('/student/login');
---
<MainLayout title="داشبورد هنرجو | آموزشگاه موسیقی فاتح" noindex={true}>
<main class="student-dashboard" dir="rtl">
<aside class="student-sidebar">
  <div class="student-sidebar-brand"><img src="/logo.webp" alt="آموزشگاه موسیقی فاتح"/><strong>آموزشگاه موسیقی فاتح</strong></div>
  <nav aria-label="ناوبری داشبورد هنرجو">
    <a href="#courses">دوره‌های من</a>
    <a href="#evaluations">ارزیابی‌ها</a>
    <a href="#makeup">جلسات جبرانی</a>
    <a href="#notifications">اعلان‌ها</a>
    <a href="#contracts">قراردادها</a>
    <a href="#certificates">گواهینامه‌ها</a>
    <a href="#account">حساب کاربری</a>
  </nav>
  <button class="student-logout" id="logoutButton" type="button">خروج از حساب</button>
</aside>
<section class="student-main">
<header class="student-top"><div><img src="/logo.webp" alt="فاتح"/><div><strong>داشبورد هنرجو</strong><span>کد ملی: {session.nationalCode}</span></div></div></header>
<div id="studentApp"><p class="student-loading">در حال بارگذاری اطلاعات...</p></div>
</section>
</main>
<script>
const app=document.querySelector('#studentApp');
const esc=(v: any)=>String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const contractForm=(id: any,label='PDF قرارداد')=>`<a class="gold-action" href="/api/admin/contract-generate?registration_id=${encodeURIComponent(Number(id))}" target="_blank" rel="noopener">${label}</a>`;

const MAKEUP_STATUS_LABELS: Record<string,string>={pending:'در انتظار بررسی',approved:'تأیید‌شده',rejected:'رد‌شده',scheduled:'زمان‌بندی‌شده',completed:'برگزارشده'};

async function api(path: string,options?: RequestInit): Promise<any>{const r=await fetch(path,{credentials:'same-origin',...(options||{})});if(r.status===401){location.href='/student/login';throw new Error('unauthorized')}return r.json()}

function enrollmentPicker(enrollments: any[],selectId: string){
  if(!enrollments.length)return '<p class="student-empty">ثبت‌نام فعالی در سامانه جدید یافت نشد.</p>';
  return `<label>انتخاب کلاس<select id="${selectId}">${enrollments.map((e: any)=>`<option value="${e.enrollmentId}">${esc(e.classTitle)} — ${esc(e.instructorName)}</option>`).join('')}</select></label>`;
}

async function loadEvaluations(enrollments: any[]){
  const box=document.querySelector('#evaluationsBody');
  if(!box)return;
  if(!enrollments.length){box.innerHTML='<p class="student-empty">ثبت‌نام فعالی یافت نشد.</p>';return}
  const enrollmentId=(document.querySelector('#evaluationsEnrollmentSelect') as HTMLSelectElement | null)?.value||enrollments[0].enrollmentId;
  const d:any=await api(`/api/student/evaluations?enrollmentId=${encodeURIComponent(enrollmentId)}`);
  if(!d.success){box.innerHTML=`<p class="student-empty">${esc(d.message)}</p>`;return}
  box.innerHTML=d.evaluations.length?d.evaluations.map((e:any)=>`<article class="student-item"><div class="student-item-icon">★</div><h3>نمره کلی: ${esc(e.overall)}</h3><p>فن‌آوری: ${e.technique??'-'} · ریتم: ${e.rhythm??'-'} · تئوری: ${e.theory??'-'} · اجرا: ${e.performance??'-'} · انضباط: ${e.discipline??'-'}</p>${e.comment?`<p>${esc(e.comment)}</p>`:''}</article>`).join(''):'<p class="student-empty">هنوز ارزیابی‌ای برای شما ثبت نشده است.</p>';
}

async function loadMakeup(enrollments: any[]){
  const box=document.querySelector('#makeupBody');
  if(!box)return;
  if(!enrollments.length){box.innerHTML='<p class="student-empty">ثبت‌نام فعالی یافت نشد.</p>';return}
  const enrollmentId=(document.querySelector('#makeupEnrollmentSelect') as HTMLSelectElement | null)?.value||enrollments[0].enrollmentId;
  const d:any=await api(`/api/student/makeup-requests?enrollmentId=${encodeURIComponent(enrollmentId)}`);
  if(!d.success){box.innerHTML=`<p class="student-empty">${esc(d.message)}</p>`;return}
  const requestable=(d.requestableAbsences||[]).map((a:any)=>`<article class="student-item"><div class="student-item-icon">↻</div><h3>${esc(a.classTitle)}</h3><p>تاریخ غیبت: ${esc(a.sessionDate)} ساعت ${esc(a.startTime)}</p><div class="student-actions"><button data-request-makeup="${a.enrollmentSessionId}" data-enrollment-id="${enrollmentId}">درخواست جلسه جبرانی</button></div></article>`).join('');
  const requests=(d.requests||[]).map((r:any)=>`<article class="student-item"><div class="student-item-icon">↺</div><h3>وضعیت: ${esc(MAKEUP_STATUS_LABELS[r.status]||r.status)}</h3>${r.reason?`<p>دلیل: ${esc(r.reason)}</p>`:''}${r.reviewNote?`<p>یادداشت بررسی: ${esc(r.reviewNote)}</p>`:''}</article>`).join('');
  box.innerHTML=`${requestable||'<p class="student-empty">غیبت موجهی برای درخواست جلسه جبرانی یافت نشد.</p>'}${requests}`;
}

async function loadNotifications(){
  const box=document.querySelector('#notificationsBody');
  if(!box)return;
  const d:any=await api('/api/student/notifications');
  if(!d.success){box.innerHTML=`<p class="student-empty">${esc(d.message)}</p>`;return}
  box.innerHTML=d.notifications.length?d.notifications.map((n:any)=>`<article class="student-item${n.readAt?'':' is-unread'}"><div class="student-item-icon">🔔</div><h3>${esc(n.title)}</h3>${n.body?`<p>${esc(n.body)}</p>`:''}${!n.readAt?`<div class="student-actions"><button data-mark-read="${n.id}">علامت‌گذاری به‌عنوان خوانده‌شده</button></div>`:''}</article>`).join(''):'<p class="student-empty">اعلانی برای شما ثبت نشده است.</p>';
}

async function load(){
  const r=await fetch('/api/student/me',{credentials:'same-origin'});
  if(r.status===401){location.href='/student/login';return}
  const d:any=await r.json();
  if(!d.success){(app as HTMLElement).innerHTML=`<p>${esc(d.message)}</p>`;return}

  const enrollmentsResp:any=await api('/api/student/enrollments').catch(()=>({success:false,enrollments:[]}));
  const enrollments:any[]=enrollmentsResp.success?enrollmentsResp.enrollments.filter((e:any)=>e.status==='active'):[];

  (app as HTMLElement).innerHTML=`${d.must_change_password?`<section class="student-alert"><strong>توجه:</strong> رمز اولیه شما کد ملی است. برای امنیت حساب، رمز دلخواه خود را تعیین کنید.</section>`:''}<section id="courses" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">آموزش</span><h2>دوره‌های من</h2></div></div><div class="student-grid">${d.registrations.length?d.registrations.map((x:any)=>`<article class="student-item"><div class="student-item-icon">♪</div><h3>${esc(x.instrument_title)}</h3><p>مدرس: ${esc(x.instructor_name)}</p><p>زمان: ${esc(x.schedule_weekday)}${x.schedule_duration?` · ${esc(x.schedule_duration)} دقیقه`:''}</p><div class="student-actions">${contractForm(x.id,'دریافت PDF قرارداد')}</div></article>`).join(''):'<p class="student-empty">دوره‌ای برای این کد ملی ثبت نشده است.</p>'}</div></section><section id="evaluations" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">پیشرفت</span><h2>ارزیابی‌ها</h2></div></div>${enrollmentPicker(enrollments,'evaluationsEnrollmentSelect')}<div class="student-grid" id="evaluationsBody"><p class="student-loading">در حال بارگذاری...</p></div></section><section id="makeup" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">حضور</span><h2>جلسات جبرانی</h2></div></div>${enrollmentPicker(enrollments,'makeupEnrollmentSelect')}<div class="student-grid" id="makeupBody"><p class="student-loading">در حال بارگذاری...</p></div></section><section id="notifications" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">اطلاع‌رسانی</span><h2>اعلان‌ها</h2></div></div><div class="student-grid" id="notificationsBody"><p class="student-loading">در حال بارگذاری...</p></div></section><section id="contracts" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">مدارک</span><h2>قراردادها</h2></div></div><div class="student-grid">${d.registrations.length?d.registrations.map((x:any)=>`<article class="student-item"><div class="student-item-icon">▤</div><h3>${esc(x.instrument_title)}</h3><p>مدرس: ${esc(x.instructor_name)}</p>${contractForm(x.id,'دریافت PDF قرارداد')}</article>`).join(''):'<p class="student-empty">قراردادی برای شما ثبت نشده است.</p>'}</div></section><section id="certificates" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">مدارک</span><h2>گواهینامه‌های صادرشده</h2></div></div><div class="student-grid">${d.certificates.length?d.certificates.map((x:any)=>`<article class="student-item certificate-item"><div class="student-item-icon">✓</div><h3>گواهی پایان دوره</h3><p>شماره گواهی: ${esc(x.cert_number)}</p><p>تاریخ صدور: ${esc(x.completion_date_jalali)}</p><div class="student-actions"><a class="gold-action" href="/api/student/certificate?id=${encodeURIComponent(x.id)}" target="_blank" rel="noopener">PDF گواهینامه</a></div></article>`).join(''):'<p class="student-empty">هنوز گواهینامه‌ای برای شما صادر نشده است.</p>'}</div></section><section id="account" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">حساب کاربری</span><h2>تغییر رمز عبور</h2></div></div><form id="passwordForm" class="student-password"><input id="newPassword" type="password" minlength="6" placeholder="رمز جدید، حداقل ۶ کاراکتر" required/><input id="repeatPassword" type="password" minlength="6" placeholder="تکرار رمز جدید" required/><button>ذخیره رمز جدید</button><p id="passwordStatus" class="student-status"></p></form></section>`;

  await Promise.all([loadEvaluations(enrollments),loadMakeup(enrollments),loadNotifications()]);

  document.querySelector('#evaluationsEnrollmentSelect')?.addEventListener('change',()=>loadEvaluations(enrollments));
  document.querySelector('#makeupEnrollmentSelect')?.addEventListener('change',()=>loadMakeup(enrollments));

  (app as HTMLElement).addEventListener('click',async (e: Event)=>{
    const t=e.target;
    if(!(t instanceof HTMLElement))return;
    if(t.dataset.requestMakeup){
      const reason=prompt('دلیل درخواست جلسه جبرانی (اختیاری):')||'';
      const d:any=await api('/api/student/makeup-requests',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enrollmentId:Number(t.dataset.enrollmentId),originalEnrollmentSessionId:Number(t.dataset.requestMakeup),reason})});
      if(!d.success)alert(d.message||'ثبت درخواست انجام نشد.');
      await loadMakeup(enrollments);
      return;
    }
    if(t.dataset.markRead){
      await api('/api/student/notifications',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Number(t.dataset.markRead)})});
      await loadNotifications();
      return;
    }
  });
}
app?.addEventListener('submit',async e=>{if(e.target.id!=='passwordForm')return;e.preventDefault();const status=document.querySelector('#passwordStatus');const p=document.querySelector('#newPassword').value;if(p!==document.querySelector('#repeatPassword').value){status.textContent='تکرار رمز یکسان نیست.';return}const r=await fetch('/api/student/password',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({new_password:p})});const d=await r.json();status.textContent=d.message||'انجام شد.';if(r.ok)document.querySelector('#passwordForm').reset()});
async function logout(){await fetch('/api/student/logout',{method:'POST',credentials:'same-origin'});location.href='/student/login'}
document.querySelector('#logoutButton')?.addEventListener('click',logout);load();
</script>
</MainLayout>
