---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import { getStudentSession, type StudentEnv } from "../../server/student-auth";
import "../../styles/student.css";
const session=await getStudentSession(Astro.request,env as StudentEnv);
if(!session)return Astro.redirect('/student/login');
---
<MainLayout title="داشبورد هنرجو | آموزشگاه موسیقی فاتح" noindex={true}>
<main class="student-dashboard" dir="rtl">
<aside class="student-sidebar">
  <div class="student-sidebar-brand"><img src="/logo.webp" alt="آموزشگاه موسیقی فاتح"/><strong>آموزشگاه موسیقی فاتح</strong></div>
  <nav aria-label="ناوبری داشبورد هنرجو">
    <a href="#courses">دوره‌های من</a>
    <a href="#contracts">قراردادها</a>
    <a href="#certificates">گواهینامه‌ها</a>
    <a href="#account">حساب کاربری</a>
  </nav>
  <button class="student-logout" id="logoutButton" type="button">خروج از حساب</button>
</aside>
<section class="student-main">
<header class="student-top"><div><img src="/logo.webp" alt="فاتح"/><div><strong>داشبورد هنرجو</strong><span>کد ملی: {session.nationalCode}</span></div></div></header>
<div id="studentApp"><p class="student-loading">در حال بارگذاری اطلاعات...</p></div>
</section>
</main>
<script>
const app=document.querySelector('#studentApp');
const esc=(v)=>String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const contractForm=(id,label='PDF قرارداد')=>`<form class="contract-pdf-form" action="/api/admin/contract-generate" method="post" target="_blank"><input type="hidden" name="registration_id" value="${Number(id)}"><button type="submit" class="gold-action">${label}</button></form>`;
async function load(){const r=await fetch('/api/student/me',{credentials:'same-origin'});if(r.status===401){location.href='/student/login';return}const d=await r.json();if(!d.success){app.innerHTML=`<p>${esc(d.message)}</p>`;return}app.innerHTML=`${d.must_change_password?`<section class="student-alert"><strong>توجه:</strong> رمز اولیه شما کد ملی است. برای امنیت حساب، رمز دلخواه خود را تعیین کنید.</section>`:''}<section id="courses" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">آموزش</span><h2>دوره‌های من</h2></div></div><div class="student-grid">${d.registrations.length?d.registrations.map(x=>`<article class="student-item"><div class="student-item-icon">♪</div><h3>${esc(x.instrument_title)}</h3><p>مدرس: ${esc(x.instructor_name)}</p><p>زمان: ${esc(x.schedule_weekday)}${x.schedule_duration?` · ${esc(x.schedule_duration)} دقیقه`:''}</p><div class="student-actions">${contractForm(x.id,'دریافت PDF قرارداد')}</div></article>`).join(''):'<p class="student-empty">دوره‌ای برای این کد ملی ثبت نشده است.</p>'}</div></section><section id="contracts" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">مدارک</span><h2>قراردادها</h2></div></div><div class="student-grid">${d.registrations.length?d.registrations.map(x=>`<article class="student-item"><div class="student-item-icon">▤</div><h3>${esc(x.instrument_title)}</h3><p>مدرس: ${esc(x.instructor_name)}</p>${contractForm(x.id,'دریافت PDF قرارداد')}</article>`).join(''):'<p class="student-empty">قراردادی برای شما ثبت نشده است.</p>'}</div></section><section id="certificates" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">مدارک</span><h2>گواهینامه‌های صادرشده</h2></div></div><div class="student-grid">${d.certificates.length?d.certificates.map(x=>`<article class="student-item certificate-item"><div class="student-item-icon">✓</div><h3>گواهی پایان دوره</h3><p>شماره گواهی: ${esc(x.cert_number)}</p><p>تاریخ صدور: ${esc(x.completion_date_jalali)}</p><div class="student-actions"><a class="gold-action" href="/api/student/certificate?id=${encodeURIComponent(x.id)}" target="_blank" rel="noopener">PDF گواهینامه</a></div></article>`).join(''):'<p class="student-empty">هنوز گواهینامه‌ای برای شما صادر نشده است.</p>'}</div></section><section id="account" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">حساب کاربری</span><h2>تغییر رمز عبور</h2></div></div><form id="passwordForm" class="student-password"><input id="newPassword" type="password" minlength="6" placeholder="رمز جدید، حداقل ۶ کاراکتر" required/><input id="repeatPassword" type="password" minlength="6" placeholder="تکرار رمز جدید" required/><button>ذخیره رمز جدید</button><p id="passwordStatus" class="student-status"></p></form></section>`;}
app?.addEventListener('submit',async e=>{if(e.target.id!=='passwordForm')return;e.preventDefault();const status=document.querySelector('#passwordStatus');const p=document.querySelector('#newPassword').value;if(p!==document.querySelector('#repeatPassword').value){status.textContent='تکرار رمز یکسان نیست.';return}const r=await fetch('/api/student/password',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({new_password:p})});const d=await r.json();status.textContent=d.message||'انجام شد.';if(r.ok)document.querySelector('#passwordForm').reset()});
async function logout(){await fetch('/api/student/logout',{method:'POST',credentials:'same-origin'});location.href='/student/login'}
document.querySelector('#logoutButton')?.addEventListener('click',logout);load();
</script>
</MainLayout>
