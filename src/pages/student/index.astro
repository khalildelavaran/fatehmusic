size:13px}.gold-action{cursor:pointer}.student-refresh-action{border:1px solid #b18a36;border-radius:10px;padding:8px 16px;background:#17130b;color:#e0bd68;cursor:pointer;font:inherit;font-size:13px;white-space:nowrap;transition:.2s}.student-refresh-action:hover{background:#b18a36;color:#0b0b0b}.student-grid .finance-term{min-width:0}@media(max-width:700px){.finance-stats{grid-template-columns:1fr 1fr}.finance-term-head{flex-direction:column}.finance-session-row{grid-template-columns:1fr auto}.finance-session-row .leave-button{grid-column:1/-1;width:100%}}@media(max-width:480px){.finance-stats{grid-template-columns:1fr}.payment-history-row{grid-template-columns:1fr 1fr}.payment-history-row b{grid-column:1/-1}}
