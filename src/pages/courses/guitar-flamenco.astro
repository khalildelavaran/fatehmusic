---
import GuitarStyleLanding from "../../components/GuitarStyleLanding.astro";
import { guitarStylePages } from "../../data/guitar-style-content.js";
import { resolveSite, resolveCourse, resolveInstructor, buildCourseSchema, buildPersonSchema, buildBreadcrumbSchema, buildGuitarStyleSchema } from "../../seo/index.js";

const site = resolveSite();
const baseStyle = guitarStylePages["guitar-flamenco"];
const parentCourse = resolveCourse("guitar-course", site);
const parentInstructor = resolveInstructor("khalil-delavaran", site);
const style = {
  ...baseStyle,
  schema: [
    buildGuitarStyleSchema(baseStyle),
    ...(parentCourse ? [buildCourseSchema(parentCourse, { site })] : []),
    ...(parentInstructor ? [buildPersonSchema(parentInstructor, { site })] : []),
    buildBreadcrumbSchema([
      { name: "خانه", path: "/" },
      { name: "دوره‌ها", path: "/courses" },
      { name: "آموزش گیتار", path: "/courses/guitar-course" },
      { name: baseStyle.title, path: `/courses/${baseStyle.slug}` }
    ], site)
  ].filter((item): item is object => item !== null) as object[]
};
---

<GuitarStyleLanding style={style} site={site} />
