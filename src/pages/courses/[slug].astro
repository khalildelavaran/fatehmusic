---
export const prerender = true;

import type { Instructor } from "../../types/courses";

import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CourseSeoContent from "../../components/CourseSeoContent.astro";
import FAQSection from "../../components/FAQSection.astro";

import { courses } from "../../data/courses";

import {
  resolveSite,
  resolveCourse,
  buildCourseSchema,
  buildCourseStyleSchemas,
  buildPersonSchema,
  resolveInstructor,
  buildBreadcrumbSchema,
  answersFromFaq
} from "../../seo/index.js";

export async function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course }
  }));
}

const { course } = Astro.props;
const site = resolveSite();
const resolvedCourse = resolveCourse(course, site);

if (!resolvedCourse) {
  throw new Error(`Course not found: ${course.slug}`);
}

const courseSchema = buildCourseSchema(resolvedCourse, { site });
const courseStyleSchemas = buildCourseStyleSchemas(resolvedCourse, { site });
const teacherSchemas = resolvedCourse.instructors
  .map((teacher) => resolveInstructor(teacher, site))
  .reduce((schemas: object[], teacher) => {
    const resolvedTeacher = resolveInstructor(teacher as string | object, site);
    if (resolvedTeacher) schemas.push(buildPersonSchema(resolvedTeacher, { site }));
    return schemas;
  }, []);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "خانه", path: "/" },
  { name: "دوره‌ها", path: "/courses" },
  { name: course.title, path: `/courses/${course.slug}` }
], site);

const schema: object[] = [courseSchema, ...courseStyleSchemas, ...teacherSchemas, breadcrumbSchema].filter(
  (item): item is object => item !== null
);

const teachers: Instructor[] = resolvedCourse.instructors;
const relatedCourses = courses
  .filter((item) => item.slug !== course.slug && item.instrument === course.instrument)
  .slice(0, 3);

const guitarStyleLinks = course.slug === "guitar-course"
  ? [
      { href: "/courses/guitar-pop", title: "آموزش گیتار پاپ", description: "آکورد، ریتم، استرام و همراهی آواز" },
      { href: "/courses/guitar-classical", title: "آموزش گیتار کلاسیک", description: "نت‌خوانی، فینگراستایل و اجرای قطعات کلاسیک" },
      { href: "/courses/guitar-flamenco", title: "آموزش گیتار فلامنکو", description: "کمپاس، راسگوادو و تکنیک‌های ریتمیک" }
    ]
  : [];

const foundationLinks = course.slug === "guitar-course"
  ? [
      { href: "/courses/music-theory-course", title: "تئوری موسیقی", description: "مبانی نت، ریتم، گام و آکورد برای نوازندگی" },
      { href: "/courses/solfege-course", title: "آموزش سلفژ", description: "تقویت نت‌خوانی، ریتم و گوش موسیقایی" }
    ]
  : course.slug === "zarb-tempo-course"
    ? [
        { href: "/courses/rhythm-reading-course", title: "آموزش ریتم و وزن‌خوانی", description: "تقویت درک ریتم، میزان و الگوهای ریتمیک" },
        { href: "/courses/music-theory-course", title: "تئوری موسیقی", description: "آشنایی با میزان، کشش نت و مفاهیم پایه موسیقی" },
        { href: "/courses/solfege-course", title: "آموزش سلفژ", description: "تقویت گوش موسیقایی و درک ریتم و نت" }
      ]
    : [];

const courseSeo = course.slug === "guitar-course"
  ? {
      title: "آموزش گیتار در شوشتر | کلاس گیتار از مبتدی تا پیشرفته",
      description: "کلاس آموزش گیتار در آموزشگاه موسیقی فاتح شوشتر؛ آموزش گیتار کلاسیک، پاپ و فلامنکو برای سطوح مختلف با مدرس دوره."
    }
  : course.slug === "zarb-tempo-course"
    ? {
        title: "آموزش ضرب و تمپو در شوشتر | کلاس ریتم و تمپو",
        description: "آموزش ضرب و تمپو و مبانی ریتم در آموزشگاه موسیقی فاتح شوشتر؛ مناسب هنرجویان ساز و آواز برای تقویت درک ضرب، ریتم، میزان و تمپو."
      }
    : {
        title: course.seo.title,
        description: course.seo.description
      };

const h1 = course.slug === "guitar-course"
  ? "آموزش گیتار در شوشتر"
  : course.slug === "zarb-tempo-course"
    ? "آموزش ضرب و تمپو در شوشتر"
    : course.title;

const linkCandidates = [
  ...teachers.map((teacher) => ({
    url: `${site.url}/instructors/${teacher.slug}`,
    title: teacher.name,
    type: "Instructor",
    topics: [course.instrument, ...course.seo.keywords],
    priority: 30,
    local: true
  })),
  ...relatedCourses.map((item) => ({
    url: `${site.url}/courses/${item.slug}`,
    title: item.title,
    type: "Course",
    topics: [item.instrument, item.category, ...item.seo.keywords],
    priority: 20,
    local: true
  })),
  ...guitarStyleLinks.map((item) => ({
    url: `${site.url}${item.href}`,
    title: item.title,
    type: "Course",
    topics: [item.title, "آموزش گیتار", "شوشتر"],
    priority: 40,
    local: true
  })),
  ...foundationLinks.map((item) => ({
    url: `${site.url}${item.href}`,
    title: item.title,
    type: "Course",
    topics: [item.title, course.title, "شوشتر"],
    priority: 35,
    local: true
  }))
];

const answerBlocks = answersFromFaq(
  resolvedCourse.faqs,
  `${site.url}/courses/${course.slug}`,
  `${site.url}/courses/${course.slug}/#course`
);

const auditText = [
  course.content.excerpt,
  course.content.description,
  resolvedCourse.seoContent?.overview || [],
  resolvedCourse.seoContent?.curriculum?.map((item: { title: string; description: string }) => `${item.title} ${item.description}`) || [],
  resolvedCourse.seoContent?.learningPath?.map((item: { stage: string; description: string }) => `${item.stage} ${item.description}`) || []
].flat().filter(Boolean).join(" ");
const wordCount = auditText.trim() ? auditText.trim().split(/\s+/).length : 0;
const internalLinkCount = teachers.length + relatedCourses.length + guitarStyleLinks.length + foundationLinks.length + 1;

---

<MainLayout
  title={courseSeo.title}
  description={courseSeo.description}
  keywords={course.seo.keywords}
  topics={[course.instrument, course.category, "شوشتر", ...foundationLinks.map((item) => item.title)]}
  entityType="Course"
  answerBlocks={answerBlocks}
  linkCandidates={linkCandidates}
  auditContext={{
    h1Count: 1,
    missingImageAlt: 0,
    wordCount,
    internalLinkCount
  }}
  schema={schema}
>
<script is:inline define:vars={{ course }}>
  if (typeof window.fbq === "function") {
    window.fbq("track", "ViewContent", {
      content_type: "course",
      content_name: course.title,
      content_id: course.slug
    });
  }
</script>

<Header />

<section class="course-page">
<div class="container">
<div class="course-page__hero">
<div class="course-page__content">
<span class="course-page__badge">دوره آموزشی</span>
<h1 class="course-page__title">{h1}</h1>
<p class="course-page__description">{course.content.description}</p>
<div class="course-page__meta">
<div class="course-page__meta-item"><strong>اساتید</strong><span>{teachers.map((t: Instructor) => t.name).join(" - ")}</span></div>
<div class="course-page__meta-item"><strong>سطح</strong><span>{course.level.join(" - ")}</span></div>
<div class="course-page__meta-item"><strong>مدت دوره</strong><span>{course.duration}</span></div>
<div class="course-page__meta-item"><strong>نوع کلاس</strong><span>{course.classType}</span></div>
</div>
<a href={`/register?course=${course.slug}`} class="btn btn-primary">ثبت نام آنلاین</a>
</div>
<div class="course-page__image">
<img src={course.media.cover || course.media.image} alt={course.title} width="800" height="450" loading="eager" decoding="async" />
</div>
</div>
</div>
</section>

<section class="course-page__section">
<div class="container">
<h2>اساتید دوره</h2>
<div class="course-page__teachers">
{teachers.map((teacher: Instructor) => (
<a href={`/instructors/${teacher.slug}`} class="course-page__teacher-card">
<img src={teacher.media?.images?.profile} alt={teacher.name} width="1200" height="1500" loading="lazy" decoding="async" />
<h3>{teacher.name}</h3>
<p>{teacher.position}</p>
</a>
))}
</div>
</div>
</section>

{guitarStyleLinks.length > 0 && (
<section class="course-page__section">
<div class="container">
<h2>مسیرهای تخصصی آموزش گیتار</h2>
<p>دوره جامع آموزش گیتار شامل سه مسیر مشخص است. هر مسیر صفحه مستقل خود را دارد تا محتوای آموزشی و موضوع جست‌وجویی آن به‌صورت جداگانه قابل بررسی باشد.</p>
<div class="course-page__related-grid">
{guitarStyleLinks.map((item) => (
<a href={item.href} class="course-card">
<div class="course-content">
<span>مسیر تخصصی</span>
<h3>{item.title}</h3>
<p>{item.description}</p>
</div>
</a>
))}
</div>
</div>
</section>
)}

{foundationLinks.length > 0 && (
<section class="course-page__section">
<div class="container">
<h2>{course.slug === "guitar-course" ? "دروس پایه مرتبط با گیتار" : "دروس پایه مرتبط با ریتم و تمپو"}</h2>
<p>{course.slug === "guitar-course" ? "برای تقویت مسیر نوازندگی گیتار، آشنایی با تئوری موسیقی و سلفژ می‌تواند در کنار تمرین ساز مفید باشد." : "برای تقویت درک ریتم و تمپو، مطالعه مبانی ریتم، وزن‌خوانی، تئوری موسیقی و سلفژ می‌تواند مسیر آموزشی را کامل‌تر کند."}</p>
<div class="course-page__related-grid">
{foundationLinks.map((item) => (
<a href={item.href} class="course-card">
<div class="course-content">
<span>دوره مرتبط</span>
<h3>{item.title}</h3>
<p>{item.description}</p>
</div>
</a>
))}
</div>
</div>
</section>
)}

<section class="course-page__section">
<div class="container">
<h2>برای کدام گروه‌ها مناسب است؟</h2>
<ul class="course-page__features">
{course.ageGroup.map((item: string) => <li>{item}</li>)}
</ul>
</div>
</section>

<CourseSeoContent courseTitle={course.title} seoContent={resolvedCourse.seoContent} />

<FAQSection
  title={`سوالات متداول درباره ${course.title}`}
  subtitle="پاسخ پرسش‌هایی که هنرجویان معمولاً پیش از ثبت‌نام در این دوره می‌پرسند."
  items={resolvedCourse.faqs}
/>

<section class="course-page__section">
<div class="container">
<h2>دوره های مرتبط</h2>
<div class="course-page__related-grid">
{relatedCourses.map((item) => (
<a href={`/courses/${item.slug}`} class="course-card">
<div class="course-image"><img src={item.media.image} alt={item.title} width="800" height="450" loading="lazy" decoding="async" /></div>
<div class="course-content"><h3>{item.title}</h3><span>{item.category}</span></div>
</a>
))}
</div>
</div>
</section>

<Footer />
</MainLayout>
