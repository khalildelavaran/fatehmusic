---
export const prerender = true;

import type { Instructor } from "../../types/courses";

import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CourseSeoContent from "../../components/CourseSeoContent.astro";
import FAQSection from "../../components/FAQSection.astro";

import { courses } from "../../data/courses";

import {
  resolveSite,
  resolveCourse,
  buildCourseSchema,
  buildFaqSchema,
  buildBreadcrumbSchema
} from "../../seo/index.js";


export async function getStaticPaths() {

  return courses.map((course) => ({
    params: {
      slug: course.slug
    },
    props: {
      course
    }
  }));

}



const { course } = Astro.props;


const site = resolveSite();


const resolvedCourse = resolveCourse(
  course,
  site
);

if (!resolvedCourse) {
  throw new Error(`Course not found: ${course.slug}`);
}


const courseSchema = buildCourseSchema(
  resolvedCourse,
  {
    site
  }
);



const faqSchema = buildFaqSchema(
  resolvedCourse.faqs
);



const breadcrumbSchema = buildBreadcrumbSchema(
  [
    {
      name: "خانه",
      path: "/"
    },
    {
      name: "دوره‌ها",
      path: "/courses"
    },
    {
      name: course.title,
      path: `/courses/${course.slug}`
    }
  ],
  site
);



// حذف schema های null
const schema: object[] = [
  courseSchema,
  faqSchema,
  breadcrumbSchema

].filter(
  (item): item is object =>
    item !== null
);



const teachers: Instructor[] =
  resolvedCourse.instructors;



const relatedCourses = courses
.filter(
  (item) =>
    item.slug !== course.slug &&
    item.instrument === course.instrument
)
.slice(0,3);


---


<MainLayout
  title={course.seo.title}
  description={course.seo.description}
  schema={schema}
>


<Header />


<section class="course-page">

<div class="container">


<div class="course-page__hero">


<div class="course-page__content">


<span class="course-page__badge">
دوره آموزشی
</span>


<h1 class="course-page__title">
{course.title}
</h1>


<p class="course-page__description">
{course.content.description}
</p>



<div class="course-page__meta">


<div class="course-page__meta-item">

<strong>
اساتید
</strong>

<span>
{
teachers
.map(
(t: Instructor) =>
t.name
)
.join(" - ")
}
</span>

</div>



<div class="course-page__meta-item">

<strong>
سطح
</strong>

<span>
{course.level.join(" - ")}
</span>

</div>



<div class="course-page__meta-item">

<strong>
مدت دوره
</strong>

<span>
{course.duration}
</span>

</div>



<div class="course-page__meta-item">

<strong>
نوع کلاس
</strong>

<span>
{course.classType}
</span>

</div>


</div>



<a 
href="/register"
class="btn btn-primary"
>
ثبت نام آنلاین
</a>


</div>



<div class="course-page__image">

<img
src={
course.media.cover ||
course.media.image
}
alt={course.title}
/>

</div>



</div>

</div>

</section>





<section class="course-page__section">

<div class="container">


<h2>
اساتید دوره
</h2>


<div class="course-page__teachers">


{
teachers.map(
(teacher: Instructor)=>(
<a
href={`/instructors/${teacher.slug}`}
class="course-page__teacher-card"
>


<img
src={
teacher.media?.images?.profile
}
alt={teacher.name}
/>


<h3>
{teacher.name}
</h3>


<p>
{teacher.position}
</p>


</a>
)
)
}


</div>


</div>

</section>





<section class="course-page__section">

<div class="container">


<h2>
برای کدام گروه‌ها مناسب است؟
</h2>


<ul class="course-page__features">


{
course.ageGroup.map(
(item: string)=>(

<li>
{item}
</li>

)
)
}


</ul>


</div>

</section>




<CourseSeoContent
courseTitle={course.title}
seoContent={resolvedCourse.seoContent}
/>



<FAQSection

title={`سوالات متداول درباره ${course.title}`}

subtitle="پاسخ پرسش‌هایی که هنرجویان معمولاً پیش از ثبت‌نام در این دوره می‌پرسند."

items={resolvedCourse.faqs}

/>





<section class="course-page__section">

<div class="container">


<h2>
دوره های مرتبط
</h2>



<div class="course-page__related-grid">


{
relatedCourses.map(
(item)=>(
<a
href={`/courses/${item.slug}`}
class="course-card"
>


<div class="course-image">

<img
src={item.media.image}
alt={item.title}
/>

</div>



<div class="course-content">

<h3>
{item.title}
</h3>


<span>
{item.category}
</span>


</div>


</a>

)
)
}


</div>


</div>

</section>



<Footer />


</MainLayout>