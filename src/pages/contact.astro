---
export const prerender = true;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ContactOverview from "../components/ContactOverview.astro";
import ContactQuickMessage from "../components/ContactQuickMessage.astro";
import ContactFAQ from "../components/ContactFAQ.astro";
import { resolveSite, buildContactPageSchema, buildBreadcrumbSchema, buildFaqSchema } from "../seo/index.js";
import { contactFaqs } from "../data/contact-faq.js";

const site = resolveSite();
const title = "تماس با آموزشگاه موسیقی فاتح شوشتر | آدرس، تلفن و نقشه";
const description = "آدرس، شماره تلفن، ساعات کاری، موقعیت روی نقشه و راه‌های ارتباط با آموزشگاه موسیقی فاتح شوشتر برای ثبت‌نام و مشاوره.";
const canonical = `${site.url}/contact`;
const faqSchema = buildFaqSchema(contactFaqs, {
    site,
    url: `${site.url}/contact`,
    name: "سوالات متداول درباره تماس با آموزشگاه موسیقی فاتح"
});
const schema = [
    buildContactPageSchema({ title, description, site }),
    buildBreadcrumbSchema([
        { name: "خانه", path: "/" },
        { name: "تماس با ما", path: "/contact" }
    ], site),
    faqSchema
].filter((item): item is object => item !== null);
---

<MainLayout
    title={title}
    description={description}
    canonical={canonical}
    keywords={["تماس آموزشگاه موسیقی فاتح", "آدرس آموزشگاه موسیقی شوشتر", "شماره تماس آموزشگاه موسیقی فاتح", "آموزش موسیقی شوشتر"]}
    topics={["shushtar", "music-education", "contact"]}
    entityType="ContactPage"
    auditContext={{ h1Count: 1, missingImageAlt: 0, internalLinkCount: 7 }}
    schema={schema}
>
    <Header />
    <PageHero
        badge="تماس با ما"
        title="تماس با آموزشگاه موسیقی فاتح در شوشتر"
        description="آدرس، شماره تماس، مسیر دسترسی و راه‌های ارتباط با آموزشگاه موسیقی فاتح برای ثبت‌نام و مشاوره دوره‌های موسیقی در شوشتر."
    />
    <main>
        <ContactOverview />
        <ContactQuickMessage />
        <ContactFAQ />
        <section class="container" style="padding: 20px 0 70px;">
            <h2>اطلاعات محلی و شروع آموزش موسیقی در شوشتر</h2>
            <p>اگر هنوز دوره یا ساز مناسب خود را انتخاب نکرده‌اید، می‌توانید فهرست دوره‌ها و صفحه موقعیت آموزشگاه را بررسی کنید و سپس برای مشاوره و ثبت‌نام با آموزشگاه تماس بگیرید.</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                <a href="/locations/shushtar" class="btn btn-primary">آموزش موسیقی در شوشتر</a>
                <a href="/courses" class="btn btn-outline">مشاهده دوره‌ها</a>
                <a href="/instructors" class="btn btn-outline">مشاهده اساتید</a>
                <a href="/register" class="btn btn-outline">ثبت‌نام و مشاوره</a>
            </div>
        </section>
    </main>
    <Footer />
</MainLayout>
