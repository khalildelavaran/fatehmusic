---
export const prerender = true;
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ContactOverview from "../components/ContactOverview.astro";
import ContactQuickMessage from "../components/ContactQuickMessage.astro";
import ContactFAQ from "../components/ContactFAQ.astro";
import { resolveSite, buildContactPageSchema, buildBreadcrumbSchema, buildFaqSchema } from "../seo/index.js";
import { faqs } from "../components/ContactFAQ.astro";

const site = resolveSite();
const title = "تماس با آموزشگاه موسیقی فاتح";
const description = "راه‌های ارتباط با آموزشگاه موسیقی فاتح در شوشتر، آدرس، موقعیت روی نقشه، شماره تماس، ساعات کاری و مسیرهای ارتباطی برای ثبت‌نام و مشاوره.";
const canonical = `${site.url}/contact`;
const schema = [
    buildContactPageSchema({ title, description, site }),
    buildBreadcrumbSchema([
        { name: "خانه", path: "/" },
        { name: "تماس با ما", path: "/contact" }
    ], site),
    buildFaqSchema(faqs)
].filter(Boolean);
---

<MainLayout
    title={title}
    description={description}
    canonical={canonical}
    keywords={["تماس آموزشگاه موسیقی فاتح", "آدرس آموزشگاه موسیقی شوشتر", "آموزش موسیقی شوشتر"]}
    topics={["shushtar", "music-education"]}
    entityType="ContactPage"
    auditContext={{ h1Count: 1, missingImageAlt: 0, internalLinkCount: 5 }}
    schema={schema}
>
    <Header />
    <PageHero
        badge="تماس با ما"
        title="تماس با آموزشگاه موسیقی فاتح در شوشتر"
        description="آدرس، شماره تماس، مسیر دسترسی و راه‌های ارتباط با آموزشگاه موسیقی فاتح برای ثبت‌نام و مشاوره دوره‌های موسیقی در شوشتر."
    />
    <main>
        <ContactOverview />
        <ContactQuickMessage />
        <ContactFAQ />
        <section class="container" style="padding: 20px 0 70px;">
            <h2>اطلاعات محلی آموزشگاه در شوشتر</h2>
            <p>برای مطالعه اطلاعات محلی، دوره‌ها و مدرس‌های مرتبط با آموزش موسیقی در شوشتر، صفحه اختصاصی موقعیت آموزشگاه را ببینید.</p>
            <a href="/locations/shushtar" class="btn btn-primary">آموزش موسیقی در شوشتر</a>
        </section>
    </main>
    <Footer />
</MainLayout>
