---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ContactOverview from "../components/ContactOverview.astro";
import ContactQuickMessage from "../components/ContactQuickMessage.astro";
import ContactFAQ from "../components/ContactFAQ.astro";
---

<MainLayout
    title="تماس با آموزشگاه موسیقی فاتح"
    description="راه‌های ارتباط با آموزشگاه موسیقی فاتح، آدرس، موقعیت، ساعات کاری و پاسخ به سوالات متداول."
>

    <Header />
    <PageHero
        badge="تماس با ما"
        title="تماس با آموزشگاه موسیقی فاتح در شوشتر"
        description="آدرس، شماره تماس، مسیر دسترسی و راه‌های ارتباط با آموزشگاه موسیقی فاتح برای ثبت‌نام و مشاوره دوره‌های موسیقی در شوشتر."
    />
    <main>

        <ContactOverview />

        <ContactQuickMessage />

        <ContactFAQ />

    </main>

    <Footer />

</MainLayout>