---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildCourseSchema,
  resolveCourse,
  resolveSite
} from "../../seo/index.js";
import { getPublishedPost } from "../../server/blog";
import { formatJalaliDate } from "../../utils/format-date";
import "../../styles/blog.css";

const post = await getPublishedPost(Astro.params.slug ?? "");

if (!post) {
  return Astro.rewrite("/404");
}

const site = resolveSite();
const canonicalUrl = `${site.url}/blog/${encodeURIComponent(Astro.params.slug ?? "")}`;

// Reuse the canonical Course resolver so the blog article and course page
// reference the same Course entity, provider, and instructor entities.
const relatedCourse = post.related_course_slug
  ? resolveCourse(post.related_course_slug, site)
  : null;

const articleSchema = buildArticleSchema(post, {
  site,
  url: canonicalUrl
});

const breadcrumbSchema = buildBreadcrumbSchema(
  [
    { name: "خانه", path: "/" },
    { name: "وبلاگ", path: "/blog" },
    { name: post.title, path: `/blog/${Astro.params.slug ?? ""}` }
  ],
  site
);

const courseSchema = relatedCourse
  ? buildCourseSchema(relatedCourse, { site })
  : null;
---

<MainLayout
  title={post.meta_title || `${post.title} | آموزشگاه موسیقی فاتح`}
  description={post.meta_description || post.excerpt}
  canonical={canonicalUrl}
  schema={[articleSchema, breadcrumbSchema, courseSchema].filter(Boolean)}
>
  <Header />

  <main class="blog-article">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a>
      <span>/</span>
      <a href="/blog">وبلاگ</a>
      <span>/</span>
      <span aria-current="page">{post.title}</span>
    </nav>

    <article>
      <header>
        <p class="eyebrow">{post.topic}</p>
        <h1>{post.title}</h1>
        <p class="blog-date">{formatJalaliDate(post.published_at ?? post.created_at)}</p>
        <p>{post.excerpt}</p>
      </header>

      <div class="article-content">
        {post.content.split("\n").filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <footer class="article-links">
        <a href="/">آموزشگاه موسیقی فاتح</a>
        {relatedCourse && <a href={`/courses/${relatedCourse.slug}`}>دوره مرتبط: {relatedCourse.title}</a>}
        <a href="/register">ثبت‌نام و مشاوره</a>
        <a href="/contact">تماس با آموزشگاه</a>
      </footer>
    </article>
  </main>

  <CTA />
  <Footer />
</MainLayout>
