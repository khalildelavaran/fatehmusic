---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildCourseSchema,
  resolveCourse,
  resolveSite,
  answersFromFaq,
  resolveTopics,
  buildArticleClusterLinks
} from "../../seo/index.js";
import { getPublishedPost, getPublishedPosts } from "../../server/blog";
import { formatJalaliDate } from "../../utils/format-date";
import "../../styles/blog.css";

const post = await getPublishedPost(Astro.params.slug ?? "");
if (!post) return Astro.rewrite("/404");

const site = resolveSite();
const canonicalUrl = `${site.url}/blog/${encodeURIComponent(Astro.params.slug ?? "")}`;
const allPosts = await getPublishedPosts();
const clusterEntry = buildArticleClusterLinks(allPosts, 4).find((item) => item.slug === post.slug);
const relatedPosts = clusterEntry?.related ?? [];
const relatedCourse = post.related_course_slug ? resolveCourse(post.related_course_slug, site) : null;
const title = post.meta_title || `${post.title} | آموزشگاه موسیقی فاتح`;
const description = post.meta_description || post.excerpt;
const keywords = [post.topic, ...(relatedCourse?.seo?.metadata?.keywords || [])].filter(Boolean);
const topics = resolveTopics({ title: post.title, keywords, path: "/blog" });
const articleSchema = buildArticleSchema(post, { site, url: canonicalUrl, keywords, topics });
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "خانه", path: "/" },
  { name: "وبلاگ", path: "/blog" },
  { name: post.title, path: `/blog/${Astro.params.slug ?? ""}` }
], site);
const courseSchema = relatedCourse ? buildCourseSchema(relatedCourse, { site }) : null;
const answerBlocks = answersFromFaq([], canonicalUrl, `${canonicalUrl}#article`);
const wordCount = post.content.trim().split(/\s+/).filter(Boolean).length + post.excerpt.trim().split(/\s+/).filter(Boolean).length;
const internalLinkCount = 6 + relatedPosts.length;
const schema = [articleSchema, breadcrumbSchema, courseSchema].filter(Boolean);
---

<MainLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  keywords={keywords}
  topics={topics.map((topic) => topic.slug)}
  entityType="Article"
  lastModified={post.updated_at ?? post.published_at ?? post.created_at}
  answerBlocks={answerBlocks}
  articlePosts={allPosts}
  auditContext={{ h1Count: 1, missingImageAlt: 0, wordCount, internalLinkCount }}
  schema={schema}
>
  <Header />
  <main class="blog-article">
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <a href="/">خانه</a><span>/</span><a href="/blog">وبلاگ</a><span>/</span><span aria-current="page">{post.title}</span>
    </nav>

    <article>
      <header>
        <p class="eyebrow">{post.topic}</p>
        <h1>{post.title}</h1>
        <p class="blog-date">{formatJalaliDate(post.published_at ?? post.created_at)}</p>
        <p>{post.excerpt}</p>
      </header>

      <div class="article-content">
        {post.content.split("\n").filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {relatedPosts.length > 0 && (
        <section class="related-articles" aria-labelledby="related-articles-title">
          <header>
            <p class="eyebrow">ادامه مسیر یادگیری</p>
            <h2 id="related-articles-title">مقالات مرتبط با این موضوع</h2>
            <p>این مقاله‌ها بر اساس موضوع، هدف جستجو و ارتباط با دوره‌های آموزشگاه به‌صورت خودکار انتخاب شده‌اند.</p>
          </header>

          <div class="blog-grid related-articles-grid">
            {relatedPosts.map((related) => (
              <article class="blog-card">
                <div>
                  <span>{related.sharedTopics.join("، ")}</span>
                  <h3><a href={`/blog/${related.slug}`}>{related.title}</a></h3>
                  <p>ارتباط معنایی: {related.score} امتیاز</p>
                </div>
                <footer>
                  <a class="read-more" href={`/blog/${related.slug}`}>مطالعه مقاله</a>
                </footer>
              </article>
            ))}
          </div>
        </section>
      )}

      <footer class="article-links">
        <a href="/">آموزشگاه موسیقی فاتح</a>
        <a href="/locations/shushtar">آموزش موسیقی در شوشتر</a>
        {relatedCourse && <a href={`/courses/${relatedCourse.slug}`}>دوره مرتبط: {relatedCourse.title}</a>}
        <a href="/courses">همه دوره‌ها</a>
        <a href="/register">ثبت‌نام و مشاوره</a>
        <a href="/contact">تماس با آموزشگاه</a>
      </footer>
    </article>
  </main>
  <CTA />
  <Footer />
</MainLayout>
