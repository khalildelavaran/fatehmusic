---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Instructors from "../components/Instructors.astro";
import CTA from "../components/CTA.astro";
import PageHero from "../components/PageHero.astro";
import { instructors } from "../data/instructors";
import { resolveSite, buildItemListSchema, buildBreadcrumbSchema } from "../seo/index.js";
import { instructorEntityId } from "../seo/geo/entity.js";

const site = resolveSite();
const canonical = `${site.url}/instructors`;
const activeInstructors = instructors.filter((instructor) => instructor.active !== false);

const instructorListSchema = buildItemListSchema({
    name: "اساتید آموزشگاه موسیقی فاتح شوشتر",
    url: canonical,
    itemType: "Person",
    items: activeInstructors.map((instructor) => ({
        name: instructor.name,
        url: `${site.url}/instructors/${instructor.slug}`,
        id: instructorEntityId(`${site.url}/instructors/${instructor.slug}`)
    }))
});
const instructorBreadcrumbSchema = buildBreadcrumbSchema(
    [
        { name: "خانه", path: "/" },
        { name: "اساتید", path: "/instructors" }
    ],
    site
);
---

<MainLayout
    title="اساتید آموزشگاه موسیقی فاتح شوشتر | مدرس‌های موسیقی"
    description="آشنایی با اساتید آموزشگاه موسیقی فاتح شوشتر؛ مدرس‌های گیتار، پیانو، ویولن، سنتور، تار، سازهای کوبه‌ای، آواز و دروس پایه موسیقی."
    canonical={canonical}
    keywords={["اساتید موسیقی شوشتر", "مدرس موسیقی شوشتر", "استاد گیتار شوشتر", "استاد پیانو شوشتر", "مدرس آواز شوشتر"]}
    topics={["shushtar", "instructors", "music-education"]}
    entityType="ItemList"
    auditContext={{ h1Count: 1, missingImageAlt: 0, internalLinkCount: activeInstructors.length }}
    schema={[instructorListSchema, instructorBreadcrumbSchema].filter((item): item is object => item !== null && item !== undefined)}
>
    <Header />
    <PageHero
        badge="اساتید"
        title="اساتید آموزشگاه موسیقی فاتح در شوشتر"
        description="آشنایی با مدرسین و اساتید آموزشگاه موسیقی فاتح؛ راهنمای انتخاب استاد برای یادگیری ساز، آواز و مبانی موسیقی در شوشتر."
    />
    <main>
        <section class="container" style="padding: 36px 0 10px;">
            <p>برای انتخاب مدرس، صفحه اختصاصی هر استاد را بررسی کنید تا تخصص، دوره‌های قابل ارائه و مسیر آموزشی مرتبط را ببینید.</p>
        </section>
        <Instructors />
    </main>
    <CTA />
    <Footer />
</MainLayout>
