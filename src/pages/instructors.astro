---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Instructors from "../components/Instructors.astro";
import CTA from "../components/CTA.astro";
import PageHero from "../components/PageHero.astro";
---

<MainLayout
    title="اساتید آموزشگاه موسیقی فاتح | مدرسین موسیقی در شوشتر"
    description="آشنایی با اساتید آموزشگاه موسیقی فاتح؛ مدرسین مجرب گیتار، پیانو، ویولون، آواز و سازهای ایرانی."
>

    <Header />

    <PageHero
        badge="اساتید"
        title="اساتید آموزشگاه موسیقی فاتح در شوشتر"
        description="آشنایی با مدرسین و اساتید آموزشگاه موسیقی فاتح؛ راهنمای انتخاب استاد برای یادگیری ساز، آواز و مبانی موسیقی در شوشتر."
    />
	 
    <Instructors />

    <CTA />

    <Footer />

</MainLayout>