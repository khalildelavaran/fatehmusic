---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/student.css";
---
<MainLayout title="ورود مدیریت | آموزشگاه موسیقی فاتح" noindex={true}>
  <main class="student-auth" dir="rtl">
    <section class="student-card">
      <img src="/logo.webp" alt="آموزشگاه موسیقی فاتح" class="student-logo" />
      <h1>ورود مدیریت</h1>
      <p>برای ورود، نام کاربری و رمز عبور مدیریت را وارد کنید.</p>
      <form id="adminLoginForm">
        <label>نام کاربری<input id="username" autocomplete="username" required /></label>
        <label>رمز عبور<input id="password" type="password" autocomplete="current-password" required /></label>
        <button type="submit">ورود به داشبورد</button>
        <p id="loginStatus" class="student-status" role="alert"></p>
      </form>
    </section>
  </main>
  <script>
    const form = document.querySelector('#adminLoginForm');
    const status = document.querySelector('#loginStatus');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'در حال ورود...';
      const r = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          username: document.querySelector('#username').value,
          password: document.querySelector('#password').value,
        }),
      });
      const d = await r.json().catch(() => ({ message: 'خطای سرور' }));
      if (!r.ok || !d.success) { status.textContent = d.message || 'ورود ناموفق بود.'; return; }
      location.href = '/admin';
    });
  </script>
</MainLayout>
