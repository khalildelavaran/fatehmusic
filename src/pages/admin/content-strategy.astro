---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import "../../styles/admin/topics.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
import { getPublishedPosts } from "../../server/blog";
import { courses } from "../../data/courses.js";
import { buildSEOIntelligence, resolveSite } from "../../seo/index.js";
import { listTopics } from "../../ai/content-engine/db";
import { getRecentSearchConsoleRows, getLatestGscSyncRun } from "../../seo/v2/providers/search-console-store.js";
import { listSeoActions } from "../../seo/v2/seo-action-store.js";
import { getAhrefsConfig, getLatestAhrefsMarketSnapshot } from "../../seo/v2/providers/ahrefs.js";

const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN) return Astro.redirect("/admin");

const posts = await getPublishedPosts();
const site = resolveSite();
const db = (env as AdminEnv).DB;
const gscRows = db ? await getRecentSearchConsoleRows(db, site.url, { days: 90 }) : [];
const latestGscSync = db ? await getLatestGscSyncRun(db, site.url) : null;
const seoActions: SeoAction[] = db ? await listSeoActions(db, { limit: 8 }) as unknown as SeoAction[] : [];
const ahrefsConfig = getAhrefsConfig(env as unknown as Record<string, unknown>);
const [ahrefsMetrics, ahrefsCompetitors, ahrefsRefdomains, ahrefsOrganicKeywords] = ahrefsConfig.enabled && db ? await Promise.all([
  getLatestAhrefsMarketSnapshot(db, { target: ahrefsConfig.target, country: ahrefsConfig.country, snapshotType: "metrics" }),
  getLatestAhrefsMarketSnapshot(db, { target: ahrefsConfig.target, country: ahrefsConfig.country, snapshotType: "organic-competitors" }),
  getLatestAhrefsMarketSnapshot(db, { target: ahrefsConfig.target, country: ahrefsConfig.country, snapshotType: "refdomains" }),
  getLatestAhrefsMarketSnapshot(db, { target: ahrefsConfig.target, country: ahrefsConfig.country, snapshotType: "organic-keywords" })
]) : [null, null, null, null];
const storedTopics = db ? await listTopics(db, { limit: 500 }) : [];
const activeTopicCandidates = storedTopics.filter((item) => item.status === "approved" || item.status === "candidate");
const intelligence = buildSEOIntelligence({
  posts,
  courses,
  topicCandidates: activeTopicCandidates,
  gscRows,
  siteUrl: site.url
});

const normalizeText = (value: string) => String(value ?? "")
  .replace(/[\u200c\u200f\u200e]/g, "")
  .replace(/[يى]/g, "ی")
  .replace(/[ك]/g, "ک")
  .replace(/[\s\u0640]+/g, " ")
  .replace(/[؟?!.,،؛:]+$/g, "")
  .trim()
  .toLowerCase();

const normalizeSlug = (value: string) => String(value ?? "")
  .trim()
  .replace(/^\/+|\/+$/g, "")
  .toLowerCase();

const daysSince = (value: string | null | undefined) => {
  if (!value) return null;
  const time = new Date(value).getTime();
  if (!Number.isFinite(time)) return null;
  return Math.max(0, Math.floor((Date.now() - time) / 86_400_000));
};

const gscAgeDays = daysSince(latestGscSync?.finishedAt || latestGscSync?.startedAt);
const ahrefsAgeDays = daysSince(ahrefsMetrics?.fetchedAt || ahrefsMetrics?.snapshotDate);
const gscStale = gscAgeDays !== null && gscAgeDays > 3;
const ahrefsStale = ahrefsAgeDays !== null && ahrefsAgeDays > 8;

const publishedTitles = new Set(posts.map((post) => normalizeText(post.title)));
const publishedSlugs = new Set(posts.map((post) => normalizeSlug(post.slug)));

interface SeoActionMeasurement {
  measuredAt: string;
  windowStart: string;
  windowEnd: string;
  impressions: number;
  clicks: number;
  ctr: number;
  position: number | null;
}

interface SeoAction {
  id: number;
  actionType: string;
  target_url: string | null;
  target_slug: string | null;
  target_title: string | null;
  related_course_slug: string | null;
  recommendation_score: number | null;
  status: string;
  source: string;
  created_at: string;
  updated_at: string;
  published_at: string | null;
  latest: SeoActionMeasurement | null;
  previous: SeoActionMeasurement | null;
  ctrDelta: number | null;
  positionDelta: number | null;
  impressionDelta: number | null;
}

const opportunities = intelligence.opportunities.filter((item) => {
  // Existing URLs are the target of optimization/expansion/link/merge actions.
  // Only a genuine NEW_CONTENT opportunity should be hidden when its title or
  // canonical slug already belongs to a published article.
  if (item.action !== "NEW_CONTENT") return true;
  const sameTitle = publishedTitles.has(normalizeText(item.title));
  const sameSlug = publishedSlugs.has(normalizeSlug(item.suggestedSlug));
  return !sameTitle && !sameSlug;
});

const opportunityCount = opportunities.length;
const highPriorityCount = opportunities.filter((item) => item.priority >= 85).length;
const newContentCount = opportunities.filter((item) => item.action === "NEW_CONTENT").length;
const approvedTopicCount = storedTopics.filter((item) => item.status === "approved").length;
const candidateTopicCount = storedTopics.filter((item) => item.status === "candidate").length;

const topicCounts = new Map<string, number>();
for (const item of opportunities) topicCounts.set(item.topicName, (topicCounts.get(item.topicName) ?? 0) + 1);
const actionLabel: Record<string, string> = {
  NEW_CONTENT: "تولید مقاله جدید",
  OPTIMIZE_EXISTING: "بهینه‌سازی محتوای موجود",
  EXPAND: "گسترش محتوای موجود",
  MERGE_CONTENT: "ادغام محتوا",
  LINK: "تقویت لینک‌سازی داخلی",
  MONITOR: "پایش",
  CREATE_OR_MONITOR: "ایجاد یا پایش"
};
const actionClass: Record<string, string> = {
  NEW_CONTENT: "new",
  OPTIMIZE_EXISTING: "optimize",
  EXPAND: "optimize",
  MERGE_CONTENT: "merge",
  LINK: "link",
  MONITOR: "monitor",
  CREATE_OR_MONITOR: "monitor"
};
const sourceLabel: Record<string, string> = { "topic-engine": "موتور موضوعات", gap: "شکاف SEO/GEO", "topic-engine+gap": "هر دو موتور" };
---

<MainLayout title="استراتژی محتوا | پنل مدیریت آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="content-strategy" />
    <main class="admin-main"><div class="admin-shell strategy-shell">
      <section class="admin-hero" aria-label="استراتژی محتوا">
        <span class="admin-hero-label">SEO / GEO Content Intelligence</span>
        <h1>استراتژی محتوا</h1>
        <span class="admin-hero-description">مدیریت استراتژی تولید محتوا و موضوعات پیشنهادی در یک بخش.</span>
      </section>

      <div class="strategy-tabs" role="tablist" aria-label="استراتژی محتوا">
        <button type="button" class="strategy-tab is-active" role="tab" aria-selected="true" aria-controls="strategy-panel" data-strategy-tab="strategy">استراتژی محتوا</button>
        <button type="button" class="strategy-tab" role="tab" aria-selected="false" aria-controls="topics-panel" data-strategy-tab="topics">موضوعات</button>
      </div>

      <section id="strategy-panel" class="strategy-tab-panel is-active" role="tabpanel">
        <div class="strategy-stats">
          <div class="strategy-stat"><strong>{opportunityCount}</strong><span>فرصت نهایی</span></div>
          <div class="strategy-stat strategy-stat-hot"><strong>{highPriorityCount}</strong><span>اولویت بالا</span></div>
          <div class="strategy-stat"><strong>{newContentCount}</strong><span>مقاله جدید</span></div>
          <div class="strategy-stat"><strong>{approvedTopicCount + candidateTopicCount}</strong><span>موضوع فعال</span></div>
        </div>

        <section class="strategy-section strategy-gsc">
          <div class="strategy-section-head"><div><span class="admin-hero-label">Google Search Console</span><h2>داده‌ی واقعی جستجو</h2></div>
            <button type="button" id="gscSyncButton" class="strategy-sync-button">همگام‌سازی GSC</button>
          </div>
          <div class="strategy-gsc-status">
            <span class:list={["strategy-gsc-pill", intelligence.gsc.connected && "is-connected"]}>{intelligence.gsc.connected ? "متصل و دارای داده" : "GSC هنوز داده‌ای ندارد"}</span>
            <span>{intelligence.gsc.signalRowCount} سیگنال</span>
            <span>{intelligence.summary.searchBackedCount} فرصت search-backed</span>
            <span>{intelligence.summary.cannibalizationCount} تعارض</span>
            {latestGscSync && <span class:list={["strategy-data-age", (gscStale || Number(latestGscSync.truncated) === 1) && "is-stale"]}>آخرین sync: {latestGscSync.finishedAt || latestGscSync.startedAt} · {gscAgeDays === null ? "سن نامشخص" : `${gscAgeDays} روز پیش`}{Number(latestGscSync.truncated) === 1 ? " · داده به سقف ردیف رسیده است" : ""}</span>}
          </div>
          {intelligence.gsc.connected && <div class="strategy-gsc-grid">
            <div><strong>Queryهای برتر</strong><div class="strategy-gsc-list">
              {[...intelligence.gsc.index.byQuery.entries()].slice(0, 8).map(([query, signal]) => <span><code>{query}</code> · {Math.round(signal.impressions).toLocaleString("fa-IR")} impression · رتبه {signal.position?.toFixed(1) ?? "-"}</span>)}
            </div></div>
            <div><strong>صفحات برتر</strong><div class="strategy-gsc-list">
              {[...intelligence.gsc.index.byPage.entries()].slice(0, 8).map(([page, signal]) => <span><code>{page.replace(site.url, "") || "/"}</code> · {Math.round(signal.impressions).toLocaleString("fa-IR")} impression · CTR {(signal.ctr * 100).toFixed(1)}%</span>)}
            </div></div>
          </div>}
        </section>

        <section class="strategy-section strategy-ahrefs">
          <div class="strategy-section-head"><div><span class="admin-hero-label">Ahrefs Market Intelligence</span><h2>بازار، رقبا و بک‌لینک</h2></div>
            <button type="button" id="ahrefsSyncButton" class="strategy-sync-button">همگام‌سازی Ahrefs</button>
          </div>
          {!ahrefsConfig.enabled ? (
            <div class="strategy-empty">Ahrefs هنوز با <code>AHREFS_API_KEY</code> تنظیم نشده است. تا آن زمان موتور از Search Console استفاده می‌کند.</div>
          ) : (
            <div class="strategy-ahrefs-grid">
              <div><strong>Organic keywords</strong><span>{Number(ahrefsMetrics?.payload?.org_keywords || 0).toLocaleString("fa-IR")}</span><small>Top 3: {Number(ahrefsMetrics?.payload?.org_keywords_1_3 || 0).toLocaleString("fa-IR")}</small></div>
              <div><strong>Organic traffic</strong><span>{Number(ahrefsMetrics?.payload?.org_traffic || 0).toLocaleString("fa-IR")}</span><small>تخمین ماهانه Ahrefs</small></div>
              <div><strong>Competitors</strong><span>{Array.isArray(ahrefsCompetitors?.payload) ? ahrefsCompetitors.payload.length.toLocaleString("fa-IR") : "0"}</span><small>رقبای ارگانیک ثبت‌شده</small></div>
              <div><strong>Referring domains</strong><span>{Array.isArray(ahrefsRefdomains?.payload) ? ahrefsRefdomains.payload.length.toLocaleString("fa-IR") : "0"}</span><small>دامنه‌های ارجاع‌دهنده</small></div>
              <div><strong>Tracked keyword rows</strong><span>{Array.isArray(ahrefsOrganicKeywords?.payload) ? ahrefsOrganicKeywords.payload.length.toLocaleString("fa-IR") : "0"}</span><small>نمونه کلمات ارگانیک</small></div>
            </div>
          )}
          {ahrefsConfig.enabled && (
            <div class:list={["strategy-data-freshness", ahrefsStale && "is-stale"]}>
              آخرین Snapshot Ahrefs: {ahrefsMetrics?.snapshotDate || "داده‌ای ثبت نشده"}
              {ahrefsAgeDays === null ? " · سن داده نامشخص" : ` · ${ahrefsAgeDays} روز قبل`}
            </div>
          )}
          {ahrefsConfig.enabled && Array.isArray(ahrefsCompetitors?.payload) && ahrefsCompetitors.payload.length > 0 && (
            <div class="strategy-ahrefs-list"><strong>رقبای ارگانیک کشف‌شده</strong>
              {ahrefsCompetitors.payload.slice(0, 8).map((item) => <span><code>{item.competitor_domain || item.competitor_url || "-"}</code> · {Number(item.keywords_common || 0).toLocaleString("fa-IR")} keyword مشترک · سهم {Number(item.share || 0).toFixed(1)}%</span>)}
            </div>
          )}
        </section>

        <section class="strategy-section strategy-actions">
          <div class="strategy-section-head"><div><span class="admin-hero-label">Closed Loop</span><h2>نتیجه‌ی اقدامات SEO</h2></div><span class="strategy-count">{seoActions.length} اقدام اخیر</span></div>
          {seoActions.length === 0 ? <div class="strategy-empty">هنوز اقدام قابل اندازه‌گیری ثبت نشده است.</div> : (
            <div class="strategy-action-list">
              {seoActions.map((action) => <article class="strategy-action-card">
                <div><strong>{action.target_title || action.target_slug}</strong><span>{action.status}</span></div>
                <p>{action.target_url}</p>
                {action.latest && <small>CTR: {(Number(action.latest.ctr) * 100).toFixed(1)}% · رتبه: {action.latest.position != null ? Number(action.latest.position).toFixed(1) : "-"} · Impression: {Math.round(Number(action.latest.impressions)).toLocaleString("fa-IR")}</small>}
                {action.ctrDelta != null && <small>تغییر CTR: {(action.ctrDelta * 100).toFixed(2)}% · تغییر رتبه: {action.positionDelta?.toFixed(2) ?? "-"}</small>}
              </article>)}
            </div>
          )}
        </section>

       <section class="strategy-section">
          <div class="strategy-section-head"><div><span class="admin-hero-label">Unified Production Queue</span><h2>صف نهایی تولید محتوا</h2></div><span class="strategy-count">{opportunityCount} فرصت</span></div>
          {opportunities.length === 0 ? (
            <div class="strategy-empty"><strong>در حال حاضر فرصت محتوایی قابل اقدام شناسایی نشده است.</strong><span>با تولید موضوعات جدید یا انتشار مقاله‌های جدید، این صف خودکار به‌روزرسانی می‌شود.</span></div>
          ) : (
            <div class="strategy-list">
              {opportunities.map((item, index) => (
                <article class="strategy-card">
                  <div class="strategy-rank">{index + 1}</div>
                  <div class="strategy-card-main">
                    <div class="strategy-card-top"><div class="strategy-badges">
                      <span class:list={["strategy-priority", item.priority >= 85 && "high"]}>امتیاز {item.priority}</span>
                      <span class:list={["strategy-action", actionClass[item.action] || "new"]}>{actionLabel[item.action] || item.action}</span>
                      <span class="strategy-intent">{item.searchIntent}</span>
                      <span class="strategy-topic">{item.topicName}</span>
                      <span class="strategy-source">{sourceLabel[item.source] || item.source}</span>
                    </div><span class="strategy-coverage">{item.articleCount} مقاله موجود</span></div>
                    <h3>{item.title}</h3><p>{item.rationale}</p>
                    <div class="strategy-meta">
                      <div><strong>Entity هدف:</strong> {item.targetEntity.name}</div>
                      {item.course && <div><strong>Course:</strong> {item.course.title}</div>}
                      <div><strong>Slug:</strong> <code>{item.suggestedSlug}</code></div>
                      {item.gapDetected && <div><strong>Gap Score:</strong> {item.gapPriority}</div>}
                      {item.searchSignal?.available && <div><strong>داده جستجو:</strong> {Math.round(Number(item.searchSignal.impressions || 0)).toLocaleString("fa-IR")} impression · CTR {(Number(item.searchSignal.ctr || 0) * 100).toFixed(1)}% · رتبه {item.searchSignal.position != null ? Number(item.searchSignal.position).toFixed(1) : "-"}</div>}
                    </div>
                    {item.searchSignal?.available && item.searchSignal.matchedQueries?.length > 0 && (
                      <div class="strategy-search-evidence"><strong>Queryهای مؤثر</strong><div>{item.searchSignal.matchedQueries.slice(0, 5).map((query: string) => <span>{query}</span>)}</div></div>
                    )}
                    {item.existingArticleSlugs?.length > 0 && <div class="strategy-existing"><strong>محتوای موجود برای بهینه‌سازی</strong><div>{item.existingArticleSlugs.map((slug: string) => <code>{slug}</code>)}</div></div>}
                    <div class="strategy-queries"><strong>Query angles</strong><div>{item.queryAngles.map((query: string) => <span>{query}</span>)}</div></div>
                    <div class="strategy-links"><strong>Internal links</strong><div>{item.recommendedLinks.map((url: string) => <a href={url}>{url.replace(site.url, "") || "/"}</a>)}</div></div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        {topicCounts.size > 0 && <section class="strategy-section"><div class="strategy-section-head"><div><span class="admin-hero-label">Coverage Map</span><h2>توزیع فرصت‌ها بر اساس Topic</h2></div></div><div class="strategy-topic-grid">{[...topicCounts.entries()].sort((a, b) => b[1] - a[1]).map(([topic, count]) => <div class="strategy-topic-item"><span>{topic}</span><strong>{count}</strong></div>)}</div></section>}
      </section>

      <section id="topics-panel" class="strategy-tab-panel" role="tabpanel" hidden>
        <div class="strategy-section">
          <div class="strategy-section-head"><div><span class="admin-hero-label">Topic Intelligence</span><h2>موضوعات مقالات وبلاگ</h2></div><span class="strategy-count">{approvedTopicCount} تأییدشده · {candidateTopicCount} در انتظار بررسی</span></div>
          <section class="admin-ai-trigger"><div><strong>تولید موضوعات جدید</strong><span>موضوعات از روی دوره‌های فعال تولید و امتیازدهی می‌شوند.</span></div><button type="button" id="generateTopicsButton">تولید موضوعات جدید</button></section>
          <p id="generateStatus" role="status" class="admin-ai-status"></p>
          <section class="admin-panel admin-panel--topics"><div class="admin-topics-toolbar"><div class="admin-topics-filters" role="tablist" aria-label="فیلتر وضعیت"><button type="button" class="is-active" data-filter="approved">تأییدشده</button><button type="button" data-filter="candidate">در انتظار بررسی</button><button type="button" data-filter="generating">در حال تولید</button><button type="button" data-filter="used">استفاده‌شده</button><button type="button" data-filter="rejected">ردشده</button><button type="button" data-filter="">همه</button></div><a id="exportCsvLink" href="/api/admin/topics-export?status=approved" class="admin-topics-export">خروجی CSV</a></div>
            <div class="admin-table-wrap"><table class="admin-table admin-table--topics"><thead><tr><th>عنوان</th><th>دوره / دسته</th><th>نوع</th><th>قصد جستجو</th><th>امتیاز</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody id="topicsList"><tr><td colspan="7" class="admin-table-empty">در حال بارگذاری موضوعات...</td></tr></tbody></table></div>
          </section>
        </div>
      </section>
    </div></main>
  </div>
</MainLayout>

<script>
// @ts-nocheck
  import "../../scripts/admin/topics.js";

  const tabs = document.querySelectorAll("[data-strategy-tab]");
  const panels = {
    strategy: document.querySelector("#strategy-panel"),
    topics: document.querySelector("#topics-panel")
  };

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const selected = tab.dataset.strategyTab;
      tabs.forEach((item) => {
        const active = item.dataset.strategyTab === selected;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
      });
      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        const active = key === selected;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
    });
  });

  document.getElementById("ahrefsSyncButton")?.addEventListener("click", async () => {
    const button = document.getElementById("ahrefsSyncButton");
    if (!button) return;
    button.setAttribute("disabled", "true");
    button.textContent = "در حال همگام‌سازی…";
    try {
      const response = await fetch("/api/admin/ahrefs", { method: "POST" });
      const data = await response.json();
      if (!response.ok) throw new Error(data?.message || "Ahrefs sync failed");
      window.location.reload();
    } catch (error) {
      button.removeAttribute("disabled");
      button.textContent = "خطا؛ دوباره تلاش کنید";
      console.error(error);
    }
  });

  document.getElementById("gscSyncButton")?.addEventListener("click", async () => {
    const button = document.getElementById("gscSyncButton");
    if (!button) return;
    button.setAttribute("disabled", "true");
    button.textContent = "در حال همگام‌سازی…";
    try {
      const response = await fetch("/api/admin/gsc", { method: "POST" });
      const data = await response.json();
      if (!response.ok) throw new Error(data?.message || "GSC sync failed");
      window.location.reload();
    } catch (error) {
      button.removeAttribute("disabled");
      button.textContent = "خطا؛ دوباره تلاش کنید";
      console.error(error);
    }
  });
</script>

<style>
