---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
import { getPublishedPosts } from "../../server/blog";
import { courses } from "../../data/courses.js";
import { buildContentClusterReport, resolveSite } from "../../seo/index.js";

const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
if (session.role !== ROLES.ADMIN) return Astro.redirect("/admin");

const posts = await getPublishedPosts();
const site = resolveSite();
const report = buildContentClusterReport(posts, { courses, siteUrl: site.url });
const strategy = report.strategy;
const briefs = strategy.briefs;
const topicCounts = new Map();
for (const brief of briefs) topicCounts.set(brief.topicName, (topicCounts.get(brief.topicName) ?? 0) + 1);
---

<MainLayout title="استراتژی محتوا | پنل مدیریت آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="content-strategy" />
    <main class="admin-main">
      <div class="admin-shell strategy-shell">
        <section class="admin-hero" aria-label="استراتژی محتوا">
          <span class="admin-hero-label">SEO / GEO Engine v2</span>
          <h1>استراتژی محتوا</h1>
          <span class="admin-hero-description">فرصت‌های محتوایی بر اساس شکاف Topic و Search Intent، اولویت‌بندی و آماده تولید شده‌اند.</span>
        </section>

        <div class="strategy-stats">
          <div class="strategy-stat"><strong>{strategy.briefCount}</strong><span>فرصت محتوا</span></div>
          <div class="strategy-stat strategy-stat-hot"><strong>{strategy.highPriorityCount}</strong><span>اولویت بالا</span></div>
          <div class="strategy-stat"><strong>{report.topicCount}</strong><span>Topic فعال</span></div>
          <div class="strategy-stat"><strong>{report.articleCount}</strong><span>مقاله منتشرشده</span></div>
        </div>

        <section class="strategy-section">
          <div class="strategy-section-head">
            <div>
              <span class="admin-hero-label">Production Queue</span>
              <h2>صف تولید محتوا</h2>
            </div>
            <span class="strategy-count">{briefs.length} فرصت</span>
          </div>

          {briefs.length === 0 ? (
            <div class="strategy-empty">
              <strong>در حال حاضر شکاف محتوایی شناسایی نشده است.</strong>
              <span>با انتشار مقاله‌های جدید، این گزارش به‌صورت خودکار به‌روزرسانی می‌شود.</span>
            </div>
          ) : (
            <div class="strategy-list">
              {briefs.map((brief, index) => (
                <article class="strategy-card">
                  <div class="strategy-rank">{index + 1}</div>
                  <div class="strategy-card-main">
                    <div class="strategy-card-top">
                      <div class="strategy-badges">
                        <span class:list={["strategy-priority", brief.priority >= 85 && "high"]}>امتیاز {brief.priority}</span>
                        <span class="strategy-intent">{brief.searchIntent}</span>
                        <span class="strategy-topic">{brief.topicName}</span>
                      </div>
                      <span class="strategy-coverage">{brief.articleCount} مقاله موجود</span>
                    </div>

                    <h3>{brief.title}</h3>
                    <p>{brief.rationale}</p>

                    <div class="strategy-meta">
                      <div><strong>Entity هدف:</strong> {brief.targetEntity.name}</div>
                      {brief.course && <div><strong>Course:</strong> {brief.course.title}</div>}
                      <div><strong>Slug پیشنهادی:</strong> <code>{brief.suggestedSlug}</code></div>
                    </div>

                    <div class="strategy-queries">
                      <strong>Query angles</strong>
                      <div>
                        {brief.queryAngles.map((query) => <span>{query}</span>)}
                      </div>
                    </div>

                    <div class="strategy-links">
                      <strong>Internal links</strong>
                      <div>
                        {brief.recommendedLinks.map((url) => <a href={url}>{url.replace(site.url, "") || "/"}</a>)}
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        {topicCounts.size > 0 && (
          <section class="strategy-section">
            <div class="strategy-section-head">
              <div>
                <span class="admin-hero-label">Coverage Map</span>
                <h2>توزیع فرصت‌ها بر اساس Topic</h2>
              </div>
            </div>
            <div class="strategy-topic-grid">
              {[...topicCounts.entries()].sort((a, b) => b[1] - a[1]).map(([topic, count]) => (
                <div class="strategy-topic-item"><span>{topic}</span><strong>{count}</strong></div>
              ))}
            </div>
          </section>
        )}
      </div>
    </main>
  </div>
</MainLayout>

<style>
  .strategy-shell { max-width: 1280px; }
  .strategy-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin:24px 0; }
  .strategy-stat { padding:20px; border:1px solid var(--border); border-radius:16px; background:var(--surface); display:flex; flex-direction:column; gap:6px; }
  .strategy-stat strong { font-size:30px; line-height:1; }
  .strategy-stat span { color:var(--muted); font-size:13px; }
  .strategy-stat-hot { border-color:rgba(212,175,55,.45); }
  .strategy-section { margin-top:28px; }
  .strategy-section-head { display:flex; align-items:end; justify-content:space-between; gap:16px; margin-bottom:14px; }
  .strategy-section-head h2 { margin:4px 0 0; }
  .strategy-count { color:var(--muted); font-size:13px; }
  .strategy-list { display:grid; gap:14px; }
  .strategy-card { display:grid; grid-template-columns:42px minmax(0,1fr); gap:14px; padding:18px; border:1px solid var(--border); border-radius:16px; background:var(--surface); }
  .strategy-rank { width:42px; height:42px; border-radius:12px; display:grid; place-items:center; background:var(--background); border:1px solid var(--border); font-weight:800; }
  .strategy-card-top { display:flex; justify-content:space-between; gap:12px; align-items:center; }
  .strategy-badges { display:flex; flex-wrap:wrap; gap:7px; }
  .strategy-badges span { border:1px solid var(--border); border-radius:999px; padding:5px 9px; font-size:11px; }
  .strategy-priority.high { border-color:rgba(212,175,55,.6); }
  .strategy-coverage { color:var(--muted); font-size:12px; white-space:nowrap; }
  .strategy-card h3 { margin:13px 0 7px; font-size:19px; }
  .strategy-card p { margin:0; color:var(--muted); line-height:1.8; }
  .strategy-meta { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:14px; font-size:12px; color:var(--muted); }
  .strategy-meta strong, .strategy-queries strong, .strategy-links strong { color:var(--text); }
  code { direction:ltr; unicode-bidi:plaintext; }
  .strategy-queries, .strategy-links { margin-top:13px; display:grid; gap:8px; font-size:12px; }
  .strategy-queries > div, .strategy-links > div { display:flex; flex-wrap:wrap; gap:7px; }
  .strategy-queries span { padding:6px 9px; border-radius:9px; background:var(--background); border:1px solid var(--border); }
  .strategy-links a { padding:6px 9px; border-radius:9px; border:1px solid var(--border); text-decoration:none; overflow-wrap:anywhere; }
  .strategy-empty { padding:28px; border:1px dashed var(--border); border-radius:16px; display:grid; gap:8px; color:var(--muted); }
  .strategy-topic-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .strategy-topic-item { display:flex; justify-content:space-between; gap:10px; padding:13px 15px; border:1px solid var(--border); border-radius:12px; background:var(--surface); }
  @media (max-width: 900px) { .strategy-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .strategy-topic-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width: 620px) { .strategy-stats,.strategy-topic-grid { grid-template-columns:1fr; } .strategy-card { grid-template-columns:1fr; } .strategy-card-top { align-items:flex-start; flex-direction:column; } }
</style>
