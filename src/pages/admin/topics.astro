---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/posts.css";
import "../../styles/admin/topics.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";

const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
if (session.role !== ROLES.ADMIN) return Astro.redirect("/admin");
---
<MainLayout title="مدیریت موضوعات | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="topics" />
    <main class="admin-main">
      <div class="admin-shell" data-admin-topics>
        <section class="admin-hero">
          <p>موتور تولید عنوان</p>
          <h1>صف موضوعات مقالات وبلاگ</h1>
          <p>موضوعات از روی دوره‌های واقعی سایت ساخته، امتیازدهی و از تکراری حذف می‌شوند. مقاله‌ی نهایی را Claude روی موضوعِ تأییدشده می‌نویسد.</p>
        </section>

        <section class="admin-ai-trigger">
          <div>
            <strong>تولید موضوعات جدید</strong>
            <span>کاندیدای عنوان از روی دوره‌های فعال ساخته می‌شود، امتیاز می‌گیرد و موارد بالای آستانه به‌طور خودکار تأیید می‌شوند.</span>
          </div>
          <button type="button" id="generateTopicsButton">تولید موضوعات جدید</button>
        </section>
        <p id="generateStatus" role="status" class="admin-ai-status"></p>

        <section class="admin-panel admin-panel--topics">
          <div class="admin-topics-toolbar">
            <div class="admin-topics-filters" role="tablist" aria-label="فیلتر وضعیت">
              <button type="button" class="is-active" data-filter="approved">تأییدشده</button>
              <button type="button" data-filter="candidate">در انتظار بررسی</button>
              <button type="button" data-filter="used">استفاده‌شده</button>
              <button type="button" data-filter="rejected">ردشده</button>
              <button type="button" data-filter="">همه</button>
            </div>
            <a id="exportCsvLink" href="/api/admin/topics-export" class="admin-topics-export">خروجی CSV</a>
          </div>

          <div class="admin-table-wrap">
            <table class="admin-table admin-table--topics">
              <thead>
                <tr>
                  <th>عنوان</th>
                  <th>دوره / دسته</th>
                  <th>نوع</th>
                  <th>قصد جستجو</th>
                  <th>امتیاز</th>
                  <th>وضعیت</th>
                  <th>عملیات</th>
                </tr>
              </thead>
              <tbody id="topicsList">
                <tr><td colspan="7" class="admin-table-empty">در حال بارگذاری موضوعات...</td></tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>
  </div>
  <script>
    import "../../scripts/admin/topics.js";
  </script>
</MainLayout>
