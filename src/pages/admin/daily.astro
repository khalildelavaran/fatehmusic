---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import "../../styles/admin/daily-dashboard.css";
import "../../styles/admin/daily-assistant.css";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
Astro.response.headers.set("Cache-Control", "no-store");
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="daily" />
    <main class="admin-main">
      <div class="admin-shell daily-shell" dir="rtl" id="dailyDashboardRoot">
        <header class="admin-hero daily-topbar" aria-label="داشبورد روزانه">
          <div class="daily-topbar-side daily-topbar-title">
            <span class="admin-hero-label">عملیات آموزشگاه</span>
            <h1>داشبورد روزانه</h1>
          </div>
          <div class="daily-clock" aria-live="polite">
            <div id="dateLabel" class="daily-date" dir="rtl"></div>
            <div id="timeLabel" class="daily-time" dir="ltr"></div>
          </div>
          <div class="date-nav" aria-label="تغییر روز">
            <button id="prev" type="button">روز قبل</button>
            <button id="today" type="button">امروز</button>
            <button id="next" type="button">روز بعد</button>
            <button id="refresh" type="button" aria-label="بازخوانی">بازخوانی</button>
          </div>
        </header>

        <div id="lastSync" class="daily-sync" aria-live="polite"></div>
        <div id="error" class="daily-error" role="alert" hidden></div>

        <section id="summary" class="daily-summary" aria-label="خلاصه امروز"></section>

        <section id="dailyAssistant" class="daily-ai-panel" aria-label="دستیار هوشمند منشی">
          <div class="daily-ai-head">
            <div>
              <strong>دستیار هوشمند منشی</strong>
              <span>برنامه همین روز را بررسی می‌کند و برای نظم کلاس‌ها، تداخل‌ها و جابه‌جایی‌ها پیشنهاد می‌دهد.</span>
            </div>
          </div>
          <form class="daily-ai-form">
            <textarea maxlength="1200" placeholder="مثلاً: کلاس‌هایی که تداخل دارند را پیدا کن و بهترین راه‌حل را پیشنهاد بده."></textarea>
            <button type="submit">پرسش از دستیار</button>
          </form>
          <div class="daily-ai-suggestions" aria-label="پرسش‌های پیشنهادی">
            <button type="button" data-question="کلاس‌هایی که تداخل استاد یا اتاق دارند را پیدا کن.">تداخل‌ها را پیدا کن</button>
            <button type="button" data-question="وضعیت کلی امروز را برای منشی خلاصه کن.">خلاصه امروز</button>
            <button type="button" data-question="کلاس‌هایی که نیاز به پیگیری منشی دارند را مشخص کن.">نیازمند پیگیری</button>
          </div>
          <div class="daily-ai-output" data-assistant-output aria-live="polite">هنوز پرسشی ارسال نشده است.</div>

          <div class="daily-planner-box" aria-label="پیشنهاد جابه‌جایی جلسه">
            <div class="daily-planner-head">
              <div>
                <strong>پیشنهاد زمان جایگزین</strong>
                <span>گزینه‌ها توسط قواعد زمان‌بندی سایت بررسی می‌شوند؛ قبل از اعمال، دوباره اعتبارسنجی می‌شوند.</span>
              </div>
            </div>
            <div class="daily-planner-controls">
              <select id="dailyPlannerSession" aria-label="انتخاب جلسه"></select>
              <button id="dailyPlannerFind" type="button">پیدا کردن گزینه‌ها</button>
            </div>
            <div id="dailyPlannerResults" class="daily-planner-results" aria-live="polite"></div>
            <div id="dailyPlannerStatus" class="daily-planner-status"></div>
          </div>
        </section>

        <section id="timeline" class="dd-timeline" aria-label="نوار زمانی جلسات امروز"></section>
        <section id="sessionsPanel" class="dd-sessions" aria-label="فهرست جلسات و هنرجویان امروز"></section>

        <div id="quickPaymentModal" class="dd-modal" hidden aria-hidden="true">
          <div class="dd-modal-backdrop" data-action="close-modal"></div>
          <div class="dd-modal-box" role="dialog" aria-modal="true" aria-labelledby="quickPaymentTitle">
            <div class="dd-modal-head">
              <strong id="quickPaymentTitle">ثبت پرداخت سریع</strong>
              <button type="button" class="dd-modal-close" data-action="close-modal" aria-label="بستن">×</button>
            </div>
            <div id="quickPaymentBody" class="dd-modal-body"></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</MainLayout>
<script src="../../scripts/admin/daily/daily-dashboard.js"></script>
<script src="../../scripts/admin/daily/daily-assistant.js"></script>
<script src="../../scripts/admin/daily/daily-auto-planner.js"></script>
<script>
  const assistant = document.querySelector("#dailyAssistant");
  const input = assistant?.querySelector("textarea");
  assistant?.querySelectorAll("[data-question]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!input) return;
      input.value = button.dataset.question || "";
      input.focus();
    });
  });

  const plannerSelect = document.querySelector("#dailyPlannerSession");
  const plannerFind = document.querySelector("#dailyPlannerFind");
  const plannerResults = document.querySelector("#dailyPlannerResults");
  const plannerStatus = document.querySelector("#dailyPlannerStatus");
  const dashboardRoot = document.querySelector("#dailyDashboardRoot");

  function refreshPlannerSessions() {
    if (!plannerSelect) return;
    const seen = new Set();
    const options = [];
    document.querySelectorAll("#sessionsPanel [data-session-id]").forEach((node) => {
      const id = String(node.dataset.sessionId || "");
      if (!id || seen.has(id)) return;
      seen.add(id);
      const text = (node.textContent || "").replace(/\s+/g, " ").trim();
      options.push(`<option value="${id}">${id} — ${text.slice(0, 90)}</option>`);
    });
    plannerSelect.innerHTML = options.length
      ? options.join("")
      : '<option value="">جلسه‌ای برای این روز وجود ندارد</option>';
    plannerSelect.disabled = !options.length;
    plannerFind.disabled = !options.length;
  }

  function escPlanner(value) {
    const el = document.createElement("div");
    el.textContent = String(value ?? "");
    return el.innerHTML;
  }

  async function loadPlannerSuggestions() {
    const sessionId = plannerSelect?.value;
    if (!sessionId) return;
    plannerFind.disabled = true;
    plannerResults.innerHTML = "";
    plannerStatus.textContent = "در حال بررسی ظرفیت مدرس، هنرجوها و اتاق‌ها…";
    try {
      const response = await fetch(`/api/admin/daily-planner/suggestions?sessionId=${encodeURIComponent(sessionId)}&limit=8`, { credentials: "same-origin", headers: { Accept: "application/json" } });
      const data = await response.json().catch(() => null);
      if (!response.ok || !data?.success) throw new Error(data?.message || "دریافت پیشنهادها ناموفق بود.");
      if (!data.candidates?.length) {
        plannerStatus.textContent = "برای این جلسه در محدوده زمانی فعلی گزینه آزاد پیدا نشد.";
        return;
      }
      plannerStatus.textContent = `برای «${data.session.class_name}» ${data.candidates.length} گزینه پیدا شد.`;
      plannerResults.innerHTML = data.candidates.map((candidate) => `
        <div class="daily-planner-candidate">
          <div>
            <strong>${escPlanner(candidate.startTime)} — ${escPlanner(candidate.endTime)}</strong>
            <small>${escPlanner(candidate.roomName ? `اتاق ${candidate.roomName}` : "بدون اتاق")} · ${escPlanner((candidate.reasons || []).join(" · "))}</small>
          </div>
          <button type="button" data-planner-apply data-session-id="${escPlanner(sessionId)}" data-session-date="${escPlanner(data.session.session_date)}" data-start="${escPlanner(candidate.startTime)}" data-end="${escPlanner(candidate.endTime)}" data-room="${candidate.roomId ?? ""}">تأیید و اعمال</button>
        </div>
      `).join("");
    } catch (error) {
      plannerStatus.textContent = error instanceof Error ? error.message : String(error);
    } finally {
      plannerFind.disabled = false;
    }
  }

  async function applyPlannerCandidate(button) {
    button.disabled = true;
    plannerStatus.textContent = "در حال اعتبارسنجی نهایی و اعمال تغییر…";
    try {
      const response = await fetch("/api/admin/daily-planner/suggestions", {
        method: "POST", credentials: "same-origin",
        headers: { "content-type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          sessionId: Number(button.dataset.sessionId),
          sessionDate: button.dataset.sessionDate,
          startTime: button.dataset.start,
          endTime: button.dataset.end,
          roomId: button.dataset.room || null,
        }),
      });
      const data = await response.json().catch(() => null);
      if (!response.ok || !data?.success) throw new Error(data?.message || "اعمال تغییر ناموفق بود.");
      plannerStatus.textContent = data.message || "تغییر برنامه اعمال شد.";
      plannerResults.innerHTML = "";
      document.querySelector("#refresh")?.click();
      setTimeout(refreshPlannerSessions, 300);
    } catch (error) {
      plannerStatus.textContent = error instanceof Error ? error.message : String(error);
      button.disabled = false;
    }
  }

  plannerFind?.addEventListener("click", loadPlannerSuggestions);
  plannerResults?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-planner-apply]");
    if (button) applyPlannerCandidate(button);
  });
  plannerSelect?.addEventListener("focus", refreshPlannerSessions);
  document.querySelectorAll("#prev,#next,#today,#refresh").forEach((button) => {
    button.addEventListener("click", () => setTimeout(refreshPlannerSessions, 350));
  });
  setTimeout(refreshPlannerSessions, 400);
</script>