---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="daily" />
    <main class="admin-main">
      <div class="admin-shell daily-shell" dir="rtl">
        <header class="admin-hero daily-topbar" aria-label="داشبورد روزانه">
          <div class="daily-topbar-side daily-topbar-title">
            <span class="admin-hero-label">عملیات آموزشگاه</span>
            <h1>داشبورد روزانه</h1>
          </div>
          <div class="daily-clock" aria-live="polite">
            <div id="dateLabel" class="daily-date" dir="rtl"></div>
            <div id="timeLabel" class="daily-time" dir="ltr"></div>
          </div>
          <div class="date-nav" aria-label="تغییر روز">
            <button id="prev" type="button">روز قبل</button>
            <button id="today" type="button">امروز</button>
            <button id="next" type="button">روز بعد</button>
          </div>
        </header>
        <section id="summary" class="daily-summary"></section>
        <div id="error" class="daily-error" hidden></div>
        <div id="renewalResult" class="renewal-result" hidden aria-live="polite"></div>
        <section id="sessions" class="daily-sessions" aria-live="polite"></section>
      </div>
    </main>
  </div>
</MainLayout>
<style>
.daily-shell{max-width:none;margin:0;padding:32px clamp(18px,3vw,36px) 64px}
.daily-topbar{margin-bottom:24px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px}
.daily-topbar-title{justify-self:start;display:flex;align-items:center;gap:14px;min-width:0}
.daily-topbar-title h1{margin:0;color:var(--text);font-size:18px;white-space:nowrap}
.daily-clock{justify-self:center;text-align:center;line-height:1.2}
.daily-date{display:flex;align-items:center;justify-content:center;gap:8px;font-size:20px;font-weight:800;color:var(--text);white-space:nowrap;direction:rtl;unicode-bidi:isolate}
.daily-date-part{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;direction:rtl;unicode-bidi:isolate}
.daily-date-day{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:2px solid var(--gold-light);border-radius:50%;color:var(--gold-light);font-size:22px;font-weight:900;line-height:1;font-variant-numeric:tabular-nums;box-sizing:border-box;flex:0 0 44px;direction:ltr;unicode-bidi:isolate}
.daily-time{margin-top:4px;font-size:27px;font-weight:800;letter-spacing:.04em;color:var(--gold-light);white-space:nowrap;font-variant-numeric:tabular-nums}
.daily-topbar>.date-nav{justify-self:end;display:flex;gap:8px;flex:0 0 auto}
.date-nav button,.attendance-action,.teacher-action,.payment-toggle,.payment-submit,.renewal-button{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:9px 13px;cursor:pointer;font-family:inherit}
.date-nav button:hover,.attendance-action:hover,.teacher-action:hover,.payment-toggle:hover,.payment-submit:hover,.renewal-button:hover{border-color:var(--primary)}
.daily-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
.daily-summary .stat{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:15px}
.daily-summary strong{display:block;font-size:24px}
.daily-summary .warning{border-color:#b89500}
.session{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:16px}
.session-head{display:flex;justify-content:space-between;gap:12px;align-items:center}
.session-title{display:flex;gap:12px;align-items:center}.session-title strong{font-size:18px}.session-title span,.session-meta{opacity:.7}
.calendar-warning{margin:12px 0;padding:9px 12px;border-radius:10px;background:rgba(212,175,55,.10)}
.teacher-row{display:flex;align-items:center;gap:10px;margin:15px 0;padding-top:12px;border-top:1px solid var(--border)}
.students{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}
.student{border:1px solid var(--border);border-radius:12px;padding:12px}
.student-top{display:flex;align-items:center;gap:9px}.light{width:11px;height:11px;border-radius:50%;display:inline-block;border:1px solid rgba(255,255,255,.35)}
.green{background:#25a244}.red{background:#d62828}.yellow{background:#e0b100}.white{background:#fff}.student-name{font-weight:700}
.student-meta{display:flex;justify-content:space-between;gap:8px;margin:9px 0;font-size:12px;opacity:.75}
.attendance-actions{display:flex;gap:5px;flex-wrap:wrap}.attendance-action.active{border-color:var(--primary);box-shadow:0 0 0 1px var(--primary)}
.finance-box{margin-top:12px;padding-top:12px;border-top:1px solid var(--border)}
.finance-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.finance-title strong{font-size:13px}.finance-status{font-size:12px;padding:4px 8px;border-radius:999px;border:1px solid var(--border)}
.finance-status.paid{border-color:#2f8f46}.finance-status.partial{border-color:#b89500}.finance-status.overdue{border-color:#a33;color:#d77}.finance-status.pending{border-color:#b89500}.finance-status.none{opacity:.65}
.finance-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
.finance-item{padding:8px 9px;border-radius:9px;background:rgba(255,255,255,.03)}.finance-item span{display:block;font-size:11px;opacity:.65;margin-bottom:3px}.finance-item b{font-size:13px}
.finance-balance b{color:var(--gold-light)}
.payment-form{display:grid;grid-template-columns:1fr 130px 1fr auto;gap:7px;align-items:center;margin-top:8px}
.payment-form input,.payment-form select,.renewal-form input{width:100%;box-sizing:border-box;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:9px;padding:9px;font-family:inherit}
.payment-form button{white-space:nowrap}.payment-message{font-size:12px;margin-top:6px}.payment-message.error{color:#e58}.payment-message.success{color:#7acb8c}
.renewal-box{margin-top:10px;padding-top:10px;border-top:1px dashed var(--border)}
.renewal-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.renewal-head strong{font-size:13px}.renewal-button{border-color:#b89500}
.renewal-form{display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center;margin-top:8px}
.renewal-form label{font-size:11px;opacity:.7;grid-column:1/-1}.renewal-form button{white-space:nowrap}
.renewal-note{font-size:11px;opacity:.65;margin-top:6px}
.renewal-result{padding:12px 14px;border:1px solid #2f8f46;border-radius:12px;margin-bottom:15px;background:rgba(47,143,70,.08)}
.renewal-result.error{border-color:#a33;background:rgba(163,51,51,.08)}
.renewal-result strong{display:block;margin-bottom:5px}.renewal-result-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px}.renewal-result-grid span{display:block;font-size:11px;opacity:.65}.renewal-result-grid b{font-size:13px}
.daily-error{padding:12px;border:1px solid #a33;border-radius:10px;margin-bottom:15px}
.empty{opacity:.65;padding:30px;text-align:center}.empty-title{font-size:16px;font-weight:700;opacity:.9;margin-bottom:8px}.empty-note{font-size:13px;opacity:.7}
@media(max-width:900px){.daily-topbar{grid-template-columns:1fr}.daily-topbar-title,.daily-clock,.daily-topbar>.date-nav{justify-self:stretch}.daily-clock{text-align:center}.daily-topbar-title{justify-content:center}.daily-topbar>.date-nav{justify-content:center}.daily-date{font-size:19px}.daily-time{font-size:25px}.payment-form{grid-template-columns:1fr 1fr}.payment-form button{grid-column:1/-1}.renewal-result-grid{grid-template-columns:1fr 1fr}}
@media(max-width:800px){.daily-shell{padding:16px}.daily-summary{grid-template-columns:repeat(2,1fr)}.session-head{flex-direction:column;align-items:stretch}.students{grid-template-columns:1fr}.finance-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.finance-grid{grid-template-columns:1fr}.renewal-form{grid-template-columns:1fr}.renewal-form button{width:100%}.renewal-result-grid{grid-template-columns:1fr}}
</style>
<script>
const state={date:localDateString()};
const $=s=>document.querySelector(s);
const labels={pending:["yellow","ثبت نشده"],present:["green","حاضر"],absent:["red","غایب"],excused:["white","مرخصی"]};
const teacherLabels={pending:"ثبت نشده",present:"حاضر",absent:"غایب"};
const financeLabels={paid:"تسویه شده",partial:"پرداخت ناقص",overdue:"معوق",pending:"پرداخت نشده",none:"صورتحساب ندارد"};
let clockTimer;
function localDateString(date=new Date()){const y=date.getFullYear();const m=String(date.getMonth()+1).padStart(2,"0");const d=String(date.getDate()).padStart(2,"0");return `${y}-${m}-${d}`}
function esc(v){const d=document.createElement("div");d.textContent=String(v??"");return d.innerHTML}
function formatNumber(value){return Number(value??0).toLocaleString("fa-IR")}
function formatShamsiDate(value){const [year,month,day]=String(value).split("-").map(Number);const date=new Date(year,month-1,day,12,0,0);const parts=new Intl.DateTimeFormat("fa-IR",{weekday:"long",year:"numeric",month:"long",day:"numeric"}).formatToParts(date);const yearPart=parts.find(part=>part.type==="year")?.value??"";const monthPart=parts.find(part=>part.type==="month")?.value??"";const dayPart=parts.find(part=>part.type==="day")?.value??"";const weekdayPart=parts.find(part=>part.type==="weekday")?.value??"";return `<span class="daily-date-part">${esc(weekdayPart)}</span><span class="daily-date-day">${esc(dayPart)}</span><span class="daily-date-part">${esc(monthPart)}</span><span class="daily-date-part">${esc(yearPart)}</span>`}
function startDateInputValue(){return state.date}
function renderClock(){const now=new Date();$("#timeLabel").textContent=new Intl.DateTimeFormat("fa-IR",{hour:"2-digit",minute:"2-digit",second:"2-digit",hour12:false}).format(now)}
function startClock(){renderClock();clearInterval(clockTimer);clockTimer=setInterval(renderClock,1000)}
function renderFinance(st){const invoiceId=Number(st.invoiceId||0);const status=st.financialStatus||"none";const total=Number(st.invoiceAmount||0);const paid=Number(st.paidAmount||0);const balance=Number(st.balance||0);const canPay=invoiceId>0&&balance>0;return `<div class="finance-box"><div class="finance-title"><strong>امور مالی و شهریه</strong><span class="finance-status ${status}">${esc(financeLabels[status]||status)}</span></div><div class="finance-grid"><div class="finance-item"><span>صورتحساب</span><b>${total?formatNumber(total):"—"}</b></div><div class="finance-item"><span>پرداخت‌شده</span><b>${paid?formatNumber(paid):"—"}</b></div><div class="finance-item finance-balance"><span>مانده</span><b>${balance?formatNumber(balance):"تسویه"}</b></div></div>${st.tuitionDueDate?`<div class="student-meta"><span>سررسید</span><span>${esc(st.tuitionDueDate)}</span></div>`:""}${canPay?`<button class="payment-toggle" type="button" data-payment-toggle="${invoiceId}">ثبت پرداخت</button><div class="payment-form" data-payment-form="${invoiceId}" hidden><input data-payment-amount type="number" min="1" max="${balance}" step="1" placeholder="مبلغ پرداخت" inputmode="numeric"><select data-payment-method><option value="">روش پرداخت</option><option value="cash">نقدی</option><option value="card">کارتخوان</option><option value="transfer">کارت‌به‌کارت / انتقال</option><option value="other">سایر</option></select><input data-payment-reference placeholder="شماره پیگیری (اختیاری)"><button class="payment-submit" type="button" data-payment-submit="${invoiceId}">ثبت</button><div class="payment-message" data-payment-message></div></div>`:""}</div>`}
function renderRenewal(st){if(!st.renewalReady)return "";const billing=st.billingType==="monthly"?"ماهانه":`${formatNumber(st.plannedSessions)} جلسه‌ای`;return `<div class="renewal-box"><div class="renewal-head"><strong>ترم ${st.termNumber??"فعلی"}</strong><button class="renewal-button" type="button" data-renewal-toggle="${st.enrollmentId}">تمدید ترم</button></div><div class="renewal-form" data-renewal-form="${st.enrollmentId}" hidden><label>تاریخ شروع ترم جدید</label><input data-renewal-date type="date" value="${esc(startDateInputValue())}"><button class="renewal-button" type="button" data-renewal-submit="${st.enrollmentId}">تأیید تمدید</button></div><div class="renewal-note">تنظیمات ترم جدید: ${esc(billing)} · شهریه از تنظیمات فعلی کلاس snapshot می‌شود.</div></div>`}
function render(data){const sessions=data.sessions??[];const students=sessions.flatMap(s=>s.students??[]);$("#dateLabel").innerHTML=formatShamsiDate(data.date);const counts={pending:0,present:0,absent:0,excused:0};students.forEach(s=>counts[s.attendanceStatus]=(counts[s.attendanceStatus]??0)+1);$("#summary").innerHTML=`<div class="stat">جلسه<strong>${sessions.length}</strong></div><div class="stat">هنرجو<strong>${students.length}</strong></div><div class="stat">غایب<strong>${counts.absent}</strong></div><div class="stat warning">ثبت‌نشده<strong>${counts.pending}</strong></div>`;$("#sessions").innerHTML=sessions.length?sessions.map(s=>{const teacher=s.teacher_attendance_status??"pending";return `<article class="session"><header class="session-head"><div class="session-title"><strong>${esc(s.class_title)}</strong><span>${esc(s.start_time)} — ${esc(s.end_time)}</span></div><div class="session-meta">${esc(s.instructor_name)} · ${esc(s.room_name||"بدون اتاق")}${s.type==='makeup'?" · جبرانی":""}</div></header><div class="teacher-row"><b>حضور استاد:</b><span>${esc(teacherLabels[teacher]||teacher)}</span><button class="teacher-action" type="button" data-session="${s.id}" data-instructor="${s.instructor_id}" data-status="present">حاضر</button><button class="teacher-action" type="button" data-session="${s.id}" data-instructor="${s.instructor_id}" data-status="absent">غایب</button></div><div class="students">${(s.students??[]).map(st=>{const [color,label]=labels[st.attendanceStatus]||labels.pending;return `<article class="student"><div class="student-top"><span class="light ${color}" title="${label}"></span><span class="student-name">${esc(st.studentName)}</span></div><div class="student-meta"><span>گذرانده: ${st.consumedSessions}</span><span>باقی: ${st.remainingSessions??"—"}</span></div>${st.tuitionWarning?`<div class="calendar-warning">${st.tuitionDueDate?`هشدار شهریه: ${esc(st.tuitionDueDate)}`:"هشدار تمدید ترم"}</div>`:""}${renderFinance(st)}${renderRenewal(st)}<div class="attendance-actions">${["present","absent","excused"].map(x=>`<button class="attendance-action ${x===st.attendanceStatus?"active":""}" type="button" data-enrollment="${st.enrollmentSessionId}" data-status="${x}">${labels[x][1]}</button>`).join("")}</div></article>`}).join("")||`<div class="empty"><div class="empty-title">جلسه ثبت شده، اما هنرجوی فعالی برای این جلسه پیدا نشد.</div><div class="empty-note">ثبت‌نام هنرجویان کلاس را بررسی کنید.</div></div>`}</div></article>`}).join(""):`<div class="empty"><div class="empty-title">برای این روز جلسه‌ای ثبت نشده است.</div><div class="empty-note">برای نمایش جلسه، برنامه هفتگی یا جلسه واقعی کلاس را بررسی کنید.</div></div>`}
async function responseJson(response){const text=await response.text();if(!text.trim())throw Error(`پاسخ خالی از سرور دریافت شد (${response.status})`);try{return JSON.parse(text)}catch{throw Error(`پاسخ JSON نامعتبر از سرور دریافت شد (${response.status})`)}}
async function load(){try{$("#error").hidden=true;const r=await fetch(`/api/admin/daily-dashboard?date=${encodeURIComponent(state.date)}`,{credentials:"same-origin",headers:{Accept:"application/json"}});const d=await responseJson(r);if(!r.ok||!d.success)throw Error(d.message||`خطا در دریافت داشبورد (${r.status})`);render(d)}catch(e){$("#error").textContent=e instanceof Error?e.message:"خطا در دریافت داشبورد";$("#error").hidden=false}}
async function put(url,body){const r=await fetch(url,{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json",Accept:"application/json"},body:JSON.stringify(body)});const d=await responseJson(r);if(!r.ok||!d.success)throw Error(d.message||`ثبت عملیات ناموفق بود (${r.status})`);await load()}
async function recordPayment(button){const invoiceId=Number(button.dataset.paymentSubmit);const form=document.querySelector(`[data-payment-form="${invoiceId}"]`);if(!form)return;const amountInput=form.querySelector("[data-payment-amount]");const methodInput=form.querySelector("[data-payment-method]");const referenceInput=form.querySelector("[data-payment-reference]");const message=form.querySelector("[data-payment-message]");const amount=Number(amountInput?.value);const method=methodInput?.value||"";const reference=referenceInput?.value?.trim()||"";if(message){message.textContent="";message.className="payment-message"}if(!Number.isInteger(amount)||amount<=0){if(message){message.textContent="مبلغ پرداخت را وارد کنید.";message.className="payment-message error"}return}button.disabled=true;try{const r=await fetch("/api/admin/payments",{method:"POST",credentials:"same-origin",headers:{"content-type":"application/json",Accept:"application/json"},body:JSON.stringify({invoiceId,amount,method,reference})});const d=await responseJson(r);if(!r.ok||!d.success)throw Error(d.message||`ثبت پرداخت ناموفق بود (${r.status})`);await load()}catch(err){if(message){message.textContent=err instanceof Error?err.message:"ثبت پرداخت ناموفق بود";message.className="payment-message error"}}finally{button.disabled=false}}
async function renewTerm(button){const enrollmentId=Number(button.dataset.renewalSubmit);const form=document.querySelector(`[data-renewal-form="${enrollmentId}"]`);const dateInput=form?.querySelector("[data-renewal-date]");const startDate=dateInput?.value||"";if(!/^\d{4}-\d{2}-\d{2}$/.test(startDate)){showRenewalResult("تاریخ شروع ترم جدید را وارد کنید.",true);return}if(!window.confirm("ترم فعلی بسته و ترم جدید ایجاد می‌شود. بدهی‌ها و پرداخت‌های ترم قبلی حفظ می‌شوند. ادامه می‌دهید؟"))return;button.disabled=true;try{const r=await fetch("/api/admin/enrollment-term-renew",{method:"POST",credentials:"same-origin",headers:{"content-type":"application/json",Accept:"application/json"},body:JSON.stringify({enrollmentId,startDate})});const d=await responseJson(r);if(!r.ok||!d.success)throw Error(d.message||`تمدید ترم ناموفق بود (${r.status})`);showRenewalResult(`تمدید ترم برای هنرجو با موفقیت انجام شد.`,false,d);await load()}catch(err){showRenewalResult(err instanceof Error?err.message:"تمدید ترم ناموفق بود",true)}finally{button.disabled=false}}
function showRenewalResult(message,isError=false,data=null){const box=$("#renewalResult");box.className=`renewal-result${isError?" error":""}`;box.innerHTML=`<strong>${esc(message)}</strong>${data?`<div class="renewal-result-grid"><div><span>ترم جدید</span><b>${esc(data.termNumber)}</b></div><div><span>شهریه جدید</span><b>${data.tuitionAmount==null?"—":formatNumber(data.tuitionAmount)}</b></div><div><span>سررسید</span><b>${esc(data.tuitionDueDate||"—")}</b></div><div><span>صورتحساب جدید</span><b>${esc(data.invoiceId??"ایجاد نشد")}</b></div></div>`:""}`;box.hidden=false;window.scrollTo({top:0,behavior:"smooth"})}
$("#sessions").addEventListener("click",async e=>{const b=e.target.closest("button");if(!b)return;if(b.dataset.renewalToggle){const enrollmentId=b.dataset.renewalToggle;const form=document.querySelector(`[data-renewal-form="${enrollmentId}"]`);if(form)form.hidden=!form.hidden;return}if(b.dataset.renewalSubmit){await renewTerm(b);return}if(b.dataset.paymentToggle){const invoiceId=b.dataset.paymentToggle;const form=document.querySelector(`[data-payment-form="${invoiceId}"]`);if(form)form.hidden=!form.hidden;return}if(b.dataset.paymentSubmit){await recordPayment(b);return}b.disabled=true;try{if(b.dataset.enrollment)await put("/api/admin/attendance",{enrollmentSessionId:Number(b.dataset.enrollment),status:b.dataset.status});else if(b.dataset.session)await put("/api/admin/teacher-attendance",{sessionId:Number(b.dataset.session),instructorId:Number(b.dataset.instructor),status:b.dataset.status})}catch(err){$("#error").textContent=err instanceof Error?err.message:"ثبت عملیات ناموفق بود";$("#error").hidden=false}finally{b.disabled=false}});
function shift(n){const parts=state.date.split("-").map(Number);const d=new Date(parts[0],parts[1]-1,parts[2],12,0,0);d.setDate(d.getDate()+n);state.date=localDateString(d);load()}
$("#prev").onclick=()=>shift(-1);$("#next").onclick=()=>shift(1);$("#today").onclick=()=>{state.date=localDateString();load()};startClock();load();
</script>
