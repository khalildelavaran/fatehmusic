---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import "../../styles/admin/daily-dashboard.css";
import "../../styles/admin/daily-dashboard-mobile.css";
import "../../styles/admin/daily-assistant.css";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
Astro.response.headers.set("Cache-Control", "no-store");
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="daily" />
    <main class="admin-main">
      <div class="admin-shell daily-shell" dir="rtl" id="dailyDashboardRoot">
        <header class="admin-hero daily-topbar" aria-label="داشبورد روزانه">
          <div class="daily-topbar-side daily-topbar-title"><span class="admin-hero-label">عملیات آموزشگاه</span><h1>داشبورد روزانه</h1></div>
          <div class="daily-clock" aria-live="polite"><div id="dateLabel" class="daily-date" dir="rtl"></div><div id="timeLabel" class="daily-time" dir="ltr"></div></div>
          <div class="date-nav" aria-label="تغییر روز"><button id="prev" type="button">روز قبل</button><button id="today" type="button">امروز</button><button id="next" type="button">روز بعد</button><button id="refresh" type="button" aria-label="بازخوانی">بازخوانی</button></div>
        </header>
        <div id="lastSync" class="daily-sync" aria-live="polite"></div><div id="error" class="daily-error" role="alert" hidden></div>
        <section id="summary" class="daily-summary" aria-label="خلاصه امروز"></section>
        <section id="dailyAssistant" class="daily-ai-panel" aria-label="دستیار هوشمند منشی">
          <div class="daily-ai-head"><div><strong>دستیار هوشمند منشی</strong><span>ابتدا چینش روز را بررسی می‌کند؛ موارد مبهم یا تداخل‌های نیازمند تصمیم را به منشی اعلام می‌کند.</span></div></div>
          <form class="daily-ai-form"><textarea maxlength="1200" placeholder="مثلاً: وضعیت امروز را بررسی کن و اگر لازم است چینش را بهینه کن."></textarea><button type="submit">پرسش از دستیار</button></form>
          <div class="daily-ai-suggestions" aria-label="پرسش‌های پیشنهادی"><button type="button" data-question="تداخل‌های امروز را پیدا کن و اگر ممکن است چینش را بهینه کن.">تداخل‌ها را بررسی کن</button><button type="button" data-question="وضعیت کلی امروز را برای منشی خلاصه کن.">خلاصه امروز</button><button type="button" data-question="کلاس‌هایی که نیاز به تصمیم منشی دارند را مشخص کن.">نیازمند تصمیم</button></div>
          <div class="daily-ai-output" data-assistant-output aria-live="polite">هنوز پرسشی ارسال نشده است.</div>
          <div class="daily-auto-plan-box" aria-label="چینش هوشمند روز">
            <div class="daily-planner-head"><div><strong>چینش هوشمند روز</strong><span>سوابق ساعت هنرجویان، استاد، اتاق، ظرفیت و وضعیت حضور بررسی می‌شود.</span></div><button id="dailyAutoPlanRun" type="button">ساخت چینش هوشمند</button></div>
            <div id="dailyAutoPlanStatus" class="daily-planner-status" aria-live="polite"></div><div id="dailyAutoPlanResults" class="daily-planner-results" aria-live="polite"></div>
          </div>
          <div class="daily-planner-box" aria-label="پیشنهاد زمان جایگزین"><div class="daily-planner-head"><div><strong>پیشنهاد زمان جایگزین</strong><span>قبل از اعمال، گزینه دوباره در Backend اعتبارسنجی می‌شود.</span></div></div><div class="daily-planner-controls"><select id="dailyPlannerSession" aria-label="انتخاب جلسه"></select><button id="dailyPlannerFind" type="button">پیدا کردن گزینه‌ها</button></div><div id="dailyPlannerResults" class="daily-planner-results" aria-live="polite"></div><div id="dailyPlannerStatus" class="daily-planner-status"></div></div>
        </section>
        <section id="timeline" class="dd-timeline" aria-label="نوار زمانی جلسات امروز"></section><section id="sessionsPanel" class="dd-sessions" aria-label="فهرست جلسات و هنرجویان امروز"></section>
        <div id="quickPaymentModal" class="dd-modal" hidden aria-hidden="true"><div class="dd-modal-backdrop" data-action="close-modal"></div><div class="dd-modal-box" role="dialog" aria-modal="true" aria-labelledby="quickPaymentTitle"><div class="dd-modal-head"><strong id="quickPaymentTitle">ثبت پرداخت سریع</strong><button type="button" class="dd-modal-close" data-action="close-modal" aria-label="بستن">×</button></div><div id="quickPaymentBody" class="dd-modal-body"></div></div></div>
      </div>
    </main>
  </div>
</MainLayout>
<script src="../../scripts/admin/daily/daily-dashboard.js"></script>
<script src="../../scripts/admin/daily/daily-assistant.js"></script>
<script src="../../scripts/admin/daily/daily-attendance-unlock.js"></script>
<script>
(() => {
  const root=document.querySelector('#dailyDashboardRoot'), assistant=document.querySelector('#dailyAssistant'), input=assistant?.querySelector('textarea');
  const ps=document.querySelector('#dailyPlannerSession'), pf=document.querySelector('#dailyPlannerFind'), pr=document.querySelector('#dailyPlannerResults'), pst=document.querySelector('#dailyPlannerStatus');
  const ar=document.querySelector('#dailyAutoPlanRun'), ast=document.querySelector('#dailyAutoPlanStatus'), ars=document.querySelector('#dailyAutoPlanResults');
  const date=()=>root?.dataset?.date||new Date().toLocaleDateString('en-CA');
  const esc=v=>{const e=document.createElement('div');e.textContent=String(v??'');return e.innerHTML};
  assistant?.querySelectorAll('[data-question]').forEach(b=>b.addEventListener('click',()=>{if(input){input.value=b.dataset.question||'';input.focus()}}));
  function refresh(){if(!ps)return;const seen=new Set(),o=[];document.querySelectorAll('#sessionsPanel [data-session-id]').forEach(n=>{const id=String(n.dataset.sessionId||'');if(!id||seen.has(id))return;seen.add(id);o.push(`<option value="${esc(id)}">${esc(id)} — ${esc((n.textContent||'').replace(/\s+/g,' ').trim().slice(0,90))}</option>`)});ps.innerHTML=o.length?o.join(''):'<option value="">جلسه‌ای برای این روز وجود ندارد</option>';ps.disabled=!o.length;pf.disabled=!o.length}
  async function suggest(){const id=ps?.value;if(!id)return;pf.disabled=true;pst.textContent='در حال بررسی…';pr.innerHTML='';try{const r=await fetch(`/api/admin/daily-planner/suggestions?sessionId=${encodeURIComponent(id)}&limit=8`,{credentials:'same-origin'}),d=await r.json();if(!r.ok||!d.success)throw Error(d.message||'خطا');pst.textContent=d.candidates?.length?`برای «${d.session.class_name}» گزینه پیدا شد.`:'گزینه آزاد پیدا نشد.';pr.innerHTML=(d.candidates||[]).map(c=>`<div class="daily-planner-candidate"><div><strong>${esc(c.startTime)} — ${esc(c.endTime)}</strong><small>${esc(c.roomName?`اتاق ${c.roomName}`:'بدون اتاق')} · ${esc((c.reasons||[]).join(' · '))}</small></div><button type="button" data-apply data-id="${esc(id)}" data-date="${esc(d.session.session_date)}" data-start="${esc(c.startTime)}" data-end="${esc(c.endTime)}" data-room="${c.roomId??''}">تأیید و اعمال</button></div>`).join('')}catch(e){pst.textContent=e instanceof Error?e.message:String(e)}finally{pf.disabled=false}}
  async function apply(b){b.disabled=true;pst.textContent='در حال اعتبارسنجی نهایی…';try{const r=await fetch('/api/admin/daily-planner/suggestions',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json',Accept:'application/json'},body:JSON.stringify({sessionId:Number(b.dataset.id),sessionDate:b.dataset.date,startTime:b.dataset.start,endTime:b.dataset.end,roomId:b.dataset.room||null})}),d=await r.json();if(!r.ok||!d.success)throw Error(d.message||'اعمال تغییر ناموفق بود.');pst.textContent=d.message||'اعمال شد.';pr.innerHTML='';document.querySelector('#refresh')?.click();setTimeout(refresh,400)}catch(e){pst.textContent=e instanceof Error?e.message:String(e);b.disabled=false}}
  async function applyAutoPlan(){const buttons=[...ars.querySelectorAll('[data-auto-apply]')];const changes=buttons.map(b=>({sessionId:Number(b.dataset.id),to:{startTime:b.dataset.start,endTime:b.dataset.end,roomId:b.dataset.room===''||b.dataset.room==null?null:Number(b.dataset.room)}}));const removed=[...ars.querySelectorAll('[data-auto-removed]')].map(n=>Number(n.dataset.autoRemoved)).filter(Number.isInteger);if(!changes.length&&!removed.length){ast.textContent='تغییری برای اعمال وجود ندارد.';return}ar.disabled=true;ast.textContent='در حال اعتبارسنجی نهایی کل چینش و اعمال یکجای تغییرات…';try{const r=await fetch('/api/admin/daily-planner/auto',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json',Accept:'application/json'},body:JSON.stringify({date:date(),removeSessionIds:removed,changes})}),d=await r.json();if(!r.ok||!d.success){if(d?.plan){renderAutoPlan(d.plan)}throw Error(d?.message||'اعمال چینش ناموفق بود.')}ast.textContent=d.message||'کل چینش اعمال شد.';document.querySelector('#refresh')?.click();setTimeout(()=>autoPlan(),500)}catch(e){if(!ast.textContent||ast.textContent.includes('در حال'))ast.textContent=e instanceof Error?e.message:String(e)}finally{ar.disabled=false}}
  function renderAutoPlan(p){ars.innerHTML=[...(p.removedSessionIds||[]).map(id=>`<div class="daily-planner-candidate" data-auto-removed="${esc(id)}"><div><strong>جلسه ${esc(id)} حذف پیشنهادی</strong><small>همه هنرجویان جلسه غیبت/مرخصی ثبت‌شده دارند.</small></div></div>`),...(p.changes||[]).map(c=>`<div class="daily-planner-candidate"><div><strong>${esc(c.className)} · ${esc(c.instructorName)}</strong><small>${esc(c.from.startTime)}–${esc(c.from.endTime)} → ${esc(c.to.startTime)}–${esc(c.to.endTime)} · ${esc(c.to.roomName?`اتاق ${c.to.roomName}`:'بدون اتاق')}</small><small>${esc((c.reasons||[]).join(' · '))}</small></div><button type="button" data-auto-apply data-id="${esc(c.sessionId)}" data-start="${esc(c.to.startTime)}" data-end="${esc(c.to.endTime)}" data-room="${c.to.roomId??''}">پیشنهاد</button></div>`),...(p.changes?.length||p.removedSessionIds?.length?['<button type="button" data-auto-apply-all class="daily-planner-apply-all">تأیید و اعمال کل چینش</button>']:[]),...(p.questions||[]).map(q=>`<div class="daily-planner-candidate"><div><strong>نیازمند تصمیم منشی</strong><small>${esc(q.message)}</small></div></div>`)].join('')||'<div class="daily-planner-status">تغییری پیشنهاد نشد.</div>'}
  async function autoPlan(removeIds=[]){if(!ar)return;ar.disabled=true;ast.textContent='در حال تحلیل سوابق، استاد، اتاق و وضعیت حضور…';ars.innerHTML='';try{const q=new URLSearchParams({date:date()});if(removeIds.length)q.set('removeSessionIds',removeIds.join(','));const r=await fetch(`/api/admin/daily-planner/auto?${q}`,{credentials:'same-origin'}),d=await r.json();if(!r.ok||!d.success)throw Error(d.message||'ساخت چینش ناموفق بود.');const p=d.plan;ast.textContent=p.summary;renderAutoPlan(p)}catch(e){ast.textContent=e instanceof Error?e.message:String(e)}finally{ar.disabled=false}}
  window.fatehDailyAutoPlanAfterAttendance = () => autoPlan();
  ar?.addEventListener('click',()=>autoPlan());pf?.addEventListener('click',suggest);pr?.addEventListener('click',e=>{const b=e.target.closest('[data-apply]');if(b)apply(b)});ars?.addEventListener('click',e=>{const b=e.target.closest('[data-auto-apply-all]');if(b)applyAutoPlan();});document.querySelectorAll('#prev,#next,#today,#refresh').forEach(b=>b.addEventListener('click',()=>setTimeout(refresh,400)));setTimeout(refresh,500);
})();
</script>