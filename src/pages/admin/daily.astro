---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="daily" />
    <main class="admin-main">
      <div class="admin-shell daily-shell" dir="rtl">
        <header class="admin-hero daily-topbar" aria-label="داشبورد روزانه">
          <span class="admin-hero-label">عملیات آموزشگاه</span>
          <h1>داشبورد روزانه</h1>
          <span id="dateLabel" class="admin-hero-description"></span>
          <div class="date-nav" aria-label="تغییر روز">
            <button id="prev" type="button">روز قبل</button>
            <button id="today" type="button">امروز</button>
            <button id="next" type="button">روز بعد</button>
          </div>
        </header>
        <section id="summary" class="daily-summary"></section>
        <div id="error" class="daily-error" hidden></div>
        <section id="sessions" class="daily-sessions" aria-live="polite"></section>
      </div>
    </main>
  </div>
</MainLayout>
<style>
.daily-shell{max-width:none;margin:0;padding:32px clamp(18px,3vw,36px) 64px}.daily-topbar{margin-bottom:24px}.daily-topbar .date-nav{margin-inline-start:auto;flex:0 0 auto}.date-nav{display:flex;gap:8px}.date-nav button,.attendance-action,.teacher-action{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:9px 13px;cursor:pointer;font-family:inherit}.date-nav button:hover,.attendance-action:hover,.teacher-action:hover{border-color:var(--primary)}.daily-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}.daily-summary .stat{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:15px}.daily-summary strong{display:block;font-size:24px}.daily-summary .warning{border-color:#b89500}.session{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:16px}.session-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.session-title{display:flex;gap:12px;align-items:center}.session-title strong{font-size:18px}.session-title span,.session-meta{opacity:.7}.calendar-warning{margin:12px 0;padding:9px 12px;border-radius:10px;background:rgba(212,175,55,.10)}.teacher-row{display:flex;align-items:center;gap:10px;margin:15px 0;padding-top:12px;border-top:1px solid var(--border)}.students{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}.student{border:1px solid var(--border);border-radius:12px;padding:12px}.student-top{display:flex;align-items:center;gap:9px}.light{width:11px;height:11px;border-radius:50%;display:inline-block;border:1px solid rgba(255,255,255,.35)}.green{background:#25a244}.red{background:#d62828}.yellow{background:#e0b100}.white{background:#fff}.student-name{font-weight:700}.student-meta{display:flex;justify-content:space-between;gap:8px;margin:9px 0;font-size:12px;opacity:.75}.attendance-actions{display:flex;gap:5px;flex-wrap:wrap}.attendance-action.active{border-color:var(--primary);box-shadow:0 0 0 1px var(--primary)}.daily-error{padding:12px;border:1px solid #a33;border-radius:10px;margin-bottom:15px}.empty{opacity:.65;padding:30px;text-align:center}@media(max-width:800px){.daily-shell{padding:16px}.daily-topbar{align-items:stretch;flex-direction:column;gap:10px}.daily-topbar .date-nav{margin-inline-start:0}.daily-summary{grid-template-columns:repeat(2,1fr)}.session-head{flex-direction:column;align-items:stretch}.students{grid-template-columns:1fr}}
</style>
<script>
const state={date:new Date().toISOString().slice(0,10)};
const $=s=>document.querySelector(s);
const labels={pending:["yellow","ثبت نشده"],present:["green","حاضر"],absent:["red","غایب"],excused:["white","مرخصی"]};
const teacherLabels={pending:"ثبت نشده",present:"حاضر",absent:"غایب"};
function esc(v){const d=document.createElement("div");d.textContent=String(v??"");return d.innerHTML}
function formatShamsiDate(value){const [year,month,day]=String(value).split("-").map(Number);const date=new Date(year,month-1,day,12,0,0);return new Intl.DateTimeFormat("fa-IR",{dateStyle:"long"}).format(date)}
function render(data){const sessions=data.sessions??[];const students=sessions.flatMap(s=>s.students??[]);$("#dateLabel").textContent=formatShamsiDate(data.date);const counts={pending:0,present:0,absent:0,excused:0};students.forEach(s=>counts[s.attendanceStatus]=(counts[s.attendanceStatus]??0)+1);$("#summary").innerHTML=`<div class="stat">جلسه<strong>${sessions.length}</strong></div><div class="stat">هنرجو<strong>${students.length}</strong></div><div class="stat">غایب<strong>${counts.absent}</strong></div><div class="stat warning">ثبت‌نشده<strong>${counts.pending}</strong></div>`;$("#sessions").innerHTML=sessions.map(s=>{const teacher=s.teacher_attendance_status??"pending";return `<article class="session"><header class="session-head"><div class="session-title"><strong>${esc(s.class_title)}</strong><span>${esc(s.start_time)} — ${esc(s.end_time)}</span></div><div class="session-meta">${esc(s.instructor_name)} · ${esc(s.room_name||"بدون اتاق")}${s.type==='makeup'?" · جبرانی":""}</div></header><div class="teacher-row"><b>حضور استاد:</b><span>${esc(teacherLabels[teacher]||teacher)}</span><button class="teacher-action" type="button" data-session="${s.id}" data-instructor="${s.instructor_id}" data-status="present">حاضر</button><button class="teacher-action" type="button" data-session="${s.id}" data-instructor="${s.instructor_id}" data-status="absent">غایب</button></div><div class="students">${(s.students??[]).map(st=>{const [color,label]=labels[st.attendanceStatus]||labels.pending;return `<article class="student"><div class="student-top"><span class="light ${color}" title="${label}"></span><span class="student-name">${esc(st.studentName)}</span></div><div class="student-meta"><span>گذرانده: ${st.consumedSessions}</span><span>باقی: ${st.remainingSessions??"—"}</span></div>${st.tuitionWarning?`<div class="calendar-warning">${st.tuitionDueDate?`هشدار شهریه: ${esc(st.tuitionDueDate)}`:"هشدار تمدید ترم"}</div>`:""}<div class="attendance-actions">${["present","absent","excused"].map(x=>`<button class="attendance-action ${x===st.attendanceStatus?"active":""}" type="button" data-enrollment="${st.enrollmentSessionId}" data-status="${x}">${labels[x][1]}</button>`).join("")}</div></article>`}).join("")||`<div class="empty">هنرجویی برای این جلسه ثبت نشده است.</div>`}</div></article>`}).join("")||`<div class="empty">برای این روز جلسه‌ای ثبت نشده است.</div>`}
async function responseJson(response){const text=await response.text();if(!text.trim())throw Error(`پاسخ خالی از سرور دریافت شد (${response.status})`);try{return JSON.parse(text)}catch{throw Error(`پاسخ JSON نامعتبر از سرور دریافت شد (${response.status})`)}}
async function load(){try{$("#error").hidden=true;const r=await fetch(`/api/admin/daily-dashboard?date=${encodeURIComponent(state.date)}`,{credentials:"same-origin",headers:{Accept:"application/json"}});const d=await responseJson(r);if(!r.ok||!d.success)throw Error(d.message||`خطا در دریافت داشبورد (${r.status})`);render(d)}catch(e){$("#error").textContent=e instanceof Error?e.message:"خطا در دریافت داشبورد";$("#error").hidden=false}}
async function put(url,body){const r=await fetch(url,{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json",Accept:"application/json"},body:JSON.stringify(body)});const d=await responseJson(r);if(!r.ok||!d.success)throw Error(d.message||`ثبت عملیات ناموفق بود (${r.status})`);await load()}
$("#sessions").addEventListener("click",async e=>{const b=e.target.closest("button");if(!b)return;b.disabled=true;try{if(b.dataset.enrollment)await put("/api/admin/attendance",{enrollmentSessionId:Number(b.dataset.enrollment),status:b.dataset.status});else if(b.dataset.session)await put("/api/admin/teacher-attendance",{sessionId:Number(b.dataset.session),instructorId:Number(b.dataset.instructor),status:b.dataset.status})}catch(err){$("#error").textContent=err instanceof Error?err.message:"ثبت عملیات ناموفق بود";$("#error").hidden=false}finally{b.disabled=false}});
function shift(n){const d=new Date(`${state.date}T12:00:00`);d.setDate(d.getDate()+n);state.date=d.toISOString().slice(0,10);load()}
$("#prev").onclick=()=>shift(-1);$("#next").onclick=()=>shift(1);$("#today").onclick=()=>{state.date=new Date().toISOString().slice(0,10);load()};load();
</script>
