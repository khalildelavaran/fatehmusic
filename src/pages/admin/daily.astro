---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout"><AdminNav session={session} active="dashboard" /><main class="admin-main"><div class="daily-shell" dir="rtl">
    <header class="daily-header"><div><span class="eyebrow">عملیات آموزشگاه</span><h1>داشبورد روزانه</h1><p id="dateLabel"></p></div><div class="date-nav"><button id="prev">روز قبل</button><button id="today">امروز</button><button id="next">روز بعد</button></div></header>
    <section id="summary" class="daily-summary"></section><div id="error" class="daily-error" hidden></div><section id="sessions" class="daily-sessions" aria-live="polite"></section>
  </div></main></div>
</MainLayout>
<style>
.daily-shell{max-width:1400px;margin:auto;padding:28px}.daily-header{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.eyebrow{font-size:12px;opacity:.65}.daily-header h1{margin:5px 0}.daily-header p{margin:0;opacity:.65}.date-nav{display:flex;gap:8px}.date-nav button,.attendance-action,.teacher-action,.makeup-action,.payment-action,.renew-action{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:9px 13px;cursor:pointer;font-family:inherit}.date-nav button:hover,.attendance-action:hover,.teacher-action:hover,.makeup-action:hover,.payment-action:hover,.renew-action:hover{border-color:var(--primary)}button:disabled{opacity:.45;cursor:not-allowed}.daily-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}.daily-summary .stat{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:15px}.daily-summary strong{display:block;font-size:24px}.daily-summary .warning{border-color:#b89500}.session{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:16px}.session.cancelled{opacity:.72}.session-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.session-title{display:flex;gap:12px;align-items:center}.session-title strong{font-size:18px}.session-title span,.session-meta{opacity:.7}.calendar-warning{margin:12px 0;padding:9px 12px;border-radius:10px;background:rgba(212,175,55,.10);border:1px solid rgba(212,175,55,.35)}.cancelled-warning{margin:12px 0;padding:9px 12px;border-radius:10px;background:rgba(214,40,40,.08);border:1px solid rgba(214,40,40,.28)}.teacher-row{display:flex;align-items:center;gap:10px;margin:15px 0;padding-top:12px;border-top:1px solid var(--border)}.students{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}.student{border:1px solid var(--border);border-radius:12px;padding:12px}.student-top{display:flex;align-items:center;gap:9px}.light{width:11px;height:11px;border-radius:50%;display:inline-block;border:1px solid rgba(255,255,255,.35)}.green{background:#25a244}.red{background:#d62828}.yellow{background:#e0b100}.white{background:#fff}.student-name{font-weight:700}.student-meta{display:flex;justify-content:space-between;gap:8px;margin:9px 0;font-size:12px;opacity:.75}.finance-meta{font-size:12px;margin:7px 0;opacity:.8}.attendance-actions,.secondary-actions{display:flex;gap:5px;flex-wrap:wrap}.attendance-action.active{border-color:var(--primary);box-shadow:0 0 0 1px var(--primary)}.secondary-actions{margin-top:8px}.daily-error{padding:12px;border:1px solid #a33;border-radius:10px;margin-bottom:15px}.empty{opacity:.65;padding:30px;text-align:center}@media(max-width:800px){.daily-shell{padding:16px}.daily-header{align-items:stretch;flex-direction:column}.daily-summary{grid-template-columns:repeat(2,1fr)}.session-head{flex-direction:column;align-items:stretch}.students{grid-template-columns:1fr}}
</style>
<script src="../../scripts/admin/daily-dashboard.js"></script>
