---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout"><AdminNav session={session} active="dashboard" /><main class="admin-main"><div class="daily-shell" dir="rtl">
    <header class="daily-header"><div><span class="eyebrow">عملیات آموزشگاه</span><h1>داشبورد روزانه</h1><p id="dateLabel"></p></div><div class="date-nav"><button id="prev">روز قبل</button><button id="today">امروز</button><button id="next">روز بعد</button></div></header>
    <section id="summary" class="daily-summary"></section><div id="error" class="daily-error" hidden></div><section id="sessions" class="daily-sessions" aria-live="polite"></section>
  </div></main></div>
</MainLayout>
<style>
.daily-shell{max-width:1400px;margin:auto;padding:28px}.daily-header{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.eyebrow{font-size:12px;opacity:.65}.daily-header h1{margin:5px 0}.daily-header p{margin:0;opacity:.65}.date-nav{display:flex;gap:8px}.date-nav button,.attendance-action,.teacher-action,.makeup-action,.payment-action{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:9px 13px;cursor:pointer;font-family:inherit}.date-nav button:hover,.attendance-action:hover,.teacher-action:hover,.makeup-action:hover,.payment-action:hover{border-color:var(--primary)}button:disabled{opacity:.45;cursor:not-allowed}.daily-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}.daily-summary .stat{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:15px}.daily-summary strong{display:block;font-size:24px}.daily-summary .warning{border-color:#b89500}.session{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:16px}.session.cancelled{opacity:.72}.session-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.session-title{display:flex;gap:12px;align-items:center}.session-title strong{font-size:18px}.session-title span,.session-meta{opacity:.7}.calendar-warning{margin:12px 0;padding:9px 12px;border-radius:10px;background:rgba(212,175,55,.10);border:1px solid rgba(212,175,55,.35)}.cancelled-warning{margin:12px 0;padding:9px 12px;border-radius:10px;background:rgba(214,40,40,.08);border:1px solid rgba(214,40,40,.28)}.teacher-row{display:flex;align-items:center;gap:10px;margin:15px 0;padding-top:12px;border-top:1px solid var(--border)}.students{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}.student{border:1px solid var(--border);border-radius:12px;padding:12px}.student-top{display:flex;align-items:center;gap:9px}.light{width:11px;height:11px;border-radius:50%;display:inline-block;border:1px solid rgba(255,255,255,.35)}.green{background:#25a244}.red{background:#d62828}.yellow{background:#e0b100}.white{background:#fff}.student-name{font-weight:700}.student-meta{display:flex;justify-content:space-between;gap:8px;margin:9px 0;font-size:12px;opacity:.75}.finance-meta{font-size:12px;margin:7px 0;opacity:.8}.attendance-actions,.secondary-actions{display:flex;gap:5px;flex-wrap:wrap}.attendance-action.active{border-color:var(--primary);box-shadow:0 0 0 1px var(--primary)}.secondary-actions{margin-top:8px}.daily-error{padding:12px;border:1px solid #a33;border-radius:10px;margin-bottom:15px}.empty{opacity:.65;padding:30px;text-align:center}@media(max-width:800px){.daily-shell{padding:16px}.daily-header{align-items:stretch;flex-direction:column}.daily-summary{grid-template-columns:repeat(2,1fr)}.session-head{flex-direction:column;align-items:stretch}.students{grid-template-columns:1fr}}
</style>
<script>
const localDate=()=>{const d=new Date();const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,"0"),day=String(d.getDate()).padStart(2,"0");return `${y}-${m}-${day}`};
const state={date:localDate()};const $=s=>document.querySelector(s);const labels={pending:["yellow","ثبت نشده"],present:["green","حاضر"],absent:["red","غایب"],excused:["white","مرخصی"]};const teacherLabels={pending:"ثبت نشده",present:"حاضر",absent:"غایب"};const financialLabels={none:"بدون صورتحساب",paid:"تسویه",pending:"پرداخت‌نشده",partial:"پرداخت ناقص",overdue:"سررسید گذشته"};
function esc(v){const d=document.createElement("div");d.textContent=String(v??"");return d.innerHTML}
function money(v){return Number(v||0).toLocaleString("fa-IR")}
function render(data){
  const sessions=data.sessions??[];const students=sessions.flatMap(s=>s.students??[]);$("#dateLabel").textContent=data.date;const counts={pending:0,present:0,absent:0,excused:0};students.forEach(s=>counts[s.attendanceStatus]=(counts[s.attendanceStatus]??0)+1);
  $("#summary").innerHTML=`<div class="stat">جلسه<strong>${sessions.length}</strong></div><div class="stat">هنرجو<strong>${students.length}</strong></div><div class="stat">غایب<strong>${counts.absent}</strong></div><div class="stat warning">ثبت‌نشده<strong>${counts.pending}</strong></div>`;
  $("#sessions").innerHTML=sessions.map(s=>{
    const teacher=s.teacher_attendance_status??"pending";const cancelled=s.status==="cancelled";
    const calendar=s.calendar_exception_title?`<div class="calendar-warning">تقویم: ${esc(s.calendar_exception_title)} — این هشدار به‌تنهایی جلسه را لغو نمی‌کند.</div>`:"";
    const cancelledBox=cancelled?`<div class="cancelled-warning">این جلسه لغو شده است؛ حضورغیاب و مصرف ترم برای آن ثبت نمی‌شود.</div>`:"";
    return `<article class="session ${cancelled?"cancelled":""}"><header class="session-head"><div class="session-title"><strong>${esc(s.class_title)}</strong><span>${esc(s.start_time)} — ${esc(s.end_time)}</span></div><div class="session-meta">${esc(s.instructor_name)} · ${esc(s.room_name||"بدون اتاق")}${s.type==='makeup'?" · جبرانی":""}</div></header>${calendar}${cancelledBox}<div class="teacher-row"><b>حضور استاد:</b><span>${esc(teacherLabels[teacher]||teacher)}</span><button class="teacher-action" ${cancelled?"disabled":""} data-session="${s.id}" data-instructor="${s.instructor_id}" data-status="present">حاضر</button><button class="teacher-action" ${cancelled?"disabled":""} data-session="${s.id}" data-instructor="${s.instructor_id}" data-status="absent">غایب</button></div><div class="students">${(s.students??[]).map(st=>{
      const [color,label]=labels[st.attendanceStatus]||labels.pending;const balance=Number(st.balance||0);const finance=financialLabels[st.financialStatus]||st.financialStatus||"";
      return `<article class="student"><div class="student-top"><span class="light ${color}" title="${label}"></span><span class="student-name">${esc(st.studentName)}</span></div><div class="student-meta"><span>گذرانده: ${st.consumedSessions}</span><span>باقی: ${st.remainingSessions??"—"}</span></div>${st.invoiceId?`<div class="finance-meta">شهریه: ${esc(finance)}${balance>0?` · مانده ${money(balance)}`:""}</div>`:""}${st.tuitionWarning?`<div class="calendar-warning">${st.tuitionDueDate?`هشدار شهریه: ${esc(st.tuitionDueDate)}`:"هشدار تمدید ترم"}</div>`:""}<div class="attendance-actions">${["present","absent","excused"].map(x=>`<button class="attendance-action ${x===st.attendanceStatus?"active":""}" ${cancelled?"disabled":""} data-enrollment="${st.enrollmentSessionId}" data-status="${x}">${labels[x][1]}</button>`).join("")}</div><div class="secondary-actions">${!cancelled&&st.attendanceStatus==="excused"?`<button class="makeup-action" data-makeup-enrollment="${st.enrollmentSessionId}" data-instructor="${s.instructor_id}" data-room="${s.room_id??""}" data-location="${esc(s.location_type||"in_person")}" data-start="${esc(s.start_time)}" data-end="${esc(s.end_time)}">ساخت جلسه جبرانی</button>`:""}${st.invoiceId&&balance>0?`<button class="payment-action" data-invoice="${st.invoiceId}" data-balance="${balance}">ثبت پرداخت</button>`:""}</div></article>`
    }).join("")||`<div class="empty">هنرجویی برای این جلسه ثبت نشده است.</div>`}</div></article>`
  }).join("")||`<div class="empty">برای این روز جلسه‌ای ثبت نشده است.</div>`
}
async function load(){try{$("#error").hidden=true;const r=await fetch(`/api/admin/daily-dashboard?date=${encodeURIComponent(state.date)}`,{credentials:"same-origin"});const d=await r.json();if(!r.ok||!d.success)throw Error(d.message||"خطا در دریافت داشبورد");render(d)}catch(e){$("#error").textContent=e.message;$("#error").hidden=false}}
async function request(url,method,body){const r=await fetch(url,{method,credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw Error(d.message||"ثبت عملیات ناموفق بود");return d}
async function put(url,body){await request(url,"PUT",body);await load()}
async function createMakeup(button){
  const date=prompt("تاریخ جلسه جبرانی (YYYY-MM-DD):",state.date);if(!date)return;
  const startTime=prompt("ساعت شروع:",button.dataset.start||"");if(!startTime)return;
  const endTime=prompt("ساعت پایان:",button.dataset.end||"");if(!endTime)return;
  await request("/api/admin/student-session","POST",{originalEnrollmentSessionId:Number(button.dataset.makeupEnrollment),sessionDate:date,startTime,endTime,instructorId:Number(button.dataset.instructor),roomId:button.dataset.room?Number(button.dataset.room):null,locationType:button.dataset.location||"in_person"});
  await load();
}
async function recordPayment(button){
  const balance=Number(button.dataset.balance||0);const raw=prompt("مبلغ پرداخت:",String(balance));if(!raw)return;
  const amount=Number(String(raw).replace(/[,٬،\s]/g,""));if(!Number.isInteger(amount)||amount<=0)throw Error("مبلغ پرداخت معتبر نیست.");
  const methodInput=prompt("روش پرداخت: cash / pos / transfer / online","pos");if(methodInput===null)return;
  await request("/api/admin/payments","POST",{invoiceId:Number(button.dataset.invoice),amount,method:methodInput});await load();
}
$("#sessions").addEventListener("click",async e=>{const b=e.target.closest("button");if(!b||b.disabled)return;b.disabled=true;try{if(b.dataset.makeupEnrollment)await createMakeup(b);else if(b.dataset.invoice)await recordPayment(b);else if(b.dataset.enrollment)await put("/api/admin/attendance",{enrollmentSessionId:Number(b.dataset.enrollment),status:b.dataset.status});else if(b.dataset.session)await put("/api/admin/teacher-attendance",{sessionId:Number(b.dataset.session),instructorId:Number(b.dataset.instructor),status:b.dataset.status})}catch(err){$("#error").textContent=err.message;$("#error").hidden=false}finally{b.disabled=false}});
function shift(n){const [y,m,d]=state.date.split("-").map(Number);const value=new Date(y,m-1,d+n,12);state.date=`${value.getFullYear()}-${String(value.getMonth()+1).padStart(2,"0")}-${String(value.getDate()).padStart(2,"0")}`;load()}$("#prev").onclick=()=>shift(-1);$("#next").onclick=()=>shift(1);$("#today").onclick=()=>{state.date=localDate();load()};load();
</script>
