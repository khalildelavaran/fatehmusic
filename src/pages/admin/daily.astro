---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import "../../styles/admin/daily-dashboard.css";
import "../../styles/admin/daily-assistant.css";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
Astro.response.headers.set("Cache-Control", "no-store");
---
<MainLayout title="داشبورد روزانه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="daily" />
    <main class="admin-main">
      <div class="admin-shell daily-shell" dir="rtl" id="dailyDashboardRoot">
        <header class="admin-hero daily-topbar" aria-label="داشبورد روزانه">
          <div class="daily-topbar-side daily-topbar-title">
            <span class="admin-hero-label">عملیات آموزشگاه</span>
            <h1>داشبورد روزانه</h1>
          </div>
          <div class="daily-clock" aria-live="polite">
            <div id="dateLabel" class="daily-date" dir="rtl"></div>
            <div id="timeLabel" class="daily-time" dir="ltr"></div>
          </div>
          <div class="date-nav" aria-label="تغییر روز">
            <button id="prev" type="button">روز قبل</button>
            <button id="today" type="button">امروز</button>
            <button id="next" type="button">روز بعد</button>
            <button id="refresh" type="button" aria-label="بازخوانی">بازخوانی</button>
          </div>
        </header>

        <div id="lastSync" class="daily-sync" aria-live="polite"></div>
        <div id="error" class="daily-error" role="alert" hidden></div>

        <section id="summary" class="daily-summary" aria-label="خلاصه امروز"></section>

        <section id="dailyAssistant" class="daily-ai-panel" aria-label="دستیار هوشمند منشی">
          <div class="daily-ai-head">
            <div>
              <strong>دستیار هوشمند منشی</strong>
              <span>برنامه همین روز را بررسی می‌کند و برای نظم کلاس‌ها، تداخل‌ها و جابه‌جایی‌ها پیشنهاد می‌دهد.</span>
            </div>
          </div>
          <form class="daily-ai-form">
            <textarea maxlength="1200" placeholder="مثلاً: کلاس‌هایی که تداخل دارند را پیدا کن و بهترین راه‌حل را پیشنهاد بده."></textarea>
            <button type="submit">پرسش از دستیار</button>
          </form>
          <div class="daily-ai-suggestions" aria-label="پرسش‌های پیشنهادی">
            <button type="button" data-question="کلاس‌هایی که تداخل استاد یا اتاق دارند را پیدا کن.">تداخل‌ها را پیدا کن</button>
            <button type="button" data-question="وضعیت کلی امروز را برای منشی خلاصه کن.">خلاصه امروز</button>
            <button type="button" data-question="کلاس‌هایی که نیاز به پیگیری منشی دارند را مشخص کن.">نیازمند پیگیری</button>
          </div>
          <div class="daily-ai-output" data-assistant-output aria-live="polite">هنوز پرسشی ارسال نشده است.</div>
        </section>

        <section id="timeline" class="dd-timeline" aria-label="نوار زمانی جلسات امروز"></section>

        <section id="sessionsPanel" class="dd-sessions" aria-label="فهرست جلسات و هنرجویان امروز"></section>

        <div id="quickPaymentModal" class="dd-modal" hidden aria-hidden="true">
          <div class="dd-modal-backdrop" data-action="close-modal"></div>
          <div class="dd-modal-box" role="dialog" aria-modal="true" aria-labelledby="quickPaymentTitle">
            <div class="dd-modal-head">
              <strong id="quickPaymentTitle">ثبت پرداخت سریع</strong>
              <button type="button" class="dd-modal-close" data-action="close-modal" aria-label="بستن">×</button>
            </div>
            <div id="quickPaymentBody" class="dd-modal-body"></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</MainLayout>
<script src="../../scripts/admin/daily/daily-dashboard.js"></script>
<script src="../../scripts/admin/daily/daily-assistant.js"></script>
<script>
  const assistant = document.querySelector("#dailyAssistant");
  const input = assistant?.querySelector("textarea");
  assistant?.querySelectorAll("[data-question]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!input) return;
      input.value = button.dataset.question || "";
      input.focus();
    });
  });
</script>
