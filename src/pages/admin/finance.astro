---
export const prerender = false;
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import { env } from "cloudflare:workers";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN && session.role !== ROLES.REGISTRAR) return new Response("Forbidden", { status: 403 });
---
<MainLayout title="مالی و شهریه | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="finance" />
    <main class="admin-main">
      <div class="admin-shell finance-shell" dir="rtl">
        <header class="admin-hero finance-hero">
          <div><span class="admin-hero-label">مرکز مالی آموزشگاه</span><h1>مالی و شهریه</h1></div>
          <div class="finance-filter" aria-label="انتخاب تاریخ شمسی">
            <button id="financePrev" class="finance-date-nav" type="button" aria-label="روز قبل">‹</button>
            <button id="financeToday" class="finance-today" type="button">امروز</button>
            <label for="financeDate">تاریخ</label>
            <input id="financeDate" type="text" inputmode="numeric" autocomplete="off" placeholder="۱۴۰۵/۰۶/۱۶" dir="ltr" aria-describedby="financeDateHint">
            <button id="financeNext" class="finance-date-nav" type="button" aria-label="روز بعد">›</button>
            <span id="financeDateHint" class="finance-date-hint">سال/ماه/روز</span>
          </div>
        </header>
        <nav class="finance-tabs" aria-label="نماهای مالی">
          <button class="is-active" type="button" data-tab="academy">مالی آموزشگاه</button>
          <button type="button" data-tab="instructors">تسویه اساتید</button>
          <button type="button" data-tab="students">حساب هنرجویان</button>
        </nav>
        <div id="financeError" class="finance-error" hidden></div>
        <section id="academyTab" class="finance-tab-panel is-active"></section>
        <section id="instructorsTab" class="finance-tab-panel" hidden></section>
        <section id="studentsTab" class="finance-tab-panel" hidden></section>
      </div>
    </main>
  </div>
</MainLayout>
<style>
.finance-shell{max-width:none;margin:0;padding:30px clamp(18px,3vw,36px) 64px}.finance-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.finance-hero h1{margin:5px 0 0;font-size:22px}.finance-filter{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.finance-filter label{font-weight:700}.finance-filter input{width:128px;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:9px 10px;font-family:inherit;font-weight:700;letter-spacing:.3px}.finance-date-nav,.finance-today{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:8px 11px;font:inherit;font-weight:800;cursor:pointer}.finance-date-nav{width:36px;height:36px;padding:0;font-size:21px;line-height:1}.finance-today:hover,.finance-date-nav:hover{background:rgba(212,175,55,.08)}.finance-date-hint{font-size:11px;opacity:.55}.finance-tabs{display:flex;gap:6px;padding:5px;margin-bottom:20px;border:1px solid var(--border);background:var(--surface);border-radius:14px}.finance-tabs button{flex:1;border:0;background:transparent;color:var(--text);padding:11px 14px;border-radius:10px;font:inherit;font-weight:800;cursor:pointer}.finance-tabs button:hover{background:rgba(212,175,55,.08)}.finance-tabs button.is-active{background:var(--primary);color:#fff}.finance-tab-panel[hidden]{display:none}.finance-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:18px}.finance-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:15px}.finance-card span{display:block;font-size:12px;opacity:.65;margin-bottom:6px}.finance-card b{font-size:21px}.finance-card.warn{border-color:#b89500}.finance-card.danger{border-color:#a33}.finance-card.gold b{color:var(--gold-light)}.finance-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.finance-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px}.finance-panel h2{font-size:15px;margin:0 0 12px}.finance-table{width:100%;border-collapse:collapse;font-size:13px}.finance-table th,.finance-table td{padding:9px 8px;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap}.finance-table th{font-size:11px;opacity:.65}.finance-table tr:last-child td{border-bottom:0}.finance-status{display:inline-block;padding:4px 8px;border-radius:999px;border:1px solid var(--border);font-size:11px}.finance-status.paid{border-color:#2f8f46}.finance-status.partial,.finance-status.pending{border-color:#b89500}.finance-status.overdue{border-color:#a33;color:#d77}.method-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.method-item{border:1px solid var(--border);border-radius:10px;padding:10px}.method-item span{display:block;font-size:11px;opacity:.65}.method-item b{display:block;margin-top:5px}.finance-error{padding:12px 14px;border:1px solid #a33;border-radius:10px;margin-bottom:15px}.empty{padding:25px;text-align:center;opacity:.65}@media(max-width:1000px){.finance-cards{grid-template-columns:repeat(3,1fr)}.finance-grid-2{grid-template-columns:1fr}.method-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.finance-hero{flex-direction:column;align-items:stretch}.finance-filter{justify-content:flex-start}.finance-filter input{flex:1;min-width:105px}.finance-tabs{overflow-x:auto}.finance-tabs button{flex:0 0 auto;min-width:130px}.finance-cards{grid-template-columns:1fr 1fr}.finance-table{display:block;overflow-x:auto}.method-grid{grid-template-columns:1fr 1fr}}@media(max-width:450px){.finance-cards{grid-template-columns:1fr}.method-grid{grid-template-columns:1fr}}
</style>
<script>
const $=(s)=>document.querySelector(s); const PERSIAN_DIGITS="۰۱۲۳۴۵۶۷۸۹"; const ARABIC_DIGITS="٠١٢٣٤٥٦٧٨٩";
const state={date:new Date().toISOString().slice(0,10)};
const money=(v)=>Number(v??0).toLocaleString("fa-IR");
const esc=(v)=>{const d=document.createElement("div");d.textContent=String(v??"");return d.innerHTML};
const statusLabels={paid:"تسویه",partial:"ناقص",pending:"پرداخت نشده",overdue:"معوق",none:"بدون صورتحساب"};
const methodLabels={cash:"نقدی",pos:"کارتخوان",transfer:"کارت‌به‌کارت / انتقال",online:"آنلاین",other:"سایر"};
function normalizeDigits(value){return String(value??"").replace(/[۰-۹]/g,c=>String(PERSIAN_DIGITS.indexOf(c))).replace(/[٠-٩]/g,c=>String(ARABIC_DIGITS.indexOf(c)))}
function isoDate(date){return `${date.getUTCFullYear()}-${String(date.getUTCMonth()+1).padStart(2,"0")}-${String(date.getUTCDate()).padStart(2,"0")}`}
function parseIso(value){const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(value);if(!m)return null;const d=new Date(Date.UTC(Number(m[1]),Number(m[2])-1,Number(m[3])));return d.getUTCFullYear()===Number(m[1])&&d.getUTCMonth()+1===Number(m[2])&&d.getUTCDate()===Number(m[3])?d:null}
function persianParts(value){const d=parseIso(value);if(!d)return null;const parts=new Intl.DateTimeFormat("en-US-u-ca-persian",{timeZone:"UTC",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(d);const get=(type)=>parts.find(p=>p.type===type)?.value;return {year:Number(get("year")),month:Number(get("month")),day:Number(get("day"))}}
function formatPersianDate(value){const p=persianParts(value);return p?`${String(p.year).padStart(4,"0")}/${String(p.month).padStart(2,"0")}/${String(p.day).padStart(2,"0")}`:"—"}
function formatPersianMonth(value){const normalized=normalizeDigits(value).replace(/[/.]/g,"-");const m=/^(\d{4})-(\d{1,2})$/.exec(normalized);if(!m)return String(value??"—");const iso=`${m[1]}-${m[2].padStart(2,"0")}-01`;const p=persianParts(iso);return p?`${p.year}/${String(p.month).padStart(2,"0")}`:String(value??"—")}
function gregorianFromPersian(value){const normalized=normalizeDigits(value).replace(/[.-]/g,"/");const m=/^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(normalized);if(!m)return null;const jy=Number(m[1]),jm=Number(m[2]),jd=Number(m[3]);if(jm<1||jm>12||jd<1||jd>31)return null;const anchor=new Date(Date.UTC(jy+621,2,21));for(let offset=-370;offset<=370;offset++){const d=new Date(anchor);d.setUTCDate(d.getUTCDate()+offset);const p=persianParts(isoDate(d));if(p&&p.year===jy&&p.month===jm&&p.day===jd)return isoDate(d)}return null}
function monthOf(date){return String(date).slice(0,7)}
function showError(message){const box=$("#financeError");box.textContent=message;box.hidden=false}
function clearError(){$("#financeError").hidden=true}
function setDateInput(){const input=$("#financeDate");input.value=formatPersianDate(state.date);input.dataset.iso=state.date}
async function getJson(url){const r=await fetch(url,{credentials:"same-origin",headers:{Accept:"application/json"}});const text=await r.text();let d;try{d=JSON.parse(text)}catch{throw Error(`پاسخ نامعتبر از سرور (${r.status})`)}if(!r.ok||!d.success)throw Error(d.message||`خطای سرور (${r.status})`);return d}
function academy(d){const s=d.summary;const methods=Object.entries(s.methodTotals??{}).map(([k,v])=>`<div class="method-item"><span>${esc(methodLabels[k]||k)}</span><b>${money(v)}</b></div>`).join("");const payments=d.payments??[];const debts=d.debts??[];return `<div class="finance-cards"><div class="finance-card gold"><span>دریافتی امروز</span><b>${money(s.receivedTotal)}</b></div><div class="finance-card"><span>تعداد پرداخت</span><b>${money(s.receivedCount)}</b></div><div class="finance-card warn"><span>مانده مطالبات</span><b>${money(s.outstandingTotal)}</b></div><div class="finance-card danger"><span>مطالبات معوق</span><b>${money(s.overdueTotal)}</b></div><div class="finance-card"><span>تعداد بدهکاران</span><b>${money(s.debtorCount)}</b></div></div><div class="finance-grid-2"><article class="finance-panel"><h2>تفکیک دریافتی</h2><div class="method-grid">${methods}</div></article><article class="finance-panel"><h2>پرداخت‌های ثبت‌شده</h2>${payments.length?`<table class="finance-table"><thead><tr><th>هنرجو</th><th>مبلغ</th><th>روش</th><th>کلاس</th></tr></thead><tbody>${payments.map(p=>`<tr><td>${esc(p.student_name)}</td><td>${money(p.amount)}</td><td>${esc(methodLabels[p.method]||p.method)}</td><td>${esc(p.class_title||"—")}</td></tr>`).join("")}</tbody></table>`:`<div class="empty">امروز پرداختی ثبت نشده است.</div>`}</article></div><article class="finance-panel" style="margin-top:16px"><h2>مطالبات هنرجویان</h2>${debts.length?`<table class="finance-table"><thead><tr><th>هنرجو</th><th>کلاس</th><th>مانده</th><th>سررسید</th><th>وضعیت</th></tr></thead><tbody>${debts.map(x=>`<tr><td>${esc(x.student_name)}</td><td>${esc(x.class_title||"—")}</td><td>${money(x.balance)}</td><td>${formatPersianDate(x.due_date)}</td><td><span class="finance-status ${x.paymentStatus}">${esc(statusLabels[x.paymentStatus]||x.paymentStatus)}</span></td></tr>`).join("")}</tbody></table>`:`<div class="empty">مطالبهٔ باز ثبت نشده است.</div>`}</article>`}
function instructors(d){const t=d.totals;const rows=d.instructors??[];return `<div class="finance-cards"><div class="finance-card"><span>جلسات کلاس</span><b>${money(t.classSessions)}</b></div><div class="finance-card"><span>جلسات هنرجو</span><b>${money(t.studentSessions)}</b></div><div class="finance-card"><span>جلسات قابل محاسبه</span><b>${money(t.compensableSessions)}</b></div><div class="finance-card warn"><span>غیبت‌های قابل پرداخت</span><b>${money(t.absentSessions)}</b></div><div class="finance-card gold"><span>سهم اساتید</span><b>${money(t.instructorShare)}</b></div></div><article class="finance-panel"><h2>کارکرد و سهم مالی اساتید — ماه ${formatPersianMonth(d.month)}</h2>${rows.length?`<table class="finance-table"><thead><tr><th>استاد</th><th>درصد</th><th>جلسات</th><th>حاضر</th><th>غایب</th><th>قابل محاسبه</th><th>ارزش جلسات</th><th>سهم استاد</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.instructorName)}</td><td>${money(x.payPercentage)}٪</td><td>${money(x.classSessions)}</td><td>${money(x.presentSessions)}</td><td>${money(x.absentSessions)}</td><td>${money(x.compensableSessions)}</td><td>${money(x.sessionValueTotal)}</td><td>${x.hasSessionBasedAmount?money(x.instructorShare):"—"}</td></tr>`).join("")}</tbody></table>`:`<div class="empty">برای این ماه کارکردی ثبت نشده است.</div>`}</article>`}
function students(d){const t=d.totals;const rows=d.students??[];return `<div class="finance-cards"><div class="finance-card"><span>هنرجویان فعال دارای ترم</span><b>${money(t.students)}</b></div><div class="finance-card warn"><span>بدهکار</span><b>${money(t.debtors)}</b></div><div class="finance-card gold"><span>مانده کل</span><b>${money(t.outstanding)}</b></div><div class="finance-card"><span>مانده تا امروز</span><b>${money(t.dueToDate)}</b></div><div class="finance-card danger"><span>معوق</span><b>${money(t.overdue)}</b></div></div><article class="finance-panel"><h2>حساب هنرجویان</h2>${rows.length?`<table class="finance-table"><thead><tr><th>هنرجو</th><th>کلاس</th><th>ترم</th><th>شهریه</th><th>پرداخت</th><th>مانده</th><th>تا امروز</th><th>جلسات باقی</th><th>وضعیت</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.studentName)}</td><td>${esc(x.classTitle)}</td><td>${esc(x.termNumber??"—")}</td><td>${money(x.invoiceAmount)}</td><td>${money(x.paidAmount)}</td><td>${money(x.balance)}</td><td>${money(x.balanceToDate)}</td><td>${esc(x.remainingSessions??"—")}</td><td><span class="finance-status ${x.financialStatus}">${esc(statusLabels[x.financialStatus]||x.financialStatus)}</span></td></tr>`).join("")}</tbody></table>`:`<div class="empty">هنرجوی دارای ترم فعال پیدا نشد.</div>`}</article>`}
async function load(){try{clearError();setDateInput();const [academyData,instructorData,studentData]=await Promise.all([getJson(`/api/admin/daily-finance?date=${encodeURIComponent(state.date)}`),getJson(`/api/admin/teacher-workload?month=${encodeURIComponent(monthOf(state.date))}`),getJson(`/api/admin/finance-students?date=${encodeURIComponent(state.date)}`)]);$("#academyTab").innerHTML=academy(academyData);$("#instructorsTab").innerHTML=instructors(instructorData);$("#studentsTab").innerHTML=students(studentData)}catch(e){showError(e instanceof Error?e.message:"دریافت اطلاعات مالی ناموفق بود")}}
$(".finance-tabs").addEventListener("click",(e)=>{const b=e.target.closest("button[data-tab]");if(!b)return;document.querySelectorAll(".finance-tabs button").forEach(x=>x.classList.toggle("is-active",x===b));document.querySelectorAll(".finance-tab-panel").forEach(x=>x.hidden=x.id!==`${b.dataset.tab}Tab`)});
$("#financeDate").addEventListener("change",e=>{const input=e.target;const next=gregorianFromPersian(input.value);if(!next){input.value=formatPersianDate(state.date);showError("تاریخ شمسی معتبر نیست. نمونه: ۱۴۰۵/۰۶/۱۶");return}state.date=next;load()});
$("#financePrev").addEventListener("click",()=>{const d=parseIso(state.date);d.setUTCDate(d.getUTCDate()-1);state.date=isoDate(d);load()});
$("#financeNext").addEventListener("click",()=>{const d=parseIso(state.date);d.setUTCDate(d.getUTCDate()+1);state.date=isoDate(d);load()});
$("#financeToday").addEventListener("click",()=>{state.date=new Date().toISOString().slice(0,10);load()});
load();
</script>
