---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/registrations.css";
import { env } from "cloudflare:workers";
import { getAdminSession } from "../../server/admin-auth";

const session = await getAdminSession(Astro.request, env);
if (!session) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
---
<MainLayout title="مدیریت ثبت‌نام‌ها | آموزشگاه موسیقی فاتح" noindex={true}>
  <main class="admin-shell" data-admin-registrations>
    <section class="admin-hero no-print"><p>ثبت‌نام‌ها</p><h1>نمایش و پرینت ثبت‌نام‌های سایت</h1><p>فهرست ثبت‌نام‌های هنرجویان آموزشگاه موسیقی فاتح را بررسی، وضعیت پیگیری را ثبت و خروجی چاپی تهیه کنید.</p></section>
    <section class="admin-login no-print"><p>کاربر: <strong>{session.username}</strong></p><button id="loadRegistrations" type="button">بارگذاری ثبت‌نام‌ها</button><button id="printRegistrations" type="button">پرینت</button><button id="adminLogout" type="button">خروج</button><p id="adminMessage" role="status"></p></section>
    <section class="admin-table-wrap"><table class="admin-table"><thead><tr><th>کد</th><th>هنرجو</th><th>موبایل</th><th>دوره</th><th>استاد</th><th>زمان</th><th>وضعیت</th><th class="no-print">عملیات</th></tr></thead><tbody id="registrationsBody"></tbody></table></section>
  </main>
  <script>
    import "../../scripts/admin/registrations.js";
  </script>
  <script is:inline>
    document.querySelector("#adminLogout")?.addEventListener("click", async () => {
      await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
      window.location.assign("/admin/login");
    });
  </script>
</MainLayout>
