---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/registrations.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";

const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
const allowedRoles: string[] = [ROLES.ADMIN, ROLES.REGISTRAR];
if (!allowedRoles.includes(session.role)) return Astro.redirect("/admin");
---
<MainLayout title="مدیریت ثبت‌نام‌ها | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout"><AdminNav session={session} active="registration" /><main class="admin-main"><div class="admin-shell" data-admin-registrations>
    <section class="admin-hero no-print"><p>ثبت‌نام‌ها</p><h1>ثبت‌نام‌های سایت</h1><p>مشاهده، پیگیری و پرینت ثبت‌نام‌ها.</p></section>
    <section class="admin-login no-print"><p>وارد شده به‌عنوان: <strong>{session.username}</strong></p><p class="admin-live-status" id="liveStatus">در حال بارگذاری...</p><button id="printRegistrations">پرینت</button></section>
    <section class="admin-table-wrap"><table class="admin-table"><thead><tr><th>کد</th><th>هنرجو</th><th>کد ملی</th><th>موبایل</th><th>دوره</th><th>استاد</th><th>زمان</th><th>وضعیت</th><th class="no-print">عملیات</th></tr></thead><tbody id="registrationsBody"><tr><td colspan="9" class="admin-table-empty">در حال بارگذاری ثبت‌نام‌ها...</td></tr></tbody></table></section>
  </div></main></div>
  <script>import "../../scripts/admin/registrations.js";</script>
</MainLayout>
