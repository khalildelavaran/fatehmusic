---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/dashboard.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";

const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/admin/login");
const allowedRoles: string[] = [ROLES.ADMIN, ROLES.REGISTRAR];
if (!allowedRoles.includes(session.role)) return Astro.redirect("/admin");

const enrollmentIdParam = Astro.url.searchParams.get("enrollmentId");
const enrollmentId = enrollmentIdParam ? Number(enrollmentIdParam) : null;
const studentName = Astro.url.searchParams.get("studentName") ?? "";

const pageTitle = studentName ? `ارزیابی و تمرین ${studentName} | آموزشگاه موسیقی فاتح` : "ارزیابی و تمرین | آموزشگاه موسیقی فاتح";
---
<MainLayout title={pageTitle} noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="classes" />
    <main class="admin-main">
      <div class="admin-shell">
        {!enrollmentId || !Number.isInteger(enrollmentId) ? (
          <section class="admin-hero">
            <p>خطا</p>
            <h1>شناسه ثبت‌نام مشخص نشده است</h1>
            <p>این صفحه باید از طریق فهرست هنرجویان یک کلاس باز شود.</p>
            <p><a href="/admin/classes">بازگشت به کلاس‌ها</a></p>
          </section>
        ) : (
          <Fragment>
            <section class="admin-hero">
              <p><a href="/admin/classes">← بازگشت به کلاس‌ها</a></p>
              <h1>ارزیابی و تمرین{studentName ? ` — ${studentName}` : ""}</h1>
            </section>

            <div class="admin-profile-grid">
              <section class="admin-card">
                <h2>ثبت ارزیابی جدید</h2>
                <form id="evaluationForm" class="admin-form" data-enrollment-id={enrollmentId}>
                  <label>نمره فن‌آوری (۰-۱۰۰)<input name="technique" type="number" min="0" max="100" /></label>
                  <label>نمره ریتم (۰-۱۰۰)<input name="rhythm" type="number" min="0" max="100" /></label>
                  <label>نمره تئوری (۰-۱۰۰)<input name="theory" type="number" min="0" max="100" /></label>
                  <label>نمره اجرا (۰-۱۰۰)<input name="performance" type="number" min="0" max="100" /></label>
                  <label>نمره انضباط (۰-۱۰۰)<input name="discipline" type="number" min="0" max="100" /></label>
                  <label>نمره کلی (۰-۱۰۰)<input name="overall" type="number" min="0" max="100" required /></label>
                  <label>توضیحات<textarea name="comment" rows="2"></textarea></label>
                  <div class="admin-form-actions">
                    <button type="submit">ثبت ارزیابی</button>
                    <span id="evaluationFormStatus" class="admin-live-status"></span>
                  </div>
                </form>
              </section>

              <section class="admin-card">
                <h2>ثبت تمرین جدید</h2>
                <form id="assignmentForm" class="admin-form" data-enrollment-id={enrollmentId}>
                  <label>عنوان تمرین<input name="title" required /></label>
                  <label>توضیحات<textarea name="description" rows="2"></textarea></label>
                  <label>مهلت انجام<input name="dueDate" type="date" /></label>
                  <div class="admin-form-actions">
                    <button type="submit">ثبت تمرین</button>
                    <span id="assignmentFormStatus" class="admin-live-status"></span>
                  </div>
                </form>
              </section>
            </div>

            <div class="admin-section-title"><h2>سوابق ارزیابی</h2></div>
            <section class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th>تاریخ</th><th>نمره کلی</th><th>فن‌آوری</th><th>ریتم</th><th>تئوری</th><th>اجرا</th><th>انضباط</th><th>توضیحات</th></tr></thead>
                <tbody id="evaluationsBody" data-enrollment-id={enrollmentId}>
                  <tr><td colspan="8" class="admin-table-empty">در حال بارگذاری...</td></tr>
                </tbody>
              </table>
            </section>

            <div class="admin-section-title"><h2>سوابق تمرین</h2></div>
            <section class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th>عنوان</th><th>مهلت</th><th>وضعیت</th><th>یادداشت هنرجو</th></tr></thead>
                <tbody id="assignmentsBody" data-enrollment-id={enrollmentId}>
                  <tr><td colspan="4" class="admin-table-empty">در حال بارگذاری...</td></tr>
                </tbody>
              </table>
            </section>
          </Fragment>
        )}
      </div>
    </main>
  </div>
  {enrollmentId && Number.isInteger(enrollmentId) && <script>import "../../scripts/admin/evaluations.js";</script>}
</MainLayout>
