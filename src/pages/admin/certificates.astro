---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/posts.css";
import "../../styles/admin/certificates.css";
import "../../styles/shared/jalali-date-picker.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";
const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN) return Astro.redirect("/admin");
---
<MainLayout title="صدور گواهی | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="certificates" />
    <main class="admin-main"><div class="admin-shell" data-admin-certificates>
      <section class="admin-hero"><p>گواهی‌ها</p><h1>صدور گواهی</h1><p>نوع گواهی را انتخاب کنید، اطلاعات هنرجو و برنامه را وارد کنید و PDF نهایی را بسازید.</p></section>
      <section class="admin-panel admin-panel--certificates admin-cert-search-panel"><div class="admin-form"><label>جستجوی هنرجو (نام یا کد پیگیری)<input type="text" id="studentSearch" placeholder="مثلا: پریسا یا FM-2026-483920" autocomplete="off" /></label><div id="searchResults" class="admin-cert-results"></div></div></section>
      <section class="admin-panel admin-panel--certificates" id="certFormSection" hidden><div class="admin-cert-selected" id="selectedSummary"></div><form id="certForm" class="admin-form">
        <input type="hidden" id="registrationId" />
        <label class="form-full">نوع گواهی<select id="certificateType"><option value="course_completion">گواهی پایان دوره</option><option value="concert_participation">گواهی شرکت در کنسرت</option><option value="student_performance">گواهی اجرای هنرجویی</option><option value="workshop_participation">گواهی شرکت در کارگاه</option></select></label>
        <label>کد ملی هنرجو<input type="text" id="nationalId" required placeholder="مثلا: 1234567890" /><small class="field-hint" id="nationalIdHint" hidden></small></label>
        <label><span id="dateLabel">تاریخ پایان دوره (شمسی)</span><input type="text" id="completionDate" data-jalali-date-picker required placeholder="۱۴۰۵/۰۲/۰۱" aria-label="تاریخ به شمسی" /></label>
        <div id="courseFields" class="form-full"><label>سطح (اختیاری)<select id="level"><option value="">— بدون بج سطح —</option><option value="1">۱ (مقدماتی)</option><option value="2">۲ (متوسط)</option><option value="3">۳ (پیشرفته)</option><option value="4">۴ (عالی)</option></select></label><label>کتاب (اختیاری)<select id="bookId"><option value="">— بدون ذکر کتاب مشخص —</option></select></label><label class="form-full">توضیح تکمیلی برنامه‌ی درسی (اختیاری)<input type="text" id="curriculumNote" placeholder="مثلا: اجرای آهنگ‌های پاپ همراه با آکوردها و ریتم‌ها" /></label></div>
        <div id="eventFields" class="form-full" hidden><label>عنوان برنامه / کنسرت / کارگاه<input type="text" id="eventTitle" placeholder="مثلا: کنسرت هنرجویی بهار ۱۴۰۵" /></label><label>تاریخ برنامه (شمسی)<input type="text" id="eventDate" data-jalali-date-picker placeholder="۱۴۰۵/۰۲/۰۱" /></label><label id="eventRoleWrap">نقش هنرجو / عنوان اجرا<input type="text" id="eventRole" placeholder="مثلا: نوازنده گیتار / اجرای قطعه ..." /></label><label id="eventInstructorWrap">مدرس / استاد<input type="text" id="eventInstructor" placeholder="نام مدرس یا استاد کارگاه" /></label><label id="workshopHoursWrap">مدت کارگاه (ساعت)<input type="text" id="workshopHours" placeholder="مثلا: ۶" /></label><label class="form-full">توضیحات / موضوع / قطعات اجراشده<input type="text" id="eventDetails" placeholder="مثلا: اجرای قطعه ... یا موضوع کارگاه ..." /></label></div>
        <div class="admin-form-actions admin-cert-actions"><button type="submit" id="issueBtn">صدور گواهی</button><button type="button" id="pdfBtn" class="secondary" disabled>تولید PDF گواهی</button><button type="button" class="secondary" id="cancelSelection">انصراف</button></div>
      </form></section><p id="certStatus" role="status" class="admin-ai-status"></p>
    </div></main>
  </div>
  <script>import "../../scripts/admin/certificates.js";import "../../scripts/shared/jalali-date-picker.js";</script>
</MainLayout>
