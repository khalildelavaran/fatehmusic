---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/nav.css";
import "../../styles/admin/posts.css";
import { getAdminSession, ROLES, type AdminEnv } from "../../server/admin-auth";

const session = await getAdminSession(Astro.request, env as AdminEnv);
if (!session) return Astro.redirect("/login");
if (session.role !== ROLES.ADMIN) return Astro.redirect("/admin");
---
<MainLayout title="مدیریت نوشته‌ها | آموزشگاه موسیقی فاتح" noindex={true}>
  <div class="admin-layout">
    <AdminNav session={session} active="posts" />
    <main class="admin-main">
      <div class="admin-shell" data-admin-posts>
        <section class="admin-hero">
          <p>مدیریت محتوا</p>
          <h1>نوشته‌های وبلاگ</h1>
          <p>مقاله‌ها را مدیریت کنید یا در محیط ویرایش حرفه‌ای بنویسید.</p>
        </section>

        <div class="posts-tabs" role="tablist" aria-label="بخش‌های مدیریت نوشته‌ها">
          <button type="button" id="postsTab" class="posts-tab is-active" role="tab" aria-selected="true" aria-controls="postsPanel" data-posts-tab="posts">نوشته‌ها</button>
          <button type="button" id="writeTab" class="posts-tab" role="tab" aria-selected="false" aria-controls="writePanel" data-posts-tab="write" tabindex="-1">نوشتن مقاله</button>
        </div>

        <section id="postsPanel" class="posts-tab-panel is-active" role="tabpanel" aria-labelledby="postsTab">
          <p id="postsStatus" role="status" class="admin-ai-status">در حال بارگذاری نوشته‌ها...</p>
          <section class="admin-panel posts-list-panel">
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th class="posts-th-nowrap">عنوان</th><th class="posts-th-nowrap">موضوع</th><th>وضعیت</th><th class="posts-th-nowrap">به‌روزرسانی</th><th>عملیات</th></tr></thead>
                <tbody id="postsList"><tr><td colspan="5" class="admin-table-empty">در حال بارگذاری نوشته‌ها...</td></tr></tbody>
              </table>
            </div>
          </section>
        </section>

        <section id="writePanel" class="posts-tab-panel" role="tabpanel" aria-labelledby="writeTab" hidden>
          <section class="ai-writing-strip" aria-label="تولید مقاله با هوش مصنوعی">
            <div class="ai-writing-copy"><span class="ai-writing-icon" aria-hidden="true">✦</span><div><strong>پیش‌نویس با هوش مصنوعی</strong><span>ساخت آزمایشی پیش‌نویس با تنظیمات فعلی سرور.</span></div></div>
            <button type="button" id="generateNowButton" class="ai-writing-button">تولید پیش‌نویس</button>
          </section>
          <p id="generateStatus" role="status" class="admin-ai-status"></p>

          <section class="admin-write-panel">
            <form id="postForm" class="post-composer">
              <input type="hidden" name="id" />

              <label class="article-title-field">
                <span>عنوان مقاله</span>
                <input name="title" required placeholder="عنوان مقاله را اینجا بنویسید…" />
              </label>

              <section class="editor-workspace" aria-labelledby="contentEditorHeading">
                <header class="editor-workspace-header">
                  <div>
                    <h2 id="contentEditorHeading">محتوای مقاله</h2>
                    <p>ابزارهای قالب‌بندی در حالت دیداری و کد HTML در حالت متن در دسترس هستند.</p>
                  </div>
                  <span class="editor-word-badge" id="editorWordCount">۰ کلمه</span>
                </header>

                <div class="rich-editor" id="richEditor">
                  <div class="editor-modebar" role="tablist" aria-label="حالت ویرایش مقاله">
                    <button type="button" class="editor-mode is-active" data-editor-mode="visual" role="tab" aria-selected="true"><span aria-hidden="true">▤</span> دیداری</button>
                    <button type="button" class="editor-mode" data-editor-mode="html" role="tab" aria-selected="false"><span aria-hidden="true">&lt;/&gt;</span> کد HTML</button>
                    <button type="button" class="editor-mode" data-editor-mode="preview" role="tab" aria-selected="false"><span aria-hidden="true">◉</span> پیش‌نمایش</button>
                    <span class="editor-mode-spacer"></span>
                    <span class="editor-mode-hint">محتوا فقط پس از ذخیره منتشر می‌شود</span>
                  </div>

                  <div class="rich-editor-toolbar" role="toolbar" aria-label="ابزارهای قالب‌بندی متن">
                    <div class="rich-toolbar-row">
                      <div class="rich-tool-group rich-tool-group-selects">
                        <select data-editor-block aria-label="نوع پاراگراف" title="نوع پاراگراف">
                          <option value="p">پاراگراف</option><option value="h2">عنوان ۲</option><option value="h3">عنوان ۳</option><option value="h4">عنوان ۴</option><option value="blockquote">نقل‌قول</option><option value="pre">کد</option>
                        </select>
                        <select data-editor-font aria-label="نوع قلم" title="نوع قلم">
                          <option value="">قلم</option><option value="Arial">Arial</option><option value="Tahoma">Tahoma</option><option value="Verdana">Verdana</option><option value="Georgia">Georgia</option><option value="'Times New Roman'">Times New Roman</option><option value="'Courier New'">Courier New</option>
                        </select>
                        <select data-editor-size aria-label="اندازه قلم" title="اندازه قلم">
                          <option value="">اندازه</option><option value="12px">۱۲</option><option value="14px">۱۴</option><option value="16px">۱۶</option><option value="18px">۱۸</option><option value="20px">۲۰</option><option value="24px">۲۴</option><option value="28px">۲۸</option><option value="32px">۳۲</option>
                        </select>
                      </div>
                      <span class="rich-toolbar-separator" aria-hidden="true"></span>
                      <div class="rich-tool-group rich-tool-group-compact">
                        <button type="button" class="rich-tool-button" data-editor-command="bold" title="ضخیم (Ctrl+B)" aria-label="ضخیم"><strong>B</strong></button>
                        <button type="button" class="rich-tool-button" data-editor-command="italic" title="ایتالیک (Ctrl+I)" aria-label="ایتالیک"><em>I</em></button>
                        <button type="button" class="rich-tool-button" data-editor-command="underline" title="زیرخط (Ctrl+U)" aria-label="زیرخط"><u>U</u></button>
                        <button type="button" class="rich-tool-button" data-editor-command="strikeThrough" title="خط‌خورده" aria-label="خط‌خورده"><s>S</s></button>
                        <label class="rich-color-tool" title="رنگ متن"><span>A</span><input type="color" data-editor-color="foreColor" aria-label="رنگ متن" value="#262626" /></label>
                        <label class="rich-color-tool rich-highlight-tool" title="هایلایت"><span aria-hidden="true">▰</span><input type="color" data-editor-color="hiliteColor" aria-label="رنگ پس‌زمینه متن" value="#fff09a" /></label>
                      </div>
                      <span class="rich-toolbar-separator" aria-hidden="true"></span>
                      <div class="rich-tool-group rich-tool-group-compact">
                        <button type="button" class="rich-tool-button" data-editor-command="justifyRight" title="راست‌چین" aria-label="راست‌چین">≡<span class="toolbar-icon-detail">R</span></button>
                        <button type="button" class="rich-tool-button" data-editor-command="justifyCenter" title="وسط‌چین" aria-label="وسط‌چین">≡</button>
                        <button type="button" class="rich-tool-button" data-editor-command="justifyLeft" title="چپ‌چین" aria-label="چپ‌چین"><span class="toolbar-icon-left">≡</span></button>
                        <button type="button" class="rich-tool-button" data-editor-command="justifyFull" title="تراز کامل" aria-label="تراز کامل">☷</button>
                      </div>
                      <span class="rich-toolbar-separator" aria-hidden="true"></span>
                      <div class="rich-tool-group rich-tool-group-compact">
                        <button type="button" class="rich-tool-button" data-editor-command="insertUnorderedList" title="فهرست نقطه‌ای" aria-label="فهرست نقطه‌ای">•≡</button>
                        <button type="button" class="rich-tool-button" data-editor-command="insertOrderedList" title="فهرست شماره‌ای" aria-label="فهرست شماره‌ای">1≡</button>
                        <button type="button" class="rich-tool-button" data-editor-command="outdent" title="کاهش تورفتگی" aria-label="کاهش تورفتگی">⇤</button>
                        <button type="button" class="rich-tool-button" data-editor-command="indent" title="افزایش تورفتگی" aria-label="افزایش تورفتگی">⇥</button>
                      </div>
                      <span class="rich-toolbar-separator" aria-hidden="true"></span>
                      <div class="rich-tool-group rich-tool-group-compact">
                        <button type="button" class="rich-tool-button" data-editor-insert="link" title="افزودن لینک" aria-label="افزودن لینک">↗</button>
                        <button type="button" class="rich-tool-button" data-editor-command="unlink" title="حذف لینک" aria-label="حذف لینک">⌁</button>
                        <button type="button" class="rich-tool-button" data-editor-insert="image" title="افزودن تصویر" aria-label="افزودن تصویر">▧</button>
                        <button type="button" class="rich-tool-button" data-editor-insert="table" title="افزودن جدول" aria-label="افزودن جدول">▦</button>
                        <button type="button" class="rich-tool-button" data-editor-command="insertHorizontalRule" title="خط جداکننده" aria-label="خط جداکننده">―</button>
                      </div>
                      <span class="rich-toolbar-separator" aria-hidden="true"></span>
                      <div class="rich-tool-group rich-tool-group-compact">
                        <button type="button" class="rich-tool-button" data-editor-command="undo" title="واگرد" aria-label="واگرد">↶</button>
                        <button type="button" class="rich-tool-button" data-editor-command="redo" title="ازنو" aria-label="ازنو">↷</button>
                        <button type="button" class="rich-tool-button" data-editor-command="removeFormat" title="پاک‌کردن قالب" aria-label="پاک‌کردن قالب">Tx</button>
                      </div>
                    </div>
                  </div>

                  <div id="contentEditor" class="rich-editor-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-label="متن مقاله" aria-required="true" dir="rtl" data-placeholder="نوشتن مقاله را از اینجا شروع کنید…"></div>

                  <div class="code-editor-view" id="codeEditorView" hidden>
                    <div class="code-editor-toolbar">
                      <div class="code-editor-language"><span class="code-language-dot"></span><strong>HTML</strong><span>ویرایش کد منبع</span></div>
                      <div class="code-editor-actions">
                        <button type="button" class="code-tool-button" id="formatHtmlButton" title="مرتب‌سازی کد">مرتب‌سازی کد</button>
                        <button type="button" class="code-tool-button code-tool-primary" id="expandEmmetButton" title="گسترش مخفف Emmet (Tab)">گسترش Emmet <kbd>Tab</kbd></button>
                      </div>
                    </div>
                    <div class="code-editor-shell" dir="ltr">
                      <div class="code-line-numbers-gutter" aria-hidden="true"><pre class="code-line-numbers" id="codeLineNumbers">1</pre></div>
                      <div class="code-editor-input-wrap">
                        <pre class="rich-editor-highlight" id="contentSourceHighlight" aria-hidden="true"><code id="contentSourceHighlightCode"></code></pre>
                        <textarea id="contentSource" class="rich-editor-source" aria-label="کد HTML متن مقاله" dir="ltr" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off" hidden></textarea>
                      </div>
                    </div>
                    <footer class="code-editor-status">
                      <span id="editorCursorPosition">سطر ۱، ستون ۱</span><span id="editorLineCount">۱ خط</span><span>HTML · UTF-8</span>
                    </footer>
                  </div>

                  <div id="contentPreview" class="rich-editor-preview article-content" dir="rtl" hidden></div>
                  <textarea id="contentValue" name="content" hidden></textarea>
                  <footer class="rich-editor-footer">
                    <p id="editorStatus" role="status">برای نوشتن معمولی از حالت دیداری استفاده کنید؛ برای ویرایش دقیق، به کد HTML بروید.</p>
                    <span>ذخیره خودکار غیرفعال است</span>
                  </footer>
                </div>
              </section>

              <label class="article-excerpt-field">
                <span>خلاصه مقاله</span>
                <textarea name="excerpt" rows="3" required placeholder="خلاصه کوتاه برای صفحه وبلاگ و نتایج جست‌وجو…"></textarea>
              </label>

              <details class="post-settings" open>
                <summary><span>تنظیمات مقاله و سئو</span><small>نشانی صفحه، موضوع، دوره مرتبط و اطلاعات موتورهای جست‌وجو</small></summary>
                <div class="post-settings-grid">
                  <label><span>اسلاگ انگلیسی</span><input name="slug" dir="ltr" required placeholder="example-article" /></label>
                  <label><span>موضوع مقاله</span><input name="topic" required placeholder="آموزش گیتار" /></label>
                  <label><span>اسلاگ دوره مرتبط</span><input name="related_course_slug" dir="ltr" placeholder="guitar-course" /></label>
                  <label><span>عنوان دوره مرتبط</span><input name="related_course_title" placeholder="آموزش گیتار" /></label>
                  <label><span>Meta Title</span><input name="meta_title" placeholder="عنوان برای موتورهای جست‌وجو" /></label>
                  <label><span>وضعیت انتشار</span><select name="status"><option value="draft">پیش‌نویس</option><option value="published">منتشر شده</option></select></label>
                  <label class="settings-full"><span>Meta Description</span><textarea name="meta_description" rows="3" placeholder="توضیحات صفحه برای نتایج جست‌وجو…"></textarea></label>
                </div>
              </details>

              <div class="post-save-bar">
                <p id="adminMessage" role="status" class="post-save-status">تغییرات شما تا زمان ذخیره در وب‌سایت اعمال نمی‌شوند.</p>
                <div class="admin-form-actions"><button type="submit" class="post-save-primary">ذخیره نوشته</button><button type="button" class="secondary" id="clearForm">نوشته جدید</button></div>
              </div>
            </form>
          </section>
        </section>
      </div>
    </main>
  </div>
  <script>import "../../scripts/admin/posts.js";</script>
</MainLayout>
