---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/admin/base.css";
import "../../styles/admin/dashboard.css";
import { env } from "cloudflare:workers";
import { getAdminSession } from "../../server/admin-auth";

export const prerender = false;

const session = await getAdminSession(Astro.request, env);
if (!session) return Astro.redirect("/admin/login");
---
<MainLayout title="داشبورد مدیریت | آموزشگاه موسیقی فاتح" noindex={true}>
  <main class="admin-shell">
    <section class="admin-hero">
      <p>داشبورد داخلی</p>
      <h1>مدیریت محتوای آموزشگاه موسیقی فاتح</h1>
      <p>کاربر: {session.username} — برای مدیریت نوشته‌ها و بررسی ثبت‌نام‌های سایت از بخش‌های زیر استفاده کنید.</p>
    </section>
    <nav class="admin-grid" aria-label="بخش‌های مدیریت">
      <a href="/admin/posts"><strong>مدیریت نوشته‌ها</strong><span>ایجاد، ویرایش، انتشار و پیش‌نویس مقاله‌های وبلاگ</span></a>
      <a href="/admin/registration"><strong>ثبت‌نام‌های سایت</strong><span>نمایش، پیگیری و پرینت ثبت‌نام‌های ثبت‌شده در سایت</span></a>
    </nav>
    <p><button id="adminLogout" type="button">خروج از حساب مدیریت</button></p>
  </main>
  <script>
    document.querySelector("#adminLogout")?.addEventListener("click", async () => {
      await fetch("/api/admin/logout", { method: "POST" });
      window.location.assign("/admin/login");
    });
  </script>
</MainLayout>
