---
import { env } from "cloudflare:workers";
import MainLayout from "../../layouts/MainLayout.astro";
import { getInstructorSession, type InstructorEnv } from "../../server/instructor-auth";
import "../../styles/student.css";

const session = await getInstructorSession(Astro.request, env as InstructorEnv);
if (!session) return Astro.redirect("/instructor/login");
---
<MainLayout title="داشبورد مدرس | آموزشگاه موسیقی فاتح" noindex={true}>
<main class="student-dashboard" dir="rtl">
<aside class="student-sidebar">
  <div class="student-sidebar-brand"><img src="/logo.webp" alt="آموزشگاه موسیقی فاتح"/><strong>آموزشگاه موسیقی فاتح</strong></div>
  <nav aria-label="ناوبری داشبورد مدرس">
    <a href="#today">جلسات امروز</a>
    <a href="#finance">مالی</a>
    <a href="#classes">کلاس‌های من</a>
    <a href="#students">هنرجویان</a>
    <a href="#account">حساب کاربری</a>
  </nav>
  <button class="student-logout" id="logoutButton" type="button">خروج از حساب</button>
</aside>
<section class="student-main">
<header class="student-top"><div><img src="/logo.webp" alt="فاتح"/><div><strong>داشبورد مدرس</strong><span id="instructorNameLabel">در حال بارگذاری...</span></div></div></header>
<div id="instructorApp"><p class="student-loading">در حال بارگذاری اطلاعات...</p></div>
</section>
</main>
<script>
const app = document.querySelector('#instructorApp');
const nameLabel = document.querySelector('#instructorNameLabel');
const esc = (v) => String(v ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');
const todayISO = () => new Date().toISOString().slice(0, 10);
const currentMonth = () => new Date().toISOString().slice(0, 7);
const money = (v) => `${Math.round(Number(v ?? 0)).toLocaleString('fa-IR')} تومان`;
const monthLabel = (month) => { const [y, m] = month.split('-').map(Number); return new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long' }).format(new Date(Date.UTC(y, m - 1, 1))); };

const ATTENDANCE_LABEL = { pending: 'ثبت‌نشده', present: 'حاضر', absent: 'غایب', excused: 'مرخصی' };

async function api(path, options) {
  const r = await fetch(path, { credentials: 'same-origin', ...options });
  if (r.status === 401) { location.href = '/instructor/login'; throw new Error('unauthorized'); }
  return r.json();
}

function sessionCard(s, students) {
  const own = students.filter((st) => st.session_id === s.session_id);
  return `<article class="student-item">
    <div class="student-item-icon">♪</div>
    <h3>${esc(s.class_title)}</h3>
    <p>ساعت: ${esc(s.start_time)} - ${esc(s.end_time)}${s.room_name ? ` · ${esc(s.room_name)}` : ''}</p>
    <p>وضعیت جلسه: ${esc(s.session_status === 'cancelled' ? 'لغوشده' : s.session_status === 'completed' ? 'برگزارشده' : 'برنامه‌ریزی‌شده')}</p>
    ${s.calendar_warning ? `<p style="color:#d98d8d">توجه تقویمی: ${esc(s.calendar_warning)}</p>` : ''}
    <div class="student-grid" style="margin-top:12px">
      ${own.length ? own.map((st) => `
        <div class="student-item" style="padding:14px">
          <h3 style="font-size:1rem">${esc(st.student_name)}</h3>
          <p>حضور: <strong>${esc(ATTENDANCE_LABEL[st.attendance] ?? st.attendance)}</strong></p>
          <p>جلسات مصرف‌شده: ${esc(st.consumed_sessions)}${st.planned_sessions != null ? ` از ${esc(st.planned_sessions)}` : ''}</p>
          <div class="student-actions">
            <button data-attendance="present" data-esid="${st.enrollment_session_id}">حاضر</button>
            <button data-attendance="absent" data-esid="${st.enrollment_session_id}">غایب</button>
            <button data-attendance="excused" data-esid="${st.enrollment_session_id}">مرخصی</button>
          </div>
          <div class="student-actions">
            <button data-eval-enrollment="${st.enrollment_session_id}" data-eval-session="${s.session_id}" data-student-name="${esc(st.student_name)}">ثبت ارزیابی</button>
          </div>
        </div>
      `).join('') : '<p class="student-empty">هنرجویی برای این جلسه یافت نشد.</p>'}
    </div>
  </article>`;
}

function classCard(c) {
  return `<article class="student-item"><div class="student-item-icon">▤</div><h3>${esc(c.title)}</h3><p>وضعیت: ${esc(c.status === 'active' ? 'فعال' : c.status)}</p><p>تعداد هنرجو: ${esc(c.studentCount)}${c.capacity ? ` از ${esc(c.capacity)} ظرفیت` : ''}</p>${c.room ? `<p>سالن: ${esc(c.room)}</p>` : ''}</article>`;
}

function studentCard(s) {
  return `<article class="student-item"><div class="student-item-icon">☺</div><h3>${esc(s.firstName)} ${esc(s.lastName)}</h3><p>کلاس: ${esc(s.classTitle)}</p><p>وضعیت ثبت‌نام: ${esc(s.enrollmentStatus === 'active' ? 'فعال' : s.enrollmentStatus)}</p><div class="student-actions"><button data-eval-enrollment="${s.enrollmentId}" data-eval-session="" data-student-name="${esc(s.firstName + ' ' + s.lastName)}">ثبت ارزیابی</button></div></article>`;
}

function financeStudentRows(rows) {
  const groups = new Map();
  for (const row of rows) {
    if (!groups.has(row.enrollment_id)) groups.set(row.enrollment_id, []);
    groups.get(row.enrollment_id).push(row);
  }
  return [...groups.values()].map((items) => {
    const first = items[0];
    const earned = items.reduce((sum, x) => sum + Number(x.sessionValue || 0), 0);
    const share = items.reduce((sum, x) => sum + Number(x.instructorShare || 0), 0);
    const balance = Math.max(...items.map((x) => Number(x.balance || 0)), 0);
    const hasDebt = balance > 0 && items.some((x) => x.billing_type === 'session_based');
    return `<tr><td>${esc(first.student_name)}</td><td>${esc(first.class_title)}</td><td>${items.length}</td><td>${money(earned)}</td><td>${money(share)}</td><td>${hasDebt ? '<span class="finance-debt">در انتظار پرداخت</span>' : first.paymentStatus === 'paid' ? '<span>پرداخت‌شده</span>' : '<span>بدون صورتحساب</span>'}</td></tr>`;
  }).join('');
}

function financePayments(rows) {
  if (!rows.length) return '<p class="student-empty">پرداختی در این ماه ثبت نشده است.</p>';
  return `<div class="finance-list">${rows.map((p) => `<div class="finance-row"><strong>${esc(p.student_name)}</strong><span>${money(p.amount)}</span><small>${esc(p.paid_at)} · ${esc(p.class_title || 'بدون عنوان کلاس')}</small></div>`).join('')}</div>`;
}

function priorDebtRows(rows) {
  if (!rows.length) return '<p class="student-empty">طلبی از ماه‌های قبل ثبت نشده است.</p>';
  return `<div class="finance-list">${rows.map((d) => `<div class="finance-row"><strong>${esc(d.student_name)}</strong><span>${money(d.balance)}</span><small>طلب از ماه قبل · ${esc(d.due_date)}${d.class_title ? ` · ${esc(d.class_title)}` : ''}</small></div>`).join('')}</div>`;
}

async function loadFinance(month = currentMonth()) {
  const section = document.querySelector('#financeContent');
  if (!section) return;
  section.innerHTML = '<p class="student-loading">در حال محاسبه اطلاعات مالی...</p>';
  const d = await api(`/api/instructor/finance?month=${encodeURIComponent(month)}`);
  if (!d.success) { section.innerHTML = `<p class="student-empty">${esc(d.message || 'اطلاعات مالی دریافت نشد.')}</p>`; return; }
  section.innerHTML = `
    <div class="finance-toolbar"><button id="financePrev" type="button">ماه قبل</button><strong>${esc(monthLabel(d.month))}</strong><button id="financeNext" type="button">ماه بعد</button></div>
    <div class="student-grid">
      <article class="student-item"><span class="student-eyebrow">جلسات</span><h3>${d.totals.sessions.toLocaleString('fa-IR')}</h3><p>${d.totals.compensableSessions.toLocaleString('fa-IR')} جلسه قابل محاسبه</p></article>
      <article class="student-item"><span class="student-eyebrow">ارزش جلسات</span><h3>${money(d.totals.sessionValue)}</h3><p>بر اساس شهریه و جلسات برنامه‌ریزی‌شده</p></article>
      <article class="student-item"><span class="student-eyebrow">سهم مدرس</span><h3>${money(d.totals.instructorShare)}</h3><p>درصد سهم: ${Number(d.instructor.payPercentage).toLocaleString('fa-IR')}٪</p></article>
      <article class="student-item"><span class="student-eyebrow">دریافت این ماه</span><h3>${money(d.totals.currentPayments)}</h3><p>بر اساس تاریخ واقعی paid_at</p></article>
      <article class="student-item"><span class="student-eyebrow">در انتظار پرداخت</span><h3>${money(d.totals.currentOutstanding)}</h3><p>مانده صورتحساب‌های مرتبط با جلسات این ماه</p></article>
      <article class="student-item"><span class="student-eyebrow">طلب از ماه قبل</span><h3>${money(d.totals.priorMonthDebt)}</h3><p>صورتحساب سررسیدشده و تسویه‌نشده</p></article>
    </div>
    <div class="student-item finance-panel"><h3>جزئیات مالی هنرجویان</h3><div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>هنرجو</th><th>کلاس</th><th>جلسه</th><th>ارزش جلسات</th><th>سهم مدرس</th><th>وضعیت</th></tr></thead><tbody>${financeStudentRows(d.details)}</tbody></table></div></div>
    <div class="student-item finance-panel"><h3>پرداخت‌های این ماه</h3>${financePayments(d.payments)}</div>
    <div class="student-item finance-panel"><h3>مطالبات منتقل‌شده از ماه قبل</h3>${priorDebtRows(d.priorDebt)}</div>
  `;
  document.querySelector('#financePrev')?.addEventListener('click', () => loadFinance(shiftMonth(d.month, -1)));
  document.querySelector('#financeNext')?.addEventListener('click', () => loadFinance(shiftMonth(d.month, 1)));
}

function shiftMonth(month, delta) { const [y, m] = month.split('-').map(Number); const d = new Date(Date.UTC(y, m - 1 + delta, 1)); return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`; }

async function markAttendance(enrollmentSessionId, status) {
  const d = await api('/api/instructor/attendance', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enrollmentSessionId: Number(enrollmentSessionId), status }) });
  if (!d.success) { alert(d.message || 'ثبت حضور انجام نشد.'); return; }
  await load();
}

async function submitEvaluation(enrollmentId, sessionId, studentName) {
  const overall = Number(prompt(`نمره کلی ارزیابی برای ${studentName} (۰ تا ۱۰۰):`));
  if (!Number.isFinite(overall)) return;
  const comment = prompt('توضیحات ارزیابی (اختیاری):') || '';
  const d = await api('/api/instructor/evaluations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enrollmentId: Number(enrollmentId), sessionId: sessionId ? Number(sessionId) : null, overall, comment }) });
  alert(d.success ? 'ارزیابی ثبت شد.' : (d.message || 'ثبت ارزیابی انجام نشد.'));
}

async function load() {
  const [me, dashboard, classes, students] = await Promise.all([api('/api/instructor/me'), api(`/api/instructor/dashboard?date=${todayISO()}`), api('/api/instructor/classes'), api('/api/instructor/students')]);
  if (!me.success) { app.innerHTML = `<p>${esc(me.message)}</p>`; return; }
  nameLabel.textContent = `${me.instructor.firstName} ${me.instructor.lastName}`;
  app.innerHTML = `
    ${me.instructor.mustChangePassword ? '<section class="student-alert"><strong>توجه:</strong> برای امنیت حساب، رمز عبور خود را تغییر دهید.</section>' : ''}
    <section id="today" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">امروز</span><h2>جلسات امروز</h2></div></div><div class="student-grid">${dashboard.success && dashboard.sessions.length ? dashboard.sessions.map((s) => sessionCard(s, dashboard.students)).join('') : '<p class="student-empty">جلسه‌ای برای امروز ثبت نشده است.</p>'}</div></section>
    <section id="finance" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">مالی</span><h2>گزارش مالی مدرس</h2><p>محاسبه بر مبنای جلسات واقعی، صورتحساب‌ها و پرداخت‌های ثبت‌شده.</p></div></div><div id="financeContent"><p class="student-loading">در حال بارگذاری...</p></div></section>
    <section id="classes" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">کلاس‌ها</span><h2>کلاس‌های من</h2></div></div><div class="student-grid">${classes.success && classes.classes.length ? classes.classes.map(classCard).join('') : '<p class="student-empty">کلاسی برای شما ثبت نشده است.</p>'}</div></section>
    <section id="students" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">هنرجویان</span><h2>هنرجویان من</h2></div></div><div class="student-grid">${students.success && students.students.length ? students.students.map(studentCard).join('') : '<p class="student-empty">هنرجویی برای شما ثبت نشده است.</p>'}</div></section>
    <section id="account" class="student-section"><div class="student-section-heading"><div><span class="student-eyebrow">حساب کاربری</span><h2>تغییر رمز عبور</h2></div></div><form id="passwordForm" class="student-password"><input id="newPassword" type="password" minlength="8" placeholder="رمز جدید، حداقل ۸ کاراکتر" required/><input id="repeatPassword" type="password" minlength="8" placeholder="تکرار رمز جدید" required/><button>ذخیره رمز جدید</button><p id="passwordStatus" class="student-status"></p></form></section>
  `;
  loadFinance();
}

app?.addEventListener('click', (e) => { const target = e.target; if (!(target instanceof HTMLElement)) return; if (target.dataset.attendance) { markAttendance(target.dataset.esid, target.dataset.attendance); return; } if (target.dataset.evalEnrollment !== undefined) { submitEvaluation(target.dataset.evalEnrollment, target.dataset.evalSession, target.dataset.studentName); return; } });
app?.addEventListener('submit', async (e) => { if (e.target.id !== 'passwordForm') return; e.preventDefault(); const status = document.querySelector('#passwordStatus'); const p = document.querySelector('#newPassword').value; if (p !== document.querySelector('#repeatPassword').value) { status.textContent = 'تکرار رمز یکسان نیست.'; return; } const d = await api('/api/instructor/password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ new_password: p }) }); status.textContent = d.message || 'انجام شد.'; if (d.success) document.querySelector('#passwordForm').reset(); });
async function logout() { await fetch('/api/instructor/logout', { method: 'POST', credentials: 'same-origin' }); location.href = '/instructor/login'; }
document.querySelector('#logoutButton')?.addEventListener('click', logout);
load();
</script>
<style>
.finance-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 18px}.finance-toolbar button{border:1px solid #d4af37;background:transparent;border-radius:10px;padding:8px 14px;cursor:pointer}.finance-panel{margin-top:18px}.finance-table-wrap{overflow:auto}.finance-table{width:100%;border-collapse:collapse;min-width:760px}.finance-table th,.finance-table td{padding:12px 10px;border-bottom:1px solid rgba(212,175,55,.18);text-align:right}.finance-table th{font-weight:700}.finance-debt{font-weight:700}.finance-list{display:grid;gap:8px}.finance-row{display:grid;grid-template-columns:1fr auto;gap:4px 12px;padding:12px;border:1px solid rgba(212,175,55,.16);border-radius:10px}.finance-row small{grid-column:1/-1;opacity:.72}
</style>
</MainLayout>