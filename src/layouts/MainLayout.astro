---
import "../styles/global.css";
import "../styles/reveal.css";
import { buildSEO } from "../seo/index.js";
import SEOAnswerSummary from "../components/SEOAnswerSummary.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: object[];
  keywords?: string[];
  topics?: string[];
  entityType?: string;
  lastModified?: string | Date;
  answerBlocks?: { question: string; answer: string; sourceUrl?: string; entityId?: string; priority?: number }[];
  linkCandidates?: object[];
  auditContext?: object;
  /** Enable expensive runtime semantic SEO diagnostics only when needed. */
  includeIntelligence?: boolean;
}

const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  imageType,
  canonical,
  noindex = false,
  schema = [],
  keywords = [],
  topics = [],
  entityType = "",
  lastModified,
  answerBlocks = [],
  linkCandidates,
  auditContext = {},
  includeIntelligence = true
} = Astro.props as Props;

const seo = buildSEO({
  path: Astro.url.pathname,
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  imageType,
  canonical,
  noindex,
  keywords,
  topics,
  entityType,
  lastModified,
  answerBlocks,
  linkCandidates,
  auditContext,
  extraSchema: schema,
  includeIntelligence
});

const openGraph = seo.openGraph as Record<string, string>;
const twitter = seo.twitter as Record<string, string>;

// JSON-LD is rendered with set:html, so escape HTML-significant characters
// inside the JSON string itself. This preserves valid JSON-LD while preventing
// a title/description containing "</script>" from terminating the script tag.
const safeSchemaJson = JSON.stringify(seo.schemaGraph)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026");

const pathname = Astro.url.pathname;
const isPrivateAppRoute = /^(?:\/(?:admin|student|instructor|dashboard|login))(?:\/|$)/.test(pathname);
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.metadata.title}</title>
    <meta name="description" content={seo.metadata.description} />
    <meta name="robots" content={seo.metadata.robots} />
    <meta name="author" content={seo.metadata.author} />
    <meta name="theme-color" content={seo.metadata.themeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" type="application/rss+xml" title="مقالات آموزشگاه موسیقی فاتح" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Self-hosted Vazirmatn (see src/styles/global.css). Preload the Persian subset only. -->
    <link rel="preload" href="/fonts/vazirmatn-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={openGraph["og:type"]} />
    <meta property="og:locale" content={openGraph["og:locale"]} />
    <meta property="og:site_name" content={openGraph["og:site_name"]} />
    <meta property="og:title" content={openGraph["og:title"]} />
    <meta property="og:description" content={openGraph["og:description"]} />
    <meta property="og:url" content={openGraph["og:url"]} />
    <meta property="og:image" content={openGraph["og:image"]} />
    <meta property="og:image:alt" content={openGraph["og:image:alt"]} />
    {openGraph["og:image:width"] && <meta property="og:image:width" content={openGraph["og:image:width"]} />}
    {openGraph["og:image:height"] && <meta property="og:image:height" content={openGraph["og:image:height"]} />}
    {openGraph["og:image:type"] && <meta property="og:image:type" content={openGraph["og:image:type"]} />}
    <meta name="twitter:card" content={twitter["twitter:card"]} />
    <meta name="twitter:title" content={twitter["twitter:title"]} />
    <meta name="twitter:description" content={twitter["twitter:description"]} />
    <meta name="twitter:image" content={twitter["twitter:image"]} />
    <meta name="twitter:image:alt" content={twitter["twitter:image:alt"]} />
    {twitter["twitter:site"] && <meta name="twitter:site" content={twitter["twitter:site"]} />}
    {twitter["twitter:creator"] && <meta name="twitter:creator" content={twitter["twitter:creator"]} />}

    <script is:inline type="application/ld+json" set:html={safeSchemaJson} />

    {!isPrivateAppRoute && (
      <>
        <!-- Analytics is intentionally delayed until the page is usable. -->
        <script src="../scripts/web-vitals.js"></script>

        <script is:inline>
          window.addEventListener("load", () => {
            const loadGoogleAnalytics = () => {
              if (window.__fatehGA) return;
              window.__fatehGA = true;

              const script = document.createElement("script");
              script.async = true;
              script.src = "https://www.googletagmanager.com/gtag/js?id=G-YKFKP4QH45";
              document.head.appendChild(script);

              window.dataLayer = window.dataLayer || [];
              window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
              window.gtag("js", new Date());
              window.gtag("config", "G-YKFKP4QH45", { send_page_view: true });
            };

            if ("requestIdleCallback" in window) {
              requestIdleCallback(loadGoogleAnalytics, { timeout: 2500 });
            } else {
              setTimeout(loadGoogleAnalytics, 1200);
            }
          }, { once: true });
        </script>

        <script is:inline>
          window.addEventListener("load", () => {
            const loadFacebookPixel = () => {
              if (window.fbq) return;
              !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
              n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
              n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;
              t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)
              }(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
              fbq("init", "830226966747297");
              fbq("track", "PageView");
            };
            if ("requestIdleCallback" in window) requestIdleCallback(loadFacebookPixel, { timeout: 3000 });
            else setTimeout(loadFacebookPixel, 1500);
          }, { once: true });
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
    <SEOAnswerSummary blocks={seo.geo.answerBlocks} />

    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/analytics.js"></script>
    <script src="../scripts/persian-digits.ts"></script>

    {isPrivateAppRoute && (
      <>
        <script src="../scripts/admin/finance-expenses.js"></script>
        <script src="../scripts/admin/finance-settlements.js"></script>
        <script src="../scripts/admin/finance-student-account.js"></script>
        <script src="../scripts/shared/print.ts"></script>
      </>
    )}
  </body>
</html>
