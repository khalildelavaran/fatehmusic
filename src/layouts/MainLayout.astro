---
import "../styles/global.css";
import "../styles/reveal.css";

import { buildSEO } from "../seo/index.js";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: object[];
}

const {
  title,
  description,
  image,
  canonical,
  noindex = false,
  schema = []
} = Astro.props;

const seo = buildSEO({
  path: Astro.url.pathname,
  title,
  description,
  image,
  canonical,
  noindex,
  extraSchema: schema
});
---

<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{seo.metadata.title}</title>

  <meta
    name="description"
    content={seo.metadata.description}
  />

  <meta
    name="keywords"
    content={seo.metadata.keywords.join("، ")}
  />

  <meta
    name="robots"
    content={seo.metadata.robots}
  />

  <meta
    name="author"
    content={seo.metadata.author}
  />

  <meta
    name="theme-color"
    content={seo.metadata.themeColor}
  />

  <meta
    name="generator"
    content={Astro.generator}
  />


  <!-- Canonical -->

  <link
    rel="canonical"
    href={seo.canonical}
  />


  <!-- Favicon -->

  <link
    rel="icon"
    href="/favicon.svg"
    type="image/svg+xml"
  />

  <link
    rel="apple-touch-icon"
    href="/logo.svg"
  />


  <!-- Fonts -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&display=swap"
    rel="stylesheet"
  />


  <!-- Open Graph -->

  <meta
    property="og:type"
    content={seo.openGraph["og:type"]}
  />

  <meta
    property="og:locale"
    content={seo.openGraph["og:locale"]}
  />

  <meta
    property="og:site_name"
    content={seo.openGraph["og:site_name"]}
  />

  <meta
    property="og:title"
    content={seo.openGraph["og:title"]}
  />

  <meta
    property="og:description"
    content={seo.openGraph["og:description"]}
  />

  <meta
    property="og:url"
    content={seo.openGraph["og:url"]}
  />

  <meta
    property="og:image"
    content={seo.openGraph["og:image"]}
  />


  <!-- Twitter Card -->

  <meta
    name="twitter:card"
    content={seo.twitter["twitter:card"]}
  />

  <meta
    name="twitter:title"
    content={seo.twitter["twitter:title"]}
  />

  <meta
    name="twitter:description"
    content={seo.twitter["twitter:description"]}
  />

  <meta
    name="twitter:image"
    content={seo.twitter["twitter:image"]}
  />


<!-- Schema.org JSON-LD -->

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(seo.schemaGraph)}
/>


<!-- Google Analytics 4 -->

<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-YKFKP4QH45"
></script>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
      window.dataLayer.push(arguments);
    }

    gtag("js", new Date());

    gtag("config", "G-YKFKP4QH45", {
      send_page_view: true
    });
  </script>
<!-- Meta Pixel -->

<script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  fbq('init', '830226966747297');
  fbq('track', 'PageView');
</script>

</head>


<body>

  <slot />


  <!-- Global Client Script -->

	<script src="../scripts/reveal.js"></script>

</body>

</html>
