{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "fatehmusic",
    "main": "./node_modules/@astrojs/cloudflare/dist/entrypoints/server.js",
    "compatibility_date": "2026-07-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],

    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
         "html_handling": "drop-trailing-slash"
    },

    "observability": {
        "enabled": true
    },

    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "dddc032f53cd4eaf92cffdf143aef621"
        }
    ],

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "fatehmusic-db",
            "database_id": "b03d1f36-cb20-42ae-9048-99ab8af208c9"
        }
    ]
}
